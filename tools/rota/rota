def smart_switch():
    accounts = store_accounts()
    active = active_name()
    if not accounts:
        die("no saved accounts — run: rota add")
    if len(accounts) == 1:
        name = next(iter(accounts))
        if name == active:
            print(f"only one account ({name}); already active")
            return
        return do_switch(name)
    results, errors = collect_usage(accounts, active)
    for name, err in errors.items():
        print(f"{YELLOW}skipping {name}:{RESET} {err}")
    if not results:
        die("couldn't fetch usage for any account")
    best, eligible = best_account(results)
    if not eligible:
        print(f"{YELLOW}warning:{RESET} no account has session + weekly + Fable headroom — picking least-bad")
    if best == active:
        print(f"already on the best account: {BOLD}{best}{RESET} ({describe(results, best)})")
        return
    vs = f"  {DIM}(current: {describe(results, active)}){RESET}" if active in results else ""
    print(f"best: {BOLD}{best}{RESET} ({describe(results, best)}){vs}")
    do_switch(best)


def do_switch(name):
    target = read_json(store_path(name))
    if not target:
        die(f"no saved account {name!r} — see: rota list")
    current = active_name()
    if current == name:
        print(f"{name} is already active")
        return
    if target.get("authDead"):
        die(f"{name} can't be used: {dead_message(name, target)}")
    # Sync live (possibly refreshed) tokens back into the outgoing account's snapshot
    if current:
        oauth = live_oauth()
        if oauth:
            persist_tokens(current, oauth, also_live=False)
    elif live_oauth():
        print(
            f"{YELLOW}warning:{RESET} current login is not saved as an account; "
            f"its tokens will be overwritten. Ctrl-C now and `rota save` to keep it."
        )
        time.sleep(3)
    # Swap claudeAiOauth in credentials (keep mcpOAuth etc. intact)
    creds = read_live_creds()
    creds["claudeAiOauth"] = target["claudeAiOauth"]
    write_live_creds(creds)
    # Swap oauthAccount identity in .claude.json
    cfg = read_json(CLAUDE_JSON) or {}
    if target.get("oauthAccount"):
        cfg["oauthAccount"] = target["oauthAccount"]
        write_json_atomic(CLAUDE_JSON, cfg)
    print(f"switched to {BOLD}{name}{RESET}")
    print(f"{DIM}new `claude` sessions will use this account; already-running sessions won't.{RESET}")


def login_and_save(expected=None, manual=False):
    """Shared by `add` and `reauth`: browser login -> snapshot, live login only
    updated when the account that signed in is the active one."""
    tokens, account = oauth_login(login_hint=expected, manual=manual)
    got = account["emailAddress"]
    if expected and got != expected:
        print(f"{YELLOW}note:{RESET} you signed in as {BOLD}{got}{RESET}, not {expected} "
              f"— saving {got}; {expected} is untouched")
    existed = got in store_accounts()
    is_active = active_name() == got or (
        not active_name() and live_account_info().get("accountUuid") == account["accountUuid"]
    )
    save_login(tokens, account, replace_live=is_active)
    verb = "re-authenticated" if existed else "saved new account"
    print(f"\n{verb} {BOLD}{got}{RESET} -> {store_path(got)}")
    if is_active:
        print(f"{DIM}{got} is the active account, so the live login was updated too; "
              f"already-running claude sessions keep their old tokens.{RESET}")
    else:
        print(f"{DIM}active account unchanged; use `rota switch {got}` when you want it{RESET}")
    return got


def parse_login_args(args):
    manual = "--manual" in args
    rest = [a for a in args if a != "--manual"]
    return rest, manual


def cmd_add(args):
    rest, manual = parse_login_args(args)
    hint = rest[0] if rest else None
    if hint and hint in store_accounts():
        print(f"{DIM}{hint} is already saved; re-authenticating it{RESET}")
    login_and_save(hint, manual=manual)


def cmd_reauth(args):
    rest, manual = parse_login_args(args)
    everything = "--all" in rest or rest == ["all"]
    rest = [a for a in rest if a not in ("--all", "all")]
    if everything or not rest:
        dead = [n for n, s in store_accounts().items() if s.get("authDead")]
        if not dead:
            die("usage: rota reauth <email> [--manual]  (no accounts are marked dead)")
        if len(dead) > 1 and not everything:
            die("several accounts need re-auth: " + ", ".join(dead)
                + " — pick one, or: rota reauth --all")
        targets = dead
    else:
        targets = [resolve(rest[0])]
    for i, name in enumerate(targets):
        if i:
            print()
        if len(targets) > 1:
            print(f"{BOLD}[{i + 1}/{len(targets)}]{RESET} {name}")
        snap = read_json(store_path(name))
        email = (snap.get("oauthAccount") or {}).get("emailAddress") or name
        login_and_save(email, manual=manual)


def cmd_usage(args):
    accounts, active = accounts_incl_live()
    if args:
        wanted = args[0] if args[0] in accounts else resolve(args[0])
        accounts = {wanted: accounts[wanted]}
    if not accounts and args:
        die("no Claude accounts — run: rota save")

    codex_entries = None
    if args:
        results, errors = collect_usage(accounts, active)
    else:
        with ThreadPoolExecutor(max_workers=2) as pool:
            codex_future = pool.submit(collect_codex_usage)
            claude_future = pool.submit(collect_usage, accounts, active) if accounts else None
            results, errors = claude_future.result() if claude_future else ({}, {})
            codex_entries = codex_future.result()

    cache = cache_load() if errors else {}
    first = True
    for name, snap in accounts.items():
        if not first:
            print()
        first = False
        if name in errors:
            cached = cache.get(name) if not snap.get("authDead") else None
            render_error(name, snap, errors[name], name == active, cached)
            continue
        render_usage(name, snap, results[name], name == active)

    if len(results) > 1:
        avg_s = sum(session_pct(d) for d in results.values()) / len(results)
        avg_w = sum(weekly_pct(d) for d in results.values()) / len(results)
        avg_f = sum(fable_pct(d) for d in results.values()) / len(results)
        print(f"\n{DIM}fleet avg: session {avg_s:.0f}% · weekly {avg_w:.0f}% · Fable {avg_f:.0f}%{RESET}")
        best, eligible = best_account(results)
        note = "" if eligible else f"  {YELLOW}(none have session + weekly + Fable room){RESET}"
        print(f"{BOLD}best:{RESET} {best} ({describe(results, best)}){note}", end="")
        if best != active:
            print(f"  {DIM}-> rota switch {best}{RESET}")
        else:
            print(f"  {DIM}(already active){RESET}")

    if codex_entries is not None:
        if accounts:
            print()
        render_codex_usage(codex_entries)


