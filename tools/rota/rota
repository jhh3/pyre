# ---------- file helpers ----------

def read_json(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (FileNotFoundError, json.JSONDecodeError):
        return None


def write_json_atomic(path, data):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    with open(tmp, "w") as f:
        json.dump(data, f, indent=2)
        f.write("\n")
    os.chmod(tmp, 0o600)
    os.replace(tmp, path)


# ---------- live credentials (file on Linux, Keychain on macOS) ----------

KEYCHAIN_SERVICE = "Claude Code-credentials"


_DEFAULT_CREDS_FILE = CREDS_FILE


def _keychain_read():
    """Return the raw credentials JSON text from the macOS login Keychain, or None."""
    if sys.platform != "darwin" or os.environ.get("ROTA_NO_KEYCHAIN"):
        return None
    if CREDS_FILE != _DEFAULT_CREDS_FILE:
        # credentials path was redirected (tests, custom setups): never touch the Keychain
        return None
    try:
        r = subprocess.run(
            ["security", "find-generic-password", "-s", KEYCHAIN_SERVICE, "-w"],
            capture_output=True, text=True, timeout=10,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    return r.stdout.strip() if r.returncode == 0 and r.stdout.strip() else None


def _keychain_write(text):
    r = subprocess.run(
        ["security", "add-generic-password", "-U", "-a", getpass.getuser(),
         "-s", KEYCHAIN_SERVICE, "-w", text],
        capture_output=True, text=True, timeout=10,
    )
    if r.returncode != 0:
        die(f"failed to write Keychain entry {KEYCHAIN_SERVICE!r}: {r.stderr.strip()}")


def use_keychain():
    """Claude Code on macOS stores credentials in the login Keychain rather than
    .credentials.json. Prefer the Keychain whenever an entry exists there."""
    return _keychain_read() is not None


def read_live_creds():
    text = _keychain_read()
    if text is not None:
        try:
            return json.loads(text)
        except json.JSONDecodeError:
            return {}
    return read_json(CREDS_FILE) or {}


def write_live_creds(creds):
    if use_keychain():
        _keychain_write(json.dumps(creds))
    else:
        write_json_atomic(CREDS_FILE, creds)


def die(msg):
    print(f"{RED}error:{RESET} {msg}", file=sys.stderr)
    sys.exit(1)


# ---------- account store ----------

def store_accounts():
    """name -> snapshot dict"""
    out = {}
    if STORE_DIR.is_dir():
        for p in sorted(STORE_DIR.glob("*.json")):
            data = read_json(p)
            if data and "claudeAiOauth" in data:
                out[p.stem] = data
    return out


def validate_name(name):
    if not re.fullmatch(r"[A-Za-z0-9._@-]+", name) or set(name) <= {"."}:
        die(f"invalid account name {name!r} (use letters, digits, . _ @ -)")


def store_path(name):
    validate_name(name)
    return STORE_DIR / f"{name}.json"


def live_oauth():
    return read_live_creds().get("claudeAiOauth")


def live_account_info():
    cfg = read_json(CLAUDE_JSON) or {}
    return cfg.get("oauthAccount") or {}


def active_name():
    """Which saved account is currently live, matched by accountUuid."""
    uuid = live_account_info().get("accountUuid")
    if not uuid:
        return None
    for name, snap in store_accounts().items():
        if snap.get("oauthAccount", {}).get("accountUuid") == uuid:
            return name
    return None


def resolve_name(accounts, query, what, list_cmd):
    """Resolve an account by exact name or unique prefix/substring."""
    if query in accounts:
        return query
    matches = [n for n in accounts if n.startswith(query)] or \
              [n for n in accounts if query in n]
    if len(matches) == 1:
        return matches[0]
    if not matches:
        die(f"no {what} matching {query!r} — see: {list_cmd}")
    die(f"{query!r} is ambiguous: {', '.join(matches)}")


def resolve(query):
    return resolve_name(store_accounts(), query, "account", "rota list")


def snapshot_live(name=None):
    oauth = live_oauth()
    if not oauth:
        die("no logged-in account found (.credentials.json or macOS Keychain) — run `claude` and /login first")
    if name is None:
        name = live_account_info().get("emailAddress") or die("live login has no email address")
    snap = {
        "name": name,
        "claudeAiOauth": oauth,
        "oauthAccount": live_account_info(),
        "savedAt": int(time.time() * 1000),
    }
    write_json_atomic(store_path(name), snap)
    return snap


def persist_tokens(name, tokens, also_live):
    """Write rotated/updated tokens back to the snapshot (and live creds if active)."""
    path = store_path(name)
    snap = read_json(path)
    if snap is not None:
        snap["claudeAiOauth"] = tokens
        write_json_atomic(path, snap)
    if also_live:
        creds = read_live_creds()
        creds["claudeAiOauth"] = tokens
        write_live_creds(creds)


# ---------- HTTP ----------

_UA = None

def user_agent():
    global _UA
    if _UA is None:
        ver = "2.0.0"
        try:
            out = subprocess.run(
                ["claude", "--version"], capture_output=True, text=True, timeout=5
            ).stdout.strip()
            m = re.match(r"[\d.]+", out)
            if m:
                ver = m.group(0)
        except Exception:
            pass
        _UA = f"claude-cli/{ver} (external, cli)"
    return _UA


def now_ms():
    return int(time.time() * 1000)


def span_text(ms):
    """'6d 2h', '3h 12m' or '4m' for a millisecond span."""
    secs = abs(int(ms)) // 1000
    days, rem = divmod(secs, 86400)
    hours, rem = divmod(rem, 3600)
    mins = rem // 60
    if days:
        return f"{days}d {hours}h"
    if hours:
        return f"{hours}h {mins}m"
    return f"{mins}m"


def age_text(ms):
    """'6d 2h ago' / 'in 3d 4h' relative to now."""
    delta = ms - now_ms()
    return f"in {span_text(delta)}" if delta > 0 else f"{span_text(delta)} ago"


class HttpError(Exception):
    def __init__(self, code, body, headers):
        super().__init__(f"HTTP {code}")
        self.code, self.body, self.headers = code, body, headers

    def detail(self):
        try:
            err = json.loads(self.body)
            msg = err.get("error_description") or err.get("error")
            if isinstance(msg, dict):
                msg = msg.get("message") or msg.get("type")
            if msg:
                return str(msg)
        except Exception:
            pass
        return self.body.decode(errors="replace").strip()[:200] if self.body else ""


def http_json(url, data=None, headers=None, timeout=30):
    """One JSON request; HTTP errors surface as HttpError with the body kept."""
    hdrs = {"Content-Type": "application/json", "User-Agent": user_agent()}
    hdrs.update(headers or {})
    req = urllib.request.Request(
        url, data=json.dumps(data).encode() if data is not None else None, headers=hdrs
    )
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return json.load(r)
    except urllib.error.HTTPError as e:
        try:
            body = e.read()[:2000]
        except Exception:
            body = b""
        raise HttpError(e.code, body, e.headers) from None


def oauth_headers(access_token):
    return {"Authorization": f"Bearer {access_token}", "anthropic-beta": "oauth-2025-04-20"}


class Unauthorized(Exception):
    pass


class RateLimited(Exception):
    def __init__(self, retry_after):
        super().__init__(f"rate limited (retry {age_text(now_ms() + retry_after * 1000)})")
        self.retry_after = retry_after


class RefreshDead(Exception):
    """The refresh token was rejected outright; only a new login will help."""


def retry_after_seconds(headers, default=60):
    try:
        return max(1, int(float(headers.get("Retry-After", default))))
    except (TypeError, ValueError):
        return default


def fetch_usage(access_token):
    """One usage fetch. Sleeps through a short Retry-After and retries one 5xx."""
    for attempt in (1, 2):
        try:
            return http_json(USAGE_URL, headers=oauth_headers(access_token))
        except HttpError as e:
            if e.code in (401, 403):
                raise Unauthorized() from e
            if e.code == 429:
                wait = retry_after_seconds(e.headers)
                if attempt == 1 and wait <= RETRY_AFTER_BUDGET:
                    time.sleep(wait)
                    continue
                raise RateLimited(wait) from e
            if e.code >= 500 and attempt == 1:
                time.sleep(1)
                continue
            raise


def tokens_from_response(d, base=None):
    """Merge a token-endpoint response into a claudeAiOauth block."""
    new = dict(base or {})
    now = now_ms()
    new["accessToken"] = d["access_token"]
    if d.get("refresh_token"):
        new["refreshToken"] = d["refresh_token"]
    new["expiresAt"] = now + int(d.get("expires_in", 3600)) * 1000
    if d.get("refresh_token_expires_in") is not None:
        new["refreshTokenExpiresAt"] = now + int(d["refresh_token_expires_in"]) * 1000
    else:
        new.pop("refreshTokenExpiresAt", None)  # unknown; don't keep a stale value
    if d.get("scope"):
        new["scopes"] = d["scope"].split()
    return new


def refresh_tokens(tokens):
    body = {
        "grant_type": "refresh_token",
        "refresh_token": tokens["refreshToken"],
        "client_id": CLIENT_ID,
    }
    try:
        d = http_json(TOKEN_URL, data=body)
    except HttpError as e:
        if e.code in (400, 401) and b"invalid_grant" in e.body:
            raise RefreshDead(e.detail() or "refresh token rejected") from e
        if e.code == 429:
            raise RateLimited(retry_after_seconds(e.headers)) from e
        raise RuntimeError(f"token refresh failed (HTTP {e.code}) {e.detail()}") from e
    return tokens_from_response(d, tokens)


def token_expired(tokens, margin_ms=60_000):
    exp = tokens.get("expiresAt")
    return exp is not None and exp <= now_ms() + margin_ms


def refresh_token_expires_at(snap):
    return (snap.get("claudeAiOauth") or {}).get("refreshTokenExpiresAt")


def mark_dead(name, reason):
    """Persist that this account's refresh token was rejected, so later runs
    skip it entirely instead of hammering the API (which earns a 429 lockout)."""
    path = store_path(name)
    snap = read_json(path)
    if snap is not None:
        snap["authDead"] = {"at": now_ms(), "reason": reason}
        write_json_atomic(path, snap)


def dead_message(name, snap):
    dead = snap.get("authDead") or {}
    since = f" (since {age_text(dead['at'])})" if dead.get("at") else ""
    reason = dead.get("reason") or "refresh token rejected"
    return f"{reason}{since} — re-auth with: rota reauth {name}"


def usage_for(name, snap, is_active):
    """Return (usage_data, error_string).

    Refreshes up front when the access token is already expired (a request with a
    dead token is wasted and, repeated, gets the token rate-limited), refreshes on
    401, and marks the account dead when the refresh token itself is rejected."""
    if snap.get("authDead"):
        return None, dead_message(name, snap)
    tokens = (live_oauth() if is_active else None) or snap["claudeAiOauth"]

    def refresh():
        nonlocal tokens
        try:
            if not tokens.get("refreshToken"):
                raise RefreshDead("no refresh token saved (logged out elsewhere?)")
            tokens = refresh_tokens(tokens)
        except RefreshDead as e:
            if name in store_accounts():
                mark_dead(name, str(e))
            raise
        persist_tokens(name, tokens, also_live=is_active)

    try:
        if token_expired(tokens):
            refresh()
        try:
            return fetch_usage(tokens["accessToken"]), None
        except Unauthorized:
            refresh()
            return fetch_usage(tokens["accessToken"]), None
    except RefreshDead as e:
        return None, f"{e} — re-auth with: rota reauth {name}"
    except RateLimited as e:
        return None, str(e)
    except HttpError as e:
        return None, f"HTTP {e.code} {e.detail()}".strip()
    except Exception as e:
        return None, str(e)


# ---------- usage cache ----------

_cache_lock = threading.Lock()


def cache_load():
    return read_json(CACHE_FILE) or {}


def cache_store(results):
    """Remember the latest good usage per account (used as a fallback on errors)."""
    if not results:
        return
    with _cache_lock:
        cache = cache_load()
        for name, data in results.items():
            cache[name] = {"fetchedAt": now_ms(), "data": data}
        try:
            write_json_atomic(CACHE_FILE, cache)
        except OSError:
            pass


# ---------- OAuth login (in-process, mirrors `claude /login`) ----------

def pkce_pair():
    verifier = base64.urlsafe_b64encode(os.urandom(32)).decode().rstrip("=")
    digest = hashlib.sha256(verifier.encode()).digest()
    return verifier, base64.urlsafe_b64encode(digest).decode().rstrip("=")


def authorize_url(challenge, state, redirect_uri, login_hint=None):
    params = {
        "code": "true",
        "client_id": CLIENT_ID,
        "response_type": "code",
        "redirect_uri": redirect_uri,
        "scope": " ".join(LOGIN_SCOPES),
        "code_challenge": challenge,
        "code_challenge_method": "S256",
        "state": state,
    }
    if login_hint:
        params["login_hint"] = login_hint
    return f"{AUTHORIZE_URL}?{urllib.parse.urlencode(params)}"


def parse_auth_input(text, expected_state):
    """Accept a pasted callback URL, the manual page's 'code#state', or a bare
    code. Returns (code, state)."""
    text = text.strip()
    if "://" in text:
        q = urllib.parse.parse_qs(urllib.parse.urlparse(text).query)
        return (q.get("code") or [None])[0], (q.get("state") or [expected_state])[0]
    if "#" in text:
        code, state = text.split("#", 1)
        return code.strip(), state.strip()
    return text, expected_state


def exchange_code(code, state, verifier, redirect_uri):
    body = {
        "grant_type": "authorization_code",
        "code": code,
        "redirect_uri": redirect_uri,
        "client_id": CLIENT_ID,
        "code_verifier": verifier,
        "state": state,
    }
    try:
        return http_json(TOKEN_URL, data=body)
    except HttpError as e:
        if e.code == 401:
            die("authentication failed: invalid or already-used authorization code")
        die(f"token exchange failed (HTTP {e.code}) {e.detail()}")


def account_from_login(token_response):
    """Build (claudeAiOauth, oauthAccount) the way Claude Code populates them
    after a login: token response + /api/oauth/profile + /claude_cli/roles."""
    tokens = tokens_from_response(token_response)
    profile = http_json(PROFILE_URL, headers=oauth_headers(tokens["accessToken"]))
    try:
        roles = http_json(ROLES_URL, headers=oauth_headers(tokens["accessToken"]))
    except Exception:
        roles = {}
    acct = profile.get("account") or {}
    org = profile.get("organization") or {}
    tok_acct = token_response.get("account") or {}
    tok_org = token_response.get("organization") or {}
    tokens["subscriptionType"] = SUBSCRIPTION_TYPES.get(org.get("organization_type"))
    tokens["rateLimitTier"] = org.get("rate_limit_tier")
    account = {
        "accountUuid": acct.get("uuid") or tok_acct.get("uuid"),
        "emailAddress": acct.get("email") or tok_acct.get("email_address"),
        "organizationUuid": org.get("uuid") or tok_org.get("uuid"),
        "hasExtraUsageEnabled": org.get("has_extra_usage_enabled", False),
        "billingType": org.get("billing_type"),
        "accountCreatedAt": acct.get("created_at"),
        "subscriptionCreatedAt": org.get("subscription_created_at"),
        "ccOnboardingFlags": org.get("cc_onboarding_flags") or {},
        "claudeCodeTrialEndsAt": org.get("claude_code_trial_ends_at"),
        "claudeCodeTrialDurationDays": org.get("claude_code_trial_duration_days"),
        "seatTier": org.get("seat_tier"),
        "displayName": acct.get("display_name"),
        "fullName": acct.get("full_name"),
        "profileFetchedAt": now_ms(),
        "organizationRole": roles.get("organization_role"),
        "workspaceRole": roles.get("workspace_role"),
        "organizationName": roles.get("organization_name") or org.get("name") or tok_org.get("name"),
        "organizationType": org.get("organization_type"),
        "organizationRateLimitTier": org.get("rate_limit_tier"),
        "userRateLimitTier": None,
    }
    if not account["accountUuid"] or not account["emailAddress"]:
        die("login succeeded but the profile has no account uuid/email")
    return tokens, account


def open_callback_listeners():
    """Bind 127.0.0.1 (and ::1 when available) on one random port, so the
    browser's http://localhost:<port>/callback redirect lands here."""
    for _ in range(25):
        port = random.randint(20000, 60000)
        socks = []
        try:
            for fam, host in ((socket.AF_INET, "127.0.0.1"), (socket.AF_INET6, "::1")):
                s = socket.socket(fam, socket.SOCK_STREAM)
                try:
                    s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
                    s.bind((host, port))
                    s.listen(5)
                    socks.append(s)
                except OSError:
                    s.close()
                    if fam == socket.AF_INET:
                        raise
            return port, socks
        except OSError:
            for s in socks:
                s.close()
    die("couldn't bind a local port for the OAuth callback")


_CALLBACK_PAGE = """<!doctype html><meta charset=utf-8><title>rota</title>
<body style="font-family:system-ui;margin:3em"><h2>{title}</h2><p>{body}</p></body>"""


def handle_callback(conn, expected_state):
    """Serve one HTTP request on the listener. Returns (code, state) when the
    request is a valid callback, else None (after answering the browser)."""
    conn.settimeout(5)
    try:
        raw = b""
        try:
            while b"\r\n\r\n" not in raw and len(raw) < 65536:
                chunk = conn.recv(4096)
                if not chunk:
                    break
                raw += chunk
        except OSError:
            # Browsers open speculative "preconnect" sockets that never send a
            # request; a read timeout or reset here is noise, keep listening.
            return None
        if not raw.strip():
            return None
        line = raw.split(b"\r\n", 1)[0].decode(errors="replace")
        parts = line.split(" ")
        path = parts[1] if len(parts) >= 2 else "/"
        url = urllib.parse.urlparse(path)
        q = {k: v[0] for k, v in urllib.parse.parse_qs(url.query).items()}

        def respond(status, title, body):
            page = _CALLBACK_PAGE.format(title=title, body=body).encode()
            conn.sendall(
                f"HTTP/1.1 {status}\r\nContent-Type: text/html; charset=utf-8\r\n"
                f"Content-Length: {len(page)}\r\nConnection: close\r\n\r\n".encode() + page
            )

        if url.path != "/callback":
            respond("404 Not Found", "Not found", "rota only handles /callback.")
            return None
        if q.get("error"):
            respond("400 Bad Request", "Sign-in failed",
                    f"{q.get('error')}: {q.get('error_description', '')}. You can close this tab.")
            raise RuntimeError(f"sign-in failed: {q.get('error')} {q.get('error_description', '')}".strip())
        if q.get("state") != expected_state:
            respond("400 Bad Request", "Stale sign-in",
                    "This callback belongs to a different login attempt. Close the tab and retry.")
            return None
        if not q.get("code"):
            respond("400 Bad Request", "No code", "No authorization code was received.")
            return None
        respond("200 OK", "Signed in", "You can close this tab and return to the terminal.")
        return q["code"], q["state"]
    finally:
        try:
            conn.close()
        except OSError:
            pass


def wait_for_auth_code(socks, expected_state, allow_paste=True, timeout=LOGIN_TIMEOUT):
    """Block until the browser hits a listener or the user pastes the code/URL."""
    stdin_ok = allow_paste and sys.stdin and sys.stdin.isatty()
    deadline = time.monotonic() + timeout
    while True:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            die("timed out waiting for the login to complete")
        watch = list(socks) + ([sys.stdin] if stdin_ok else [])
        ready, _, _ = select.select(watch, [], [], remaining)
        for r in ready:
            if r is sys.stdin:
                line = sys.stdin.readline()
                if not line:
                    stdin_ok = False
                    continue
                if line.strip():
                    code, state = parse_auth_input(line, expected_state)
                    if not code:
                        print(f"{YELLOW}no code found in that input — try again{RESET}")
                        continue
                    if state != expected_state:
                        print(f"{YELLOW}state mismatch — that code is from another attempt{RESET}")
                        continue
                    return code, state
            else:
                conn, _ = r.accept()
                got = handle_callback(conn, expected_state)
                if got:
                    return got


def try_open_browser(url):
    if not (sys.platform == "darwin" or os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")):
        return False
    try:
        return bool(webbrowser.open(url, new=2))
    except Exception:
        return False


def oauth_login(login_hint=None, manual=False):
    """Run the full browser login and return (claudeAiOauth, oauthAccount).
    Nothing on disk is touched until the caller decides what to do with it."""
    verifier, challenge = pkce_pair()
    state = secrets.token_urlsafe(32)
    socks = []
    if manual:
        redirect_uri = MANUAL_REDIRECT_URL
    else:
        port, socks = open_callback_listeners()
        redirect_uri = f"http://localhost:{port}/callback"
    url = authorize_url(challenge, state, redirect_uri, login_hint)
    try:
        hint = f" as {BOLD}{login_hint}{RESET}" if login_hint else ""
        print(f"sign in{hint} in your browser. If the browser is logged into another "
              f"claude.ai account, use a private window.\n")
        opened = try_open_browser(url) if not manual else False
        if opened:
            print(f"{DIM}browser opened; if it didn't, open this URL:{RESET}")
        else:
            print("open this URL:")
        print(f"\n{url}\n")
        if manual:
            print("then paste the code shown on the page (code#state) here: ", end="")
        else:
            print(f"{DIM}waiting for the redirect… (or paste the code / callback URL here){RESET}")
        sys.stdout.flush()
        code, state = wait_for_auth_code(socks, state, allow_paste=True)
    finally:
        for s in socks:
            s.close()
    print(f"{DIM}exchanging code…{RESET}")
    return account_from_login(exchange_code(code, state, verifier, redirect_uri))


def save_login(tokens, account, replace_live=False):
    """Write a fresh snapshot for the account that just logged in, and update the
    live login too if that account is the active one."""
    name = account["emailAddress"]
    snap = {
        "name": name,
        "claudeAiOauth": tokens,
        "oauthAccount": account,
        "savedAt": now_ms(),
    }
    write_json_atomic(store_path(name), snap)
    if replace_live:
        creds = read_live_creds()
        creds["claudeAiOauth"] = tokens
        write_live_creds(creds)
        cfg = read_json(CLAUDE_JSON) or {}
        cfg["oauthAccount"] = account
        write_json_atomic(CLAUDE_JSON, cfg)
    return name


