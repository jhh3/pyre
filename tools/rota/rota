def cmd_export(args):
    accounts = store_accounts()
    # Sync the active account's snapshot with live tokens first, so exports are fresh
    current = active_name()
    if current and live_oauth():
        persist_tokens(current, live_oauth(), also_live=False)
        accounts = store_accounts()
    names = [resolve(a) for a in args] or list(accounts)
    payload = {"rota_export": 1, "exportedAt": int(time.time() * 1000),
               "accounts": [accounts[n] | {"name": n} for n in names]}
    print(json.dumps(payload, indent=2))
    print(f"{YELLOW}warning:{RESET} export contains OAuth secrets — "
          f"treat the output like a password (chmod 600, don't commit).", file=sys.stderr)


def cmd_import(args):
    force = "--force" in args
    args = [a for a in args if a != "--force"]
    if not args:
        die("usage: rota import <file|-> [--force]")
    raw = sys.stdin.read() if args[0] == "-" else Path(args[0]).read_text()
    try:
        payload = json.loads(raw)
    except json.JSONDecodeError as e:
        die(f"not valid JSON: {e}")
    entries = payload.get("accounts") if isinstance(payload, dict) else None
    if entries is None:
        die("not a rota export (missing 'accounts' key)")
    imported = skipped = 0
    for snap in entries:
        name = snap.get("name")
        if not name or "claudeAiOauth" not in snap:
            print(f"{YELLOW}skipping malformed entry{RESET}")
            continue
        if store_path(name).exists() and not force:
            print(f"{DIM}skipping {name} (exists — use --force to overwrite){RESET}")
            skipped += 1
            continue
        write_json_atomic(store_path(name), snap)
        print(f"imported {BOLD}{name}{RESET} ({snap.get('oauthAccount', {}).get('emailAddress', '?')})")
        imported += 1
    print(f"{imported} imported, {skipped} skipped")
    if imported:
        print(f"{DIM}note: refresh tokens are single-use — if the source machine keeps using "
              f"these accounts, tokens may invalidate each other. Prefer one machine per account, "
              f"or re-auth here with `rota add`.{RESET}")


def cmd_remove(args):
    if not args:
        die("usage: rota remove <name>")
    name = resolve(args[0])
    path = store_path(name)
    if name == active_name():
        print(f"{YELLOW}note:{RESET} {name} is the active account; removing only the snapshot (login stays).")
    path.unlink()
    print(f"removed {name}")


def main():
    args = sys.argv[1:]
    if not args:
        return cmd_usage([])
    cmd = args[0]
    rest = args[1:]
    if cmd in ("list", "ls"):
        cmd_list()
    elif cmd == "save":
        cmd_save(rest)
    elif cmd == "add":
        cmd_add(rest)
    elif cmd in ("reauth", "login", "relogin"):
        cmd_reauth(rest)
    elif cmd in ("switch", "use"):
        cmd_switch(rest)
    elif cmd == "usage":
        cmd_usage(rest)
    elif cmd == "codex":
        cmd_codex(rest)
    elif cmd == "whoami":
        cmd_whoami()
    elif cmd == "export":
        cmd_export(rest)
    elif cmd == "import":
        cmd_import(rest)
    elif cmd in ("remove", "rm"):
        cmd_remove(rest)
    elif cmd in ("-h", "--help", "help"):
        print(__doc__.strip())
    else:
        die(f"unknown command {cmd!r} — try: rota help")


if __name__ == "__main__":
    main()
