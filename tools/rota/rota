def codex_store_home(name):
    """Each saved Codex account is a directory usable as a CODEX_HOME, so
    usage fetches run against it directly and rotated tokens persist there."""
    validate_name(name)
    return codex_store_dir() / name


def codex_store_accounts():
    """name -> auth.json dict for saved Codex accounts."""
    out = {}
    if codex_store_dir().is_dir():
        for p in sorted(codex_store_dir().iterdir()):
            auth = read_json(p / "auth.json")
            if auth is not None:
                out[p.name] = auth
    return out


def jwt_claims(token):
    """Decode a JWT payload without verification (identity display only)."""
    try:
        payload = token.split(".")[1]
        payload += "=" * (-len(payload) % 4)
        return json.loads(base64.urlsafe_b64decode(payload))
    except Exception:
        return {}


def codex_identity(auth):
    """(kind, stable id, email) for an auth.json payload."""
    tokens = (auth or {}).get("tokens") or {}
    if tokens.get("account_id") or tokens.get("id_token"):
        claims = jwt_claims(tokens.get("id_token") or "")
        return "chatgpt", tokens.get("account_id") or claims.get("sub"), claims.get("email")
    key = (auth or {}).get("OPENAI_API_KEY")
    if key:
        return "apiKey", key, None
    return None, None, None


def codex_plan(auth):
    claims = jwt_claims(((auth or {}).get("tokens") or {}).get("id_token") or "")
    return (claims.get("https://api.openai.com/auth") or {}).get("chatgpt_plan_type")


def codex_active_name():
    """Which saved Codex account is currently live, matched by account id."""
    live = codex_identity(read_json(codex_auth_file()))[:2]
    if not live[1]:
        return None
    for name, auth in codex_store_accounts().items():
        if codex_identity(auth)[:2] == live:
            return name
    return None


def codex_resolve(query):
    return resolve_name(codex_store_accounts(), query, "codex account", "rota codex list")


def codex_snapshot_live(name=None):
    auth = read_json(codex_auth_file())
    if not auth or not any(codex_identity(auth)[:2]):
        die("no Codex login found — run `codex login` first")
    if name is None:
        name = codex_identity(auth)[2] or die(
            "Codex login has no email — use: rota codex save <name>"
        )
    write_json_atomic(codex_store_home(name) / "auth.json", auth)
    return name


# ---------- Codex usage ----------

def codex_switch_profiles():
    """One profile per saved Codex account; the active one reads the live home."""
    active = codex_active_name()
    return [
        {
            "name": name,
            "home": codex_dir() if name == active else codex_store_home(name),
            "active": name == active,
            "switchable": True,
        }
        for name in codex_store_accounts()
    ]


def codex_profiles():
    """Codex homes to inspect: the live login, saved accounts, and any extra
    homes supplied through the path-separated ROTA_CODEX_HOMES."""
    profiles = codex_switch_profiles()
    profiles.sort(key=lambda p: not p["active"])
    if not any(p["active"] for p in profiles):
        profiles.insert(0, {
            "name": "default", "home": codex_dir(), "active": True, "switchable": False,
        })
    seen = {str(p["home"].absolute()) for p in profiles}
    for value in os.environ.get("ROTA_CODEX_HOMES", "").split(os.pathsep):
        if not value:
            continue
        home = Path(value).expanduser()
        key = str(home.absolute())
        if key in seen:
            continue
        seen.add(key)
        profiles.append({"name": home.name, "home": home, "active": False, "switchable": False})
    return profiles


def _codex_send(proc, message):
    proc.stdin.write((json.dumps(message, separators=(",", ":")) + "\n").encode())
    proc.stdin.flush()


def _codex_responses(proc, wanted, buffer, deadline):
    """Read JSONL until all response IDs arrive, ignoring notifications."""
    found = {}
    while not wanted.issubset(found):
        while b"\n" in buffer:
            raw, buffer = buffer.split(b"\n", 1)
            if not raw.strip():
                continue
            try:
                message = json.loads(raw)
            except (UnicodeDecodeError, json.JSONDecodeError) as e:
                raise RuntimeError(f"invalid response from Codex app server: {e}") from e
            response_id = message.get("id")
            if response_id not in wanted:
                continue
            if message.get("error"):
                error = message["error"]
                detail = error.get("message") if isinstance(error, dict) else str(error)
                raise RuntimeError(detail or "Codex app server request failed")
            found[response_id] = message.get("result") or {}
        if wanted.issubset(found):
            break
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise TimeoutError("Codex app server timed out")
        ready, _, _ = select.select([proc.stdout], [], [], remaining)
        if not ready:
            raise TimeoutError("Codex app server timed out")
        chunk = os.read(proc.stdout.fileno(), 65536)
        if not chunk:
            detail = proc.stderr.read().decode(errors="replace").strip()
            raise RuntimeError(detail or "Codex app server exited unexpectedly")
        buffer += chunk
    return found, buffer


def _stop_codex(proc):
    if proc.poll() is None:
        proc.terminate()
        try:
            proc.wait(timeout=2)
        except subprocess.TimeoutExpired:
            proc.kill()
            proc.wait()
    for stream in (proc.stdin, proc.stdout, proc.stderr):
        if stream:
            stream.close()


def codex_usage_for(profile, codex_bin=CODEX_BIN, timeout=CODEX_TIMEOUT):
    """Return (account/rate-limit data, error) for one CODEX_HOME."""
    home = profile["home"]
    if not home.is_dir():
        return None, f"Codex home does not exist: {home}"
    env = os.environ.copy()
    env["CODEX_HOME"] = str(home)
    try:
        proc = subprocess.Popen(
            [codex_bin, "app-server", "--stdio"],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            env=env,
        )
    except FileNotFoundError:
        return None, "`codex` not found on PATH"
    except Exception as e:
        return None, f"could not start Codex app server: {e}"

    buffer = b""
    deadline = time.monotonic() + timeout
    try:
        _codex_send(proc, {
            "id": 1,
            "method": "initialize",
            "params": {"clientInfo": {"name": "rota", "version": "1"}},
        })
        _, buffer = _codex_responses(proc, {1}, buffer, deadline)
        _codex_send(proc, {"method": "initialized", "params": {}})
        _codex_send(proc, {
            "id": 2,
            "method": "account/read",
            "params": {"refreshToken": False},
        })
        account_responses, buffer = _codex_responses(proc, {2}, buffer, deadline)
        account = account_responses[2]
        account_data = account.get("account")
        result = {
            "account": account_data,
            "requiresOpenaiAuth": account.get("requiresOpenaiAuth"),
            "rateLimits": None,
        }
        if not account_data or account_data.get("type") != "chatgpt":
            return result, None
        _codex_send(proc, {
            "id": 3,
            "method": "account/rateLimits/read",
            "params": {},
        })
        responses, _ = _codex_responses(proc, {3}, buffer, deadline)
        result["rateLimits"] = responses[3]
        return result, None
    except Exception as e:
        return None, str(e)
    finally:
        _stop_codex(proc)


def collect_codex_usage(profiles=None):
    profiles = profiles or codex_profiles()
    with ThreadPoolExecutor(max_workers=max(1, min(8, len(profiles)))) as pool:
        fetched = list(pool.map(codex_usage_for, profiles))
    return [
        {"profile": profile, "data": data, "error": error}
        for profile, (data, error) in zip(profiles, fetched)
    ]


