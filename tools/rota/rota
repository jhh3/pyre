def humanize_until(iso):
    if not iso:
        return ""
    try:
        dt = datetime.fromisoformat(iso)
    except ValueError:
        return iso
    delta = dt - datetime.now(dt.tzinfo)
    secs = int(delta.total_seconds())
    if secs <= 0:
        return "resetting now"
    days, rem = divmod(secs, 86400)
    hours, rem = divmod(rem, 3600)
    mins = rem // 60
    local = dt.astimezone()
    when = local.strftime("%a %-I:%M%p").lower()
    if days:
        return f"resets {when} (in {days}d {hours}h)"
    if hours:
        return f"resets {when} (in {hours}h {mins}m)"
    return f"resets {when} (in {mins}m)"


def bar(pct, width=20):
    pct = max(0.0, min(100.0, float(pct)))
    filled = round(pct / 100 * width)
    color = GREEN if pct < 60 else YELLOW if pct < 85 else RED
    return f"{color}{'█' * filled}{DIM}{'░' * (width - filled)}{RESET}"


LIMIT_LABELS = {"session": "session (5h)", "weekly_all": "weekly (all)"}


def limit_label(lim):
    kind = lim.get("kind", "?")
    if kind in LIMIT_LABELS:
        return LIMIT_LABELS[kind]
    scope = lim.get("scope") or {}
    model = (scope.get("model") or {}).get("display_name")
    if kind == "weekly_scoped" and model:
        return f"weekly ({model})"
    return kind


def render_usage(name, snap, data, is_active, note=None):
    acct = snap.get("oauthAccount", {})
    email = acct.get("emailAddress", "?")
    tier = acct.get("organizationRateLimitTier", "") or snap["claudeAiOauth"].get(
        "subscriptionType", ""
    ) or ""
    tier = tier.replace("default_claude_", "").replace("_", " ")
    marker = f"{GREEN}●{RESET}" if is_active else f"{DIM}○{RESET}"
    active_tag = f"  {CYAN}← active{RESET}" if is_active else ""
    ident = name if name == email else f"{name}  {email}"
    health, color = token_health(snap)
    warn_tag = f"  {color}{health}{RESET}" if color in (RED, YELLOW) and health else ""
    note_tag = f"  {YELLOW}({note}){RESET}" if note else ""
    print(f"{marker} {BOLD}{ident}{RESET}  {DIM}({tier}){RESET}{active_tag}{warn_tag}{note_tag}")
    limits = data.get("limits") or []
    if limits:
        width = max(len(limit_label(l)) for l in limits)
        for lim in limits:
            pct = lim.get("percent", 0)
            label = limit_label(lim).ljust(width)
            reset = humanize_until(lim.get("resets_at"))
            print(f"    {label}  {bar(pct)} {pct:>3.0f}%  {DIM}{reset}{RESET}")
    else:
        for key in ("five_hour", "seven_day"):
            block = data.get(key)
            if block:
                pct = block.get("utilization") or 0
                label = {"five_hour": "session (5h)", "seven_day": "weekly"}[key]
                print(
                    f"    {label:<14}{bar(pct)} {pct:>3.0f}%  "
                    f"{DIM}{humanize_until(block.get('resets_at'))}{RESET}"
                )
    extra = data.get("extra_usage") or {}
    if extra.get("is_enabled"):
        used = extra.get("used_credits") or 0
        places = extra.get("decimal_places", 2)
        amount = used / (10 ** places)
        note = " (spend limit reached)" if extra.get("spend_limit_reached") else ""
        print(f"    {DIM}extra usage: ${amount:,.2f} used{note}{RESET}")


def codex_window_label(minutes, fallback):
    if minutes == 300:
        return "session (5h)"
    if minutes == 10080:
        return "weekly"
    if isinstance(minutes, (int, float)) and minutes > 0:
        if minutes % 1440 == 0:
            days = int(minutes // 1440)
            return f"{days} day" + ("s" if days != 1 else "")
        if minutes % 60 == 0:
            hours = int(minutes // 60)
            return f"{hours} hour" + ("s" if hours != 1 else "")
        return f"{int(minutes)} min"
    return fallback


def codex_reset_text(timestamp):
    if timestamp is None:
        return ""
    try:
        iso = datetime.fromtimestamp(float(timestamp), timezone.utc).isoformat()
    except (TypeError, ValueError, OSError):
        return str(timestamp)
    return humanize_until(iso)


def codex_snapshots(rate_data):
    by_id = (rate_data or {}).get("rateLimitsByLimitId")
    if isinstance(by_id, dict) and by_id:
        return sorted(
            by_id.items(),
            key=lambda item: (
                item[0] != "codex",
                item[1].get("limitName") or item[0],
            ),
        )
    snapshot = (rate_data or {}).get("rateLimits")
    return [(snapshot.get("limitId") or "codex", snapshot)] if snapshot else []


def codex_limit_rows(rate_data):
    snapshots = codex_snapshots(rate_data)
    rows = []
    for limit_id, snapshot in snapshots:
        scope = snapshot.get("limitName")
        if not scope and len(snapshots) > 1 and limit_id != "codex":
            scope = str(limit_id).removeprefix("codex_").replace("_", " ")
        for window_name in ("primary", "secondary"):
            window = snapshot.get(window_name)
            if not window:
                continue
            label = codex_window_label(
                window.get("windowDurationMins"), window_name
            )
            if scope:
                label = f"{label} ({scope})"
            rows.append({
                "label": label,
                "percent": window.get("usedPercent"),
                "resets_at": window.get("resetsAt"),
            })
    return rows


def format_decimal(value):
    try:
        amount = Decimal(str(value))
    except (InvalidOperation, TypeError, ValueError):
        return str(value)
    rendered = f"{amount:,.2f}"
    return rendered.rstrip("0").rstrip(".")


def render_codex_entry(entry):
    profile = entry["profile"]
    marker = f"{GREEN}●{RESET}" if profile["active"] else f"{DIM}○{RESET}"
    active_tag = f"  {CYAN}← active{RESET}" if profile["active"] else ""
    if entry["error"]:
        print(f"{marker} {BOLD}{profile['name']}{RESET}  {RED}{entry['error']}{RESET}{active_tag}")
        return

    data = entry["data"]
    account = data.get("account")
    if not account:
        print(f"{marker} {BOLD}{profile['name']}{RESET}  {DIM}(not logged in){RESET}{active_tag}")
        return
    email = account.get("email") or profile["name"]
    ident = email if profile["name"] in ("default", email) else f"{profile['name']}  {email}"
    account_type = account.get("type", "unknown")
    plan = account.get("planType")
    detail = f"{plan} subscription" if plan else account_type
    print(f"{marker} {BOLD}{ident}{RESET}  {DIM}({detail}){RESET}{active_tag}")
    if account_type != "chatgpt":
        print(f"    {DIM}subscription limits unavailable for {account_type} authentication{RESET}")
        return

    rate_data = data.get("rateLimits") or {}
    rows = codex_limit_rows(rate_data)
    if rows:
        width = max(len(row["label"]) for row in rows)
        for row in rows:
            pct = row["percent"]
            reset = codex_reset_text(row["resets_at"])
            if pct is None:
                print(f"    {row['label'].ljust(width)}  {DIM}usage unknown  {reset}{RESET}")
            else:
                print(
                    f"    {row['label'].ljust(width)}  {bar(pct)} {pct:>3.0f}%  "
                    f"{DIM}{reset}{RESET}"
                )
    else:
        print(f"    {DIM}subscription limits unavailable{RESET}")

    snapshots = codex_snapshots(rate_data)
    credits = next((snap.get("credits") for _, snap in snapshots if snap.get("credits")), None)
    if credits:
        if credits.get("unlimited"):
            print(f"    {DIM}credits: unlimited{RESET}")
        elif credits.get("hasCredits") and credits.get("balance") is not None:
            print(f"    {DIM}credits: {format_decimal(credits['balance'])} remaining{RESET}")
    spend = next((snap.get("individualLimit") for _, snap in snapshots if snap.get("individualLimit")), None)
    if spend:
        print(
            f"    {DIM}spend: {format_decimal(spend.get('used'))} of "
            f"{format_decimal(spend.get('limit'))} used  "
            f"{codex_reset_text(spend.get('resetsAt'))}{RESET}"
        )
    reached = next((snap.get("rateLimitReachedType") for _, snap in snapshots if snap.get("rateLimitReachedType")), None)
    if reached:
        print(f"    {RED}{reached.replace('_', ' ')}{RESET}")
    reset_credits = rate_data.get("rateLimitResetCredits") or {}
    if reset_credits.get("availableCount"):
        print(f"    {DIM}rate-limit resets available: {reset_credits['availableCount']}{RESET}")


def codex_score(entry):
    """Worst-window used percent, for ranking accounts; None when unusable."""
    data = entry.get("data") or {}
    if entry.get("error") or (data.get("account") or {}).get("type") != "chatgpt":
        return None
    pcts = [
        row["percent"]
        for row in codex_limit_rows(data.get("rateLimits") or {})
        if row["percent"] is not None
    ]
    return max(pcts) if pcts else None


def render_codex_usage(entries):
    print(f"{BOLD}Codex{RESET}")
    for index, entry in enumerate(entries):
        if index:
            print()
        render_codex_entry(entry)
    scored = {
        entry["profile"]["name"]: codex_score(entry)
        for entry in entries
        if entry["profile"].get("switchable") and codex_score(entry) is not None
    }
    if len(scored) > 1:
        active = next((e["profile"]["name"] for e in entries if e["profile"]["active"]), None)
        eligible = {n: p for n, p in scored.items() if p < 100}
        pool = eligible or scored
        best = min(pool, key=pool.get)
        note = "" if eligible else f"  {YELLOW}(all have a limit at 100%){RESET}"
        print(f"\n{BOLD}best:{RESET} {best} ({scored[best]:.0f}% max window used){note}", end="")
        if best != active:
            print(f"  {DIM}-> rota codex switch {best}{RESET}")
        else:
            print(f"  {DIM}(already active){RESET}")


def session_pct(data):
    for lim in data.get("limits") or []:
        if lim.get("kind") == "session":
            return lim.get("percent", 0)
    return (data.get("five_hour") or {}).get("utilization") or 0


def weekly_pct(data):
    for lim in data.get("limits") or []:
        if lim.get("kind") == "weekly_all":
            return lim.get("percent", 0)
    return (data.get("seven_day") or {}).get("utilization") or 0


def accounts_incl_live():
    """All saved accounts, plus the live-but-unsaved login as '(current)'. Returns (accounts, active)."""
    accounts = store_accounts()
    active = active_name()
    if live_oauth() and not active:
        accounts["(current)"] = {
            "claudeAiOauth": live_oauth(),
            "oauthAccount": live_account_info(),
        }
        active = "(current)"
    return accounts, active


def collect_usage(accounts, active):
    """Fetch usage for every account in parallel. Never touches the live login
    except to persist a rotated token for the account that already owns it."""
    user_agent()  # prime the cached UA before threading
    with ThreadPoolExecutor(max_workers=max(1, min(8, len(accounts)))) as pool:
        fetched = list(pool.map(
            lambda item: usage_for(item[0], item[1], item[0] == active),
            accounts.items(),
        ))
    results, errors = {}, {}
    for name, (data, err) in zip(accounts, fetched):
        if err:
            errors[name] = err
        else:
            results[name] = data
    cache_store({n: d for n, d in results.items() if n != "(current)"})
    return results, errors


def token_health(snap):
    """(text, color) describing whether this account can still refresh itself."""
    if snap.get("authDead"):
        return "needs re-auth", RED
    exp = refresh_token_expires_at(snap)
    if not exp:
        return "", DIM
    left = exp - now_ms()
    if left <= 0:
        return "refresh token expired", RED
    if left < REFRESH_WARN_DAYS * 86400_000:
        return f"refresh token expires {age_text(exp)}", YELLOW
    return f"login good for {span_text(left)}", DIM


def render_error(name, snap, err, is_active, cached=None):
    """Account header + error line; if a cached result exists, show its bars too."""
    if cached:
        render_usage(name, snap, cached["data"], is_active,
                     note=f"cached {age_text(cached['fetchedAt'])}")
    else:
        acct = snap.get("oauthAccount", {})
        tier = (acct.get("organizationRateLimitTier", "")
                or snap["claudeAiOauth"].get("subscriptionType", "") or "")
        tier = tier.replace("default_claude_", "").replace("_", " ")
        marker = f"{GREEN}●{RESET}" if is_active else f"{DIM}○{RESET}"
        active_tag = f"  {CYAN}← active{RESET}" if is_active else ""
        tier_tag = f"  {DIM}({tier}){RESET}" if tier else ""
        print(f"{marker} {BOLD}{name}{RESET}{tier_tag}{active_tag}")
    print(f"    {RED}✗ {err}{RESET}")


def pct_colored(pct, width=4):
    color = GREEN if pct < 60 else YELLOW if pct < 85 else RED
    return f"{color}{pct:>{width}.0f}%{RESET}"


def limit_cols(data):
    """Ordered {column label: percent} for one account's usage."""
    cols = {}
    for lim in data.get("limits") or []:
        kind = lim.get("kind")
        if kind == "session":
            label = "session"
        elif kind == "weekly_all":
            label = "weekly"
        elif kind == "weekly_scoped":
            label = ((lim.get("scope") or {}).get("model") or {}).get("display_name") or "scoped"
        else:
            label = kind
        cols[label] = lim.get("percent", 0)
    if not cols:
        cols = {"session": session_pct(data), "weekly": weekly_pct(data)}
    return cols


def scoped_pct(data):
    """Model-scoped weekly limit (Fable) percent, or None if the account has none."""
    for lim in data.get("limits") or []:
        if lim.get("kind") == "weekly_scoped":
            return lim.get("percent", 0)
    return None


def fable_pct(data):
    p = scoped_pct(data)
    return p if p is not None else weekly_pct(data)


def best_account(results):
    """Best = usable now without credits: session, weekly (all), and Fable all < 100%.
    Among eligible: most Fable headroom, then session, then overall weekly.
    Returns (name, eligible_bool)."""
    eligible = [
        n for n in results
        if session_pct(results[n]) < 100
        and weekly_pct(results[n]) < 100
        and fable_pct(results[n]) < 100
    ]
    pool = eligible or list(results)
    pick = min(
        pool,
        key=lambda n: (fable_pct(results[n]), session_pct(results[n]), weekly_pct(results[n])),
    )
    return pick, bool(eligible)


def describe(results, name):
    d = results[name]
    return (f"Fable {fable_pct(d):.0f}% · weekly {weekly_pct(d):.0f}% · "
            f"session {session_pct(d):.0f}% used")


