def codex_smart_switch():
    accounts = codex_store_accounts()
    active = codex_active_name()
    if not accounts:
        die("no saved codex accounts — run: rota codex add")
    if len(accounts) == 1:
        name = next(iter(accounts))
        if name == active:
            print(f"only one codex account ({name}); already active")
            return
        return codex_do_switch(name)
    entries = collect_codex_usage(codex_switch_profiles())
    scored = {}
    for entry in entries:
        name = entry["profile"]["name"]
        if entry["error"]:
            print(f"{YELLOW}skipping {name}:{RESET} {entry['error']}")
            continue
        score = codex_score(entry)
        if score is not None:
            scored[name] = score
    if not scored:
        die("couldn't fetch usage for any codex account")
    eligible = {n: p for n, p in scored.items() if p < 100}
    if not eligible:
        print(f"{YELLOW}warning:{RESET} every codex account has a limit at 100% — picking least-bad")
    pool = eligible or scored
    best = min(pool, key=pool.get)
    if best == active:
        print(f"already on the best codex account: {BOLD}{best}{RESET} "
              f"({scored[best]:.0f}% max window used)")
        return
    vs = f"  {DIM}(current: {scored[active]:.0f}% max window used){RESET}" if active in scored else ""
    print(f"best: {BOLD}{best}{RESET} ({scored[best]:.0f}% max window used){vs}")
    codex_do_switch(best)


def codex_do_switch(name):
    target = read_json(codex_store_home(name) / "auth.json")
    if not target:
        die(f"no saved codex account {name!r} — see: rota codex list")
    current = codex_active_name()
    if current == name:
        print(f"{name} is already the active codex account")
        return
    # Sync live (possibly refreshed) tokens back into the outgoing account's snapshot
    live = read_json(codex_auth_file())
    if live:
        if current:
            write_json_atomic(codex_store_home(current) / "auth.json", live)
        elif any(codex_identity(live)[:2]):
            print(
                f"{YELLOW}warning:{RESET} current codex login is not saved as an account; "
                f"its tokens will be overwritten. Ctrl-C now and `rota codex save` to keep it."
            )
            time.sleep(3)
    # Swap only auth.json — Codex config/history and the Claude login are untouched
    write_json_atomic(codex_auth_file(), target)
    print(f"switched codex to {BOLD}{name}{RESET}")
    print(f"{DIM}new `codex` sessions will use this account; already-running sessions won't. "
          f"Claude account untouched.{RESET}")


def cmd_codex_add(args):
    prev = codex_active_name()
    live = read_json(codex_auth_file())
    if live and any(codex_identity(live)[:2]):
        if prev:
            write_json_atomic(codex_store_home(prev) / "auth.json", live)
            print(f"saved current codex tokens for {BOLD}{prev}{RESET}")
        else:
            prev = codex_snapshot_live()
            print(f"current codex login auto-saved as {BOLD}{prev}{RESET}")
    # Log out: drop auth.json so `codex login` starts fresh
    codex_auth_file().unlink(missing_ok=True)
    print(f"\nlaunching {BOLD}codex login{RESET} — sign in to the new account in the browser\n")
    try:
        subprocess.run([CODEX_BIN, "login"])
    except FileNotFoundError:
        die("`codex` not found on PATH")
    except KeyboardInterrupt:
        pass

    def restore_prev(reason):
        if not prev:
            return
        restored = read_json(codex_store_home(prev) / "auth.json")
        if restored:
            write_json_atomic(codex_auth_file(), restored)
            print(f"{reason} {BOLD}{prev}{RESET}")

    new = read_json(codex_auth_file())
    if new and any(codex_identity(new)[:2]):
        name = codex_snapshot_live()
        if name == prev:
            print(f"\n{YELLOW}note:{RESET} you logged into the same codex account ({name}) "
                  f"— nothing new added")
            return
        print(f"\nsaved new codex account {BOLD}{name}{RESET}")
        restore_prev("active codex account restored to")
        print(f"{DIM}use `rota codex switch {name}` when you want it{RESET}")
    else:
        print(f"\n{YELLOW}codex login didn't complete{RESET} — restoring previous account")
        restore_prev("restored")


