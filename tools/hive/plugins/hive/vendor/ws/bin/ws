#!/usr/bin/env python3
"""ws — work-stream registry for humans and coding agents.

Data lives in $WS_ROOT (default ~/streams):
  streams/<slug>/{STREAM.md,VISION.md,LOG.md,tasks/tN-*.md}
  inbox/<slug>/*.md          unread messages (read/ after delivery)
  todos.md                   loose personal to-dos
  index.html                 generated dashboard

Run `ws help` for the full reference. Python stdlib only.
"""

from __future__ import annotations

import argparse
import difflib
import fcntl
import html as html_mod
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import time
from datetime import datetime, timezone
from pathlib import Path

# ---------------------------------------------------------------------------
# paths / constants
# ---------------------------------------------------------------------------

WS_ROOT = Path(os.environ.get("WS_ROOT", str(Path.home() / "streams"))).expanduser()
STREAMS = WS_ROOT / "streams"
INBOX = WS_ROOT / "inbox"
CHANNELS = WS_ROOT / "channels"
TODOS = WS_ROOT / "todos.md"
INDEX_HTML = WS_ROOT / "index.html"

# `hq` is the human/manager mailbox: always addressable, never a stream.
HQ = "hq"

# The plugin this CLI ships in (bin/ws -> plugin root is bin/..)
PLUGIN_ROOT = Path(__file__).resolve().parent.parent
TEMPLATES = PLUGIN_ROOT / "templates"

STREAM_STATUSES = ("active", "blocked", "review", "parked", "done")
TASK_STATUSES = ("open", "active", "blocked", "done")
STATUS_ORDER = ("review", "blocked", "active", "parked", "done")

MSG_KINDS = ("fyi", "question", "decision", "review", "reply")
MSG_FM_KEYS = ["id", "from", "to", "kind", "sev", "reply_to",
               "expect_reply", "created"]

FM_KEYS = [
    "title", "status", "kind", "worktree", "branch", "repo", "prs",
    "harness", "session_id", "tmux_pane", "created", "updated", "next", "doc",
    "channels", "chan_pos", "flagged",
]
TASK_FM_KEYS = ["id", "title", "status", "owner", "created", "updated"]

STALE_SECONDS = 24 * 3600


class UserError(Exception):
    pass


# ---------------------------------------------------------------------------
# small utilities
# ---------------------------------------------------------------------------

def now_iso() -> str:
    return datetime.now().astimezone().replace(microsecond=0).isoformat()


def parse_iso(s: str) -> datetime | None:
    try:
        dt = datetime.fromisoformat(s)
        if dt.tzinfo is None:
            dt = dt.astimezone()
        return dt
    except (ValueError, TypeError):
        return None


def age_str(iso: str) -> str:
    dt = parse_iso(iso)
    if not dt:
        return "?"
    secs = (datetime.now(timezone.utc) - dt.astimezone(timezone.utc)).total_seconds()
    if secs < 0:
        secs = 0
    if secs < 90:
        return "now"
    if secs < 3600:
        return f"{int(secs // 60)}m"
    if secs < 48 * 3600:
        return f"{int(secs // 3600)}h"
    return f"{int(secs // 86400)}d"


def is_stale(meta: dict) -> bool:
    if meta.get("status") not in ("active", "blocked", "review"):
        return False
    dt = parse_iso(meta.get("updated", ""))
    if not dt:
        return False
    return (datetime.now(timezone.utc) - dt.astimezone(timezone.utc)).total_seconds() > STALE_SECONDS


def slugify(text: str) -> str:
    s = re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")
    return s[:48] or "item"


def atomic_write(path: Path, content: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=str(path.parent), prefix=".ws-tmp-")
    try:
        with os.fdopen(fd, "w") as f:
            f.write(content)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


class stream_lock:
    """flock on <stream>/.lock for read-modify-write cycles."""

    def __init__(self, target_dir: Path):
        self.path = target_dir / ".lock"
        self.f = None

    def __enter__(self):
        self.path.parent.mkdir(parents=True, exist_ok=True)
        self.f = open(self.path, "w")
        fcntl.flock(self.f, fcntl.LOCK_EX)
        return self

    def __exit__(self, *exc):
        if self.f:
            fcntl.flock(self.f, fcntl.LOCK_UN)
            self.f.close()


# ---------------------------------------------------------------------------
# frontmatter (strict `key: value` subset; valid YAML for Obsidian)
# ---------------------------------------------------------------------------

_NEEDS_QUOTE = re.compile(r'(^[\s"\'#\-{\[@&*?|>%!`])|(: )|( #)|(\s$)|(^$)')


def fm_quote(value: str) -> str:
    value = str(value).replace("\n", " ").replace("\r", " ")
    if _NEEDS_QUOTE.search(value):
        return json.dumps(value)
    return value


def fm_unquote(value: str) -> str:
    value = value.strip()
    if value.startswith('"') and value.endswith('"') and len(value) >= 2:
        try:
            return json.loads(value)
        except (json.JSONDecodeError, ValueError):
            return value
    return value


def parse_doc(text: str) -> tuple[dict, str]:
    """Return (frontmatter dict, body). Tolerates missing frontmatter."""
    if not text.startswith("---\n"):
        return {}, text
    end = text.find("\n---", 4)
    if end == -1:
        return {}, text
    fm_block = text[4:end]
    body = text[end + 4:]
    if body.startswith("\n"):
        body = body[1:]
    meta: dict = {}
    for line in fm_block.splitlines():
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        if ":" not in line:
            continue
        key, _, val = line.partition(":")
        meta[key.strip()] = fm_unquote(val)
    return meta, body


def serialize_doc(meta: dict, body: str, key_order: list[str]) -> str:
    lines = ["---"]
    seen = set()
    for k in key_order:
        if k in meta:
            lines.append(f"{k}: {fm_quote(meta.get(k) or '')}")
            seen.add(k)
    for k, v in meta.items():
        if k not in seen:
            lines.append(f"{k}: {fm_quote(v or '')}")
    lines.append("---")
    out = "\n".join(lines) + "\n"
    if body:
        out += "\n" + body.lstrip("\n")
    return out


# ---------------------------------------------------------------------------
# stream model
# ---------------------------------------------------------------------------

def stream_dir(slug: str) -> Path:
    return STREAMS / slug


def stream_file(slug: str) -> Path:
    return stream_dir(slug) / "STREAM.md"


def stream_exists(slug: str) -> bool:
    return stream_file(slug).is_file()


def all_slugs() -> list[str]:
    if not STREAMS.is_dir():
        return []
    return sorted(d.name for d in STREAMS.iterdir() if (d / "STREAM.md").is_file())


def load_meta(slug: str) -> dict:
    meta, _ = parse_doc(stream_file(slug).read_text())
    meta.setdefault("status", "active")
    meta.setdefault("kind", "agent")
    meta.setdefault("title", slug)
    return meta


def save_meta(slug: str, meta: dict, body: str | None = None) -> None:
    path = stream_file(slug)
    if body is None:
        _, body = parse_doc(path.read_text()) if path.is_file() else ({}, "")
    atomic_write(path, serialize_doc(meta, body, FM_KEYS))


def update_meta(slug: str, updates: dict, touch: bool = True,
                drop: tuple = ()) -> dict:
    """Locked read-modify-write of STREAM.md frontmatter. touch=False leaves
    the `updated` timestamp alone (for bookkeeping writes like pane caching)."""
    with stream_lock(stream_dir(slug)):
        meta, body = parse_doc(stream_file(slug).read_text())
        meta.update({k: v for k, v in updates.items() if v is not None})
        for k in drop:
            meta.pop(k, None)
        # Transparent legacy migration: fold a v<=0.2 single `pr:` value into
        # the `prs:` list on any write (empty legacy keys just drop).
        if "pr" in meta:
            legacy = (meta.pop("pr") or "").strip()
            if legacy:
                folded = [p for p in (s.strip() for s in (meta.get("prs") or "").split(","))
                          if p]
                ref = normalize_pr_ref(legacy.split()[0])
                if ref not in folded:
                    folded.append(ref)
                meta["prs"] = ", ".join(folded)
        if touch:
            meta["updated"] = now_iso()
        atomic_write(stream_file(slug), serialize_doc(meta, body, FM_KEYS))
        return meta


def require_slug(slug: str) -> str:
    if stream_exists(slug):
        return slug
    slugs = all_slugs()
    hint = ""
    close = difflib.get_close_matches(slug, slugs, n=1)
    if close:
        hint = f" Closest match: `{close[0]}`."
    raise UserError(
        f"Unknown stream `{slug}`.{hint} Run `ws status` to list streams, "
        f"or `ws register {slug}` / `ws add {slug}` to create it."
    )


def find_by_cwd(cwd: str | None = None) -> str | None:
    """Map cwd to a stream: the stream's own vault dir ($WS_ROOT/streams/<slug>,
    the natural home of manual streams) wins, else the longest registered
    worktree that is a prefix of cwd."""
    cwd_path = Path(cwd or os.getcwd()).resolve()
    try:
        rel = cwd_path.relative_to(STREAMS.resolve())
        if rel.parts and stream_exists(rel.parts[0]):
            return rel.parts[0]
    except (ValueError, OSError):
        pass
    best, best_len = None, -1
    home = Path.home().resolve()
    for slug in all_slugs():
        wt = load_meta(slug).get("worktree", "")
        if not wt:
            continue
        wt_path = Path(wt).expanduser()
        try:
            wt_res = wt_path.resolve()
        except OSError:
            continue
        if wt_res == home:
            # A stream rooted at $HOME would otherwise swallow every session on
            # the machine. Exact-dir only — never as a prefix.
            if cwd_path == home:
                if 0 > best_len:
                    best, best_len = slug, 0
            continue
        if cwd_path == wt_res or wt_res in cwd_path.parents:
            n = len(str(wt_res))
            if n > best_len:
                best, best_len = slug, n
    return best


def infer_slug(explicit: str | None, cwd: str | None = None) -> str:
    if explicit:
        return require_slug(explicit)
    found = find_by_cwd(cwd)
    if found:
        return found
    raise UserError(
        "No stream given and the current directory is not inside a registered "
        "worktree. Pass a slug (see `ws status`) or run from a registered worktree."
    )


def one_liner(slug: str) -> str:
    meta = load_meta(slug)
    open_t, total_t = task_counts(slug)
    parts = [f"{slug} — {meta.get('status')}"]
    if total_t:
        parts.append(f"tasks {total_t - open_t}/{total_t}")
    unread = unread_messages(slug)
    if unread:
        parts.append(f"inbox {len(unread)} unread")
    nxt = meta.get("next", "")
    if nxt:
        parts.append(f"next: {nxt}")
    return " · ".join(parts)


# ---------------------------------------------------------------------------
# tasks
# ---------------------------------------------------------------------------

def tasks_dir(slug: str) -> Path:
    return stream_dir(slug) / "tasks"


def task_files(slug: str) -> list[Path]:
    d = tasks_dir(slug)
    if not d.is_dir():
        return []
    return sorted(
        (p for p in d.glob("t*-*.md")),
        key=lambda p: int(re.match(r"t(\d+)-", p.name).group(1)) if re.match(r"t(\d+)-", p.name) else 0,
    )


def load_tasks(slug: str) -> list[dict]:
    out = []
    for p in task_files(slug):
        meta, body = parse_doc(p.read_text())
        meta["_path"] = p
        meta["_body"] = body
        out.append(meta)
    return out


def task_counts(slug: str) -> tuple[int, int]:
    tasks = load_tasks(slug)
    open_t = sum(1 for t in tasks if t.get("status") != "done")
    return open_t, len(tasks)


def find_task(slug: str, task_id: str) -> Path:
    for p in task_files(slug):
        if p.name.startswith(task_id + "-"):
            return p
    ids = [p.name.split("-", 1)[0] for p in task_files(slug)]
    hint = f" Existing ids: {', '.join(ids)}." if ids else " This stream has no tasks yet."
    raise UserError(f"No task `{task_id}` in stream `{slug}`.{hint} Run `ws task list`.")


# ---------------------------------------------------------------------------
# inbox — per-recipient maildir-ish mailboxes. A mailbox exists for every
# stream plus `hq` (the human/manager). Envelope lives in frontmatter:
# id / from / to / kind / sev / reply_to / expect_reply / created.
# Unread = top-level *.md; read/ after delivery; pending/ holds reply
# obligations (messages this mailbox owes an answer to).
# ---------------------------------------------------------------------------

def inbox_dir(slug: str) -> Path:
    return INBOX / slug


def pending_dir(slug: str) -> Path:
    return inbox_dir(slug) / "pending"


def mailbox_exists(slug: str) -> bool:
    return slug == HQ or stream_exists(slug)


def require_mailbox(slug: str) -> str:
    if mailbox_exists(slug):
        return slug
    return require_slug(slug)  # raises with the usual hints


def new_msg_id() -> str:
    return (datetime.now().strftime("%Y%m%d-%H%M%S")
            + f"-{os.getpid()}-{os.urandom(2).hex()}")


def write_message(to: str, text: str, sender: str, kind: str = "fyi",
                  sev: str = "", reply_to: str = "",
                  expect_reply: bool = False) -> str:
    """Queue a message in `to`'s mailbox. Returns the message id."""
    d = inbox_dir(to)
    d.mkdir(parents=True, exist_ok=True)
    (d / "read").mkdir(exist_ok=True)
    mid = new_msg_id()
    meta = {"id": mid, "from": sender, "to": to, "created": now_iso()}
    if kind and kind != "fyi":
        meta["kind"] = kind
    if sev:
        meta["sev"] = sev
    if reply_to:
        meta["reply_to"] = reply_to
    if expect_reply:
        meta["expect_reply"] = "true"
    atomic_write(d / f"{mid}.md",
                 serialize_doc(meta, text.strip() + "\n", MSG_FM_KEYS))
    return mid


def unread_messages(slug: str) -> list[Path]:
    d = inbox_dir(slug)
    if not d.is_dir():
        return []
    return sorted(p for p in d.glob("*.md") if p.is_file())


def total_unread() -> int:
    if not INBOX.is_dir():
        return 0
    return sum(len(unread_messages(d.name)) for d in INBOX.iterdir() if d.is_dir())


def render_message(path: Path) -> str:
    meta, body = parse_doc(path.read_text())
    frm = meta.get("from", "user")
    when = meta.get("created", "")
    tags = ""
    if meta.get("kind"):
        tags += f" {meta['kind'].upper()}"
    if meta.get("sev") == "high":
        tags += " ❗HIGH"
    line = f"[{when} from {frm}{tags}] {body.strip()}"
    if meta.get("expect_reply") == "true":
        line += (f"\n  ↳ reply expected: ws msg {meta.get('from', HQ)} "
                 f"--reply-to {meta.get('id', '?')} \"...\"")
    return line


def deliver_unread(slug: str) -> list[str]:
    """Return message texts and move files to read/ (exactly-once). Messages
    expecting a reply leave an obligation in pending/ that the Stop hook
    enforces until a reply is sent."""
    d = inbox_dir(slug)
    if not d.is_dir():
        return []
    delivered = []
    with stream_lock(d):
        read_dir = d / "read"
        read_dir.mkdir(exist_ok=True)
        for p in sorted(d.glob("*.md")):
            if not p.is_file():
                continue
            delivered.append(render_message(p))
            meta, _ = parse_doc(p.read_text())
            if meta.get("expect_reply") == "true" and meta.get("id"):
                pending_dir(slug).mkdir(exist_ok=True)
                try:
                    shutil.copy(p, pending_dir(slug) / p.name)
                except OSError:
                    pass
            os.replace(p, read_dir / p.name)
    delivered.extend(deliver_channels(slug))
    return delivered


def pending_replies(slug: str) -> list[Path]:
    d = pending_dir(slug)
    if not d.is_dir():
        return []
    return sorted(p for p in d.glob("*.md") if p.is_file())


def clear_pending(slug: str, reply_to: str) -> bool:
    p = pending_dir(slug) / f"{reply_to}.md"
    if p.is_file():
        try:
            p.unlink()
            return True
        except OSError:
            pass
    return False


def find_reply(slug: str, reply_to: str, deliver: bool = False) -> str | None:
    """Find a message in `slug`'s mailbox whose reply_to matches. Checks
    unread first, then read/ (a hook may have delivered it mid-wait).
    deliver=True moves an unread match to read/."""
    d = inbox_dir(slug)
    if not d.is_dir():
        return None
    for p in sorted(d.glob("*.md")):
        meta, _ = parse_doc(p.read_text())
        if meta.get("reply_to") == reply_to:
            text = render_message(p)
            if deliver:
                with stream_lock(d):
                    if p.is_file():
                        (d / "read").mkdir(exist_ok=True)
                        os.replace(p, d / "read" / p.name)
            return text
    read_dir = d / "read"
    if read_dir.is_dir():
        for p in sorted(read_dir.glob("*.md")):
            meta, _ = parse_doc(p.read_text())
            if meta.get("reply_to") == reply_to:
                return render_message(p)
    return None


# ---------------------------------------------------------------------------
# channels — named append-only logs (channels/<name>.md) with per-stream read
# cursors. No fan-out copies: posting appends once and drops a hidden
# .chan-pending marker in each subscriber's inbox so the pure-shell hook fast
# path notices; delivery reads from the subscriber's cursor and advances it.
# ---------------------------------------------------------------------------

CHAN_RE = re.compile(r"^[a-z0-9][a-z0-9-]{0,47}$")


def channel_file(name: str) -> Path:
    return CHANNELS / f"{name}.md"


def all_channels() -> list[str]:
    if not CHANNELS.is_dir():
        return []
    return sorted(p.stem for p in CHANNELS.glob("*.md"))


def parse_channel_target(target: str) -> str | None:
    """'#name' -> 'name' (validated), else None."""
    if not target.startswith("#"):
        return None
    name = target[1:]
    if not CHAN_RE.match(name):
        raise UserError(f"Bad channel name `{name}` (lowercase slug, <=48 chars).")
    return name


def subscribed_channels(meta: dict) -> list[str]:
    return [c.strip() for c in (meta.get("channels") or "").split(",") if c.strip()]


def get_cursors(meta: dict) -> dict[str, int]:
    out = {}
    for part in (meta.get("chan_pos") or "").split(","):
        if "=" in part:
            name, _, off = part.partition("=")
            try:
                out[name.strip()] = int(off)
            except ValueError:
                pass
    return out


def set_cursors(slug: str, cursors: dict[str, int]) -> None:
    val = ", ".join(f"{k}={v}" for k, v in sorted(cursors.items()))
    update_meta(slug, {"chan_pos": val}, touch=False)


def channel_subscribers(name: str) -> list[str]:
    return [s for s in all_slugs() if name in subscribed_channels(load_meta(s))]


def post_channel(name: str, text: str, sender: str) -> str:
    CHANNELS.mkdir(parents=True, exist_ok=True)
    mid = new_msg_id()
    path = channel_file(name)
    with stream_lock(CHANNELS):
        existing = path.read_text() if path.is_file() else f"# #{name}\n"
        if not existing.endswith("\n"):
            existing += "\n"
        existing += f"\n## {now_iso()} {sender} [{mid}]\n{text.strip()}\n"
        atomic_write(path, existing)
    for slug in channel_subscribers(name):
        if slug == sender:
            continue  # don't ring your own doorbell
        try:
            d = inbox_dir(slug)
            d.mkdir(parents=True, exist_ok=True)
            (d / ".chan-pending").touch(exist_ok=True)
        except OSError:
            pass
    return mid


def channel_tail(name: str, frm: int) -> tuple[str, int]:
    """Channel content from byte offset `frm`; returns (text, new_offset)."""
    path = channel_file(name)
    if not path.is_file():
        return "", 0
    data = path.read_text()
    if frm > len(data):  # channel file rewritten/truncated — restart cleanly
        frm = 0
    return data[frm:].strip(), len(data)


def deliver_channels(slug: str) -> list[str]:
    """New entries in every channel `slug` subscribes to; advances cursors."""
    if slug == HQ or not stream_exists(slug):
        return []
    meta = load_meta(slug)
    subs = subscribed_channels(meta)
    marker = inbox_dir(slug) / ".chan-pending"
    if not subs:
        marker.unlink(missing_ok=True)
        return []
    cursors = get_cursors(meta)
    out = []
    changed = False
    for name in subs:
        tail, new_off = channel_tail(name, cursors.get(name, 0))
        if tail:
            out.append(f"#{name}:\n{tail}")
        if new_off != cursors.get(name, 0):
            cursors[name] = new_off
            changed = True
    if changed:
        set_cursors(slug, cursors)
    marker.unlink(missing_ok=True)
    return out


def has_channel_pending(slug: str) -> bool:
    return (inbox_dir(slug) / ".chan-pending").is_file()


# ---------------------------------------------------------------------------
# tmux helpers
# ---------------------------------------------------------------------------

def tmux(*args: str, timeout: float = 5) -> subprocess.CompletedProcess | None:
    try:
        return subprocess.run(
            ["tmux", *args], capture_output=True, text=True, timeout=timeout
        )
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return None


def pane_alive(pane: str) -> bool:
    if not pane:
        return False
    # tmux 3.6 exits 0 with empty output for an unknown -t pane, so the exit
    # code alone can't be trusted — require the pane id echoed back.
    r = tmux("display-message", "-p", "-t", pane, "#{pane_id}")
    return bool(r and r.returncode == 0 and r.stdout.strip() == pane)


def pane_session(pane: str) -> str | None:
    r = tmux("display-message", "-p", "-t", pane, "#{session_name}")
    if r and r.returncode == 0 and r.stdout.strip():
        return r.stdout.strip()
    return None


def wake_pane(pane: str, text: str) -> bool:
    r1 = tmux("send-keys", "-t", pane, "-l", text)
    if not r1 or r1.returncode != 0:
        return False
    time.sleep(0.15)
    r2 = tmux("send-keys", "-t", pane, "Enter")
    return bool(r2 and r2.returncode == 0)


# --- live pane discovery -----------------------------------------------------
# `ws register` run from a harness Bash tool often gets a sanitized env with no
# TMUX_PANE (and CLAUDE_SESSION_ID is hook-stdin-only), so streams registered
# from pre-existing sessions end up with an empty/dead recorded pane. Recover by
# scanning tmux for a pane whose cwd is (inside) the stream's worktree and whose
# process tree contains a coding harness.

HARNESS_COMMS = ("claude", "codex", "gemini")


def parse_pane_list(text: str) -> list[dict]:
    rows = []
    for line in text.splitlines():
        parts = line.split("\t", 3)
        if len(parts) != 4:
            continue
        pane, session, pid, path = parts
        rows.append({"pane": pane, "session": session, "pid": pid, "path": path})
    return rows


def _proc_harness_lookup():
    """Return fn(pid_str) -> set of harness comms in that pid's descendant tree."""
    children: dict[str, list[str]] = {}
    comm: dict[str, str] = {}
    try:
        out = subprocess.run(["ps", "-eo", "pid=,ppid=,comm="],
                             capture_output=True, text=True, timeout=5).stdout
        for line in out.splitlines():
            parts = line.split(None, 2)
            if len(parts) != 3:
                continue
            pid, ppid, cm = parts
            comm[pid] = cm
            children.setdefault(ppid, []).append(pid)
    except (FileNotFoundError, subprocess.TimeoutExpired, OSError):
        pass

    def lookup(pid: str) -> set:
        found: set = set()
        stack = [pid]
        while stack:
            p = stack.pop()
            if comm.get(p, "") in HARNESS_COMMS:
                found.add(comm[p])
            stack.extend(children.get(p, []))
        return found

    return lookup


def select_pane(rows: list[dict], worktree: str, prefer_harness: str,
                harness_of) -> tuple[str | None, str]:
    """Pick the pane for a worktree. Precedence: path in worktree (exact or
    inside) -> must run a harness -> prefer the stream's harness -> prefer
    exact-path over subdirectory -> else ambiguous (pick none, say so)."""
    wt = str(Path(worktree).resolve())
    # A stream rooted at $HOME must not claim every harness pane on the machine
    # — for it, only a pane sitting exactly in $HOME counts.
    exact_only = wt == str(Path.home().resolve())
    cands = []
    for row in rows:
        try:
            p = str(Path(row["path"]).resolve())
        except OSError:
            continue
        if p == wt:
            exact = True
        elif not exact_only and p.startswith(wt + os.sep):
            exact = False
        else:
            continue
        harnesses = harness_of(row["pid"])
        if not harnesses:
            continue
        cands.append({**row, "exact": exact, "harnesses": harnesses})
    if not cands:
        return None, "no live harness pane found in the worktree"
    if len(cands) > 1 and prefer_harness:
        pref = [c for c in cands if prefer_harness in c["harnesses"]]
        if pref:
            cands = pref
    if len(cands) > 1:
        exact = [c for c in cands if c["exact"]]
        if exact:
            cands = exact
    if len(cands) == 1:
        return cands[0]["pane"], ""
    return None, ("ambiguous — multiple harness panes in the worktree: "
                  + ", ".join(f"{c['pane']} (session {c['session']})" for c in cands))


def discover_pane(worktree: str, prefer_harness: str = "") -> tuple[str | None, str]:
    if not worktree or not Path(worktree).expanduser().is_dir():
        return None, ""
    r = tmux("list-panes", "-a", "-F",
             "#{pane_id}\t#{session_name}\t#{pane_pid}\t#{pane_current_path}")
    if not r or r.returncode != 0:
        return None, ""
    return select_pane(parse_pane_list(r.stdout), worktree, prefer_harness,
                       _proc_harness_lookup())


def ensure_pane(slug: str, meta: dict) -> tuple[str, str]:
    """Recorded pane if alive; else discover in the worktree and persist the
    find (without touching `updated`). Returns (pane or '', note)."""
    pane = meta.get("tmux_pane", "")
    if pane and pane_alive(pane):
        return pane, ""
    found, note = discover_pane(meta.get("worktree", ""), meta.get("harness", ""))
    if found:
        try:
            update_meta(slug, {"tmux_pane": found}, touch=False)
        except Exception:
            pass
        return found, "discovered"
    return "", note


# Busy/idle classification from pane content, verified empirically 2026-07-27
# against live Claude Code panes on this machine: while the agent is mid-turn
# the status bar shows "esc to interrupt" (spinner variants also carry it);
# once idle that marker disappears while the composer prompt (❯) remains —
# the prompt is present in BOTH states, so only the marker discriminates.
# Codex (best-effort, no live pane available to verify): its working indicator
# is also an "esc to interrupt" hint, and its composer prompt is › or ▌.
PANE_BUSY_MARKERS = ("esc to interrupt",)  # case-insensitive substrings
PANE_IDLE_PROMPTS = ("❯", "›", "▌", "▸")   # composer-prompt line starts
PANE_CAPTURE_TAIL = 30


def classify_capture(text: str) -> str:
    """Classify captured pane content: 'busy' | 'idle' | 'alive' (unknown)."""
    tail = [l for l in text.splitlines() if l.strip()][-PANE_CAPTURE_TAIL:]
    joined = "\n".join(tail).lower()
    if any(m in joined for m in PANE_BUSY_MARKERS):
        return "busy"
    if any(l.strip().startswith(p) for l in tail for p in PANE_IDLE_PROMPTS):
        return "idle"
    return "alive"


def pane_state(pane: str) -> str:
    """'dead' | 'busy' | 'idle' | 'alive' (alive = up but unclassifiable)."""
    if not pane_alive(pane):
        return "dead"
    r = tmux("capture-pane", "-p", "-t", pane)
    if not r or r.returncode != 0 or not r.stdout.strip():
        return "alive"
    return classify_capture(r.stdout)


# ---------------------------------------------------------------------------
# git / gh helpers
# ---------------------------------------------------------------------------

def git_info(cwd: str) -> dict:
    info = {}
    try:
        r = subprocess.run(
            ["git", "-C", cwd, "symbolic-ref", "--short", "HEAD"],
            capture_output=True, text=True, timeout=5,
        )
        if r.returncode != 0:  # detached HEAD
            r = subprocess.run(
                ["git", "-C", cwd, "rev-parse", "--abbrev-ref", "HEAD"],
                capture_output=True, text=True, timeout=5,
            )
        if r.returncode == 0:
            info["branch"] = r.stdout.strip()
        r = subprocess.run(
            ["git", "-C", cwd, "remote", "get-url", "origin"],
            capture_output=True, text=True, timeout=5,
        )
        if r.returncode == 0:
            url = r.stdout.strip()
            m = re.search(r"[:/]([^/:]+/[^/]+?)(\.git)?$", url)
            if m:
                info["repo"] = m.group(1)
    except (FileNotFoundError, subprocess.TimeoutExpired, OSError):
        pass
    return info


_GH_BROKEN = False


# --- multi-PR tracking -------------------------------------------------------
# Schema: `prs:` is one comma-joined string ('#8281, #8290') — our strict
# key:value frontmatter handles it and it stays valid YAML. Legacy single
# `pr:` values fold into it transparently (read via get_prs, write via
# update_meta).

def normalize_pr_ref(ref: str) -> str:
    ref = ref.strip()
    m = re.match(r"^#?(\d+)$", ref)
    if m:
        return f"#{m.group(1)}"
    m = re.search(r"/pull/(\d+)\b", ref)
    if m:
        return f"#{m.group(1)}"
    return ref  # opaque ref; kept verbatim (escaped wherever displayed)


def get_prs(meta: dict) -> list[str]:
    out: list[str] = []
    for part in (meta.get("prs") or "").split(","):
        p = part.strip()
        if p:
            p = normalize_pr_ref(p)
            if p not in out:
                out.append(p)
    legacy = (meta.get("pr") or "").strip()
    if legacy:  # e.g. '#8281 open' from the old gh enrichment — first token
        ref = normalize_pr_ref(legacy.split()[0])
        if ref not in out:
            out.append(ref)
    return out


def set_prs(slug: str, prs: list[str]) -> None:
    update_meta(slug, {"prs": ", ".join(prs)}, drop=("pr",))


def gh_branch_pr(meta: dict) -> str | None:
    """'#N' if the worktree's current branch has an OPEN PR, else None."""
    global _GH_BROKEN
    if _GH_BROKEN or os.environ.get("WS_NO_GH"):
        return None
    wt, branch = meta.get("worktree", ""), meta.get("branch", "")
    if not wt or not branch or not Path(wt).is_dir():
        return None
    try:
        r = subprocess.run(
            ["gh", "pr", "view", branch, "--json", "number,state"],
            capture_output=True, text=True, timeout=5, cwd=wt,
        )
    except (FileNotFoundError, subprocess.TimeoutExpired, OSError):
        _GH_BROKEN = True
        return None
    if r.returncode != 0:
        if "auth" in (r.stderr or "").lower() or "gh: command" in (r.stderr or ""):
            _GH_BROKEN = True
        return None
    try:
        data = json.loads(r.stdout)
        if str(data.get("state", "")).upper() == "OPEN":
            return f"#{data['number']}"
    except (json.JSONDecodeError, KeyError):
        pass
    return None


def autocapture_pr(slug: str) -> None:
    """Auto-add the worktree branch's open PR to the stream's list."""
    try:
        meta = load_meta(slug)
        ref = gh_branch_pr(meta)
        if ref:
            prs = get_prs(meta)
            if ref not in prs:
                set_prs(slug, prs + [ref])
                print(f"(captured PR {ref} for branch {meta.get('branch')})")
    except Exception:
        pass


_REPO_PR_CACHE: dict[str, dict[int, tuple[str, str, str]]] = {}
PR_STATES_FILE = WS_ROOT / ".pr-states.json"


def _load_pr_states_file() -> dict:
    try:
        return json.loads(PR_STATES_FILE.read_text())
    except (OSError, json.JSONDecodeError):
        return {}


def _persist_pr_states() -> None:
    """Write-through the in-run gh cache so unenriched paths (html render,
    --no-gh) can show last-known state instead of blank."""
    try:
        disk = _load_pr_states_file()
        for repo, d in _REPO_PR_CACHE.items():
            slot = disk.setdefault(repo, {})
            for n, (state, ci, title) in d.items():
                if state:
                    slot[str(n)] = [state, ci, title]
        atomic_write(PR_STATES_FILE, json.dumps(disk))
    except OSError:
        pass


def cached_pr_states(repo: str, nums: list[int]) -> dict[int, tuple[str, str, str]]:
    """Last-known {num: (state, ci, title)} from disk — no network."""
    if not repo or not nums:
        return {}
    disk = _load_pr_states_file().get(repo, {})
    out = {}
    for n in nums:
        v = disk.get(str(n))
        if isinstance(v, list) and len(v) >= 2:
            out[n] = (v[0], v[1], v[2] if len(v) > 2 else "")
    return out


def repo_pr_states(repo: str, nums: list[int]) -> dict[int, tuple[str, str, str]]:
    """{num: (state, ci, title)} via ONE aliased GraphQL call per repo per run,
    fetching only the requested PRs with the aggregate statusCheckRollup state
    (`gh pr list --json statusCheckRollup` 504s on big repos — measured)."""
    global _GH_BROKEN
    if (not repo or "/" not in repo or not nums
            or _GH_BROKEN or os.environ.get("WS_NO_GH")):
        return {}
    cached = _REPO_PR_CACHE.setdefault(repo, {})
    missing = [n for n in nums if n not in cached]
    if missing:
        owner, name = repo.split("/", 1)
        fields = " ".join(
            f"p{n}: pullRequest(number: {n}) {{ number state title "
            "commits(last: 1) { nodes { commit { statusCheckRollup { state } } } } }"
            for n in missing)
        query = f'query {{ r: repository(owner: "{owner}", name: "{name}") {{ {fields} }} }}'
        try:
            r = subprocess.run(["gh", "api", "graphql", "-f", f"query={query}"],
                               capture_output=True, text=True, timeout=5)
            # gh exits 1 when any alias errors (e.g. deleted PR) but still
            # returns partial data on stdout — parse it regardless.
            try:
                data = json.loads(r.stdout or "{}").get("data", {}).get("r") or {}
            except json.JSONDecodeError:
                data = {}
            if r.returncode != 0 and "auth" in (r.stderr or "").lower():
                _GH_BROKEN = True
            for n in missing:
                pr = data.get(f"p{n}")
                if not pr:
                    cached[n] = ("", "", "")
                    continue
                nodes = (pr.get("commits") or {}).get("nodes") or []
                roll = ""
                if nodes:
                    roll = (((nodes[0] or {}).get("commit") or {})
                            .get("statusCheckRollup") or {}).get("state", "")
                ci = {"SUCCESS": "pass", "FAILURE": "fail", "ERROR": "fail"}.get(roll, "")
                cached[n] = (str(pr.get("state", "")).lower(), ci,
                             str(pr.get("title", "") or ""))
        except (FileNotFoundError, subprocess.TimeoutExpired, OSError):
            _GH_BROKEN = True
        _persist_pr_states()
    return cached


def prs_structured(meta: dict, enrich: bool) -> list[dict]:
    repo = meta.get("repo", "")
    refs = get_prs(meta)
    nums = [int(m.group(1)) for ref in refs if (m := re.match(r"^#(\d+)$", ref))]
    live = repo_pr_states(repo, nums) if enrich else {}
    # Disk cache fills whatever gh didn't answer (offline render, --no-gh,
    # gh briefly broken) — live results always win.
    states = {**cached_pr_states(repo, nums),
              **{n: v for n, v in live.items() if v[0]}}
    out = []
    for ref in refs:
        m = re.match(r"^#(\d+)$", ref)
        num = int(m.group(1)) if m else None
        state, ci, title = states.get(num, ("", "", "")) if num is not None else ("", "", "")
        url = f"https://github.com/{repo}/pull/{num}" if (repo and num) else ""
        out.append({"ref": ref, "num": num, "url": url, "state": state,
                    "ci": ci, "title": title})
    return out


def pr_rollup(prs: list[dict]) -> str:
    """Glance display: 1 PR -> '#N state ci'; >1 with exactly one open ->
    'N PRs · #M open ci'; >1 with states -> 'N PRs · k open'; no data -> 'N PRs'."""
    if not prs:
        return ""
    def mark(p):
        return {"pass": " ✓", "fail": " ✗"}.get(p["ci"], "")
    if len(prs) == 1:
        p = prs[0]
        return p["ref"] + (f" {p['state']}" if p["state"] else "") + mark(p)
    opens = [p for p in prs if p["state"] == "open"]
    if len(opens) == 1:
        return f"{len(prs)} PRs · {opens[0]['ref']} open{mark(opens[0])}"
    if any(p["state"] for p in prs):
        return f"{len(prs)} PRs · {len(opens)} open"
    return f"{len(prs)} PRs"


# ---------------------------------------------------------------------------
# commands
# ---------------------------------------------------------------------------

def cmd_register(args) -> int:
    cwd = os.getcwd()
    slug = args.slug or slugify(Path(cwd).name)
    fresh = not stream_exists(slug)
    harness = args.harness or ("claude" if os.environ.get("CLAUDECODE") else "claude")
    session_id = args.session_id or os.environ.get("CLAUDE_SESSION_ID", "")
    pane = args.pane or os.environ.get("TMUX_PANE", "")
    discovered = False
    if not pane:
        # Harness Bash tools often sanitize TMUX_PANE out of the env; recover
        # by scanning tmux for the harness pane sitting in this worktree.
        found, _note = discover_pane(cwd, harness)
        if found:
            pane, discovered = found, True
    git = git_info(cwd)

    if fresh:
        d = stream_dir(slug)
        (d / "tasks").mkdir(parents=True, exist_ok=True)
        inbox_dir(slug).mkdir(parents=True, exist_ok=True)
        (inbox_dir(slug) / "read").mkdir(exist_ok=True)
        meta = {
            "title": args.title or slug,
            "status": "active",
            "kind": "agent",
            "worktree": cwd,
            "branch": git.get("branch", ""),
            "repo": git.get("repo", ""),
            "prs": "",
            "harness": harness,
            "session_id": session_id,
            "tmux_pane": pane,
            "created": now_iso(),
            "updated": now_iso(),
            "next": "",
            "doc": args.doc or "",
        }
        body = "See VISION.md for the why and LOG.md for progress notes.\n"
        atomic_write(stream_file(slug), serialize_doc(meta, body, FM_KEYS))
        if not (d / "VISION.md").exists():
            atomic_write(
                d / "VISION.md",
                f"# {meta['title']} — vision\n\n"
                "<!-- Written once at registration: why this work exists, the north star,\n"
                "constraints and decisions that every future agent on this stream must know. -->\n",
            )
        if not (d / "LOG.md").exists():
            atomic_write(d / "LOG.md", f"# {meta['title']} — log\n")
        print(f"Registered stream `{slug}`.")
        print("Now write VISION.md (the why / north star) and set what's next:")
        print(f'  ws update {slug} --next "<first step>"')
    else:
        updates = {"worktree": cwd}
        for k, v in (("branch", git.get("branch")), ("repo", git.get("repo")),
                     ("session_id", session_id or None), ("tmux_pane", pane or None),
                     ("harness", args.harness), ("title", args.title), ("doc", args.doc)):
            if v:
                updates[k] = v
        update_meta(slug, updates)
        print(f"Stream `{slug}` already registered — refreshed worktree/session info.")
    if discovered:
        print(f"(pane {pane} discovered live in this worktree and recorded)")
    autocapture_pr(slug)
    print(one_liner(slug))
    render_html_safe()
    return 0


def cmd_add(args) -> int:
    slug = args.slug
    if stream_exists(slug):
        raise UserError(f"Stream `{slug}` already exists. Use `ws update {slug}` to change it.")
    d = stream_dir(slug)
    (d / "tasks").mkdir(parents=True, exist_ok=True)
    inbox_dir(slug).mkdir(parents=True, exist_ok=True)
    (inbox_dir(slug) / "read").mkdir(exist_ok=True)
    meta = {
        "title": args.title or slug,
        "status": "active",
        "kind": "manual",
        "worktree": "", "branch": "", "repo": "", "prs": "",
        "harness": "", "session_id": "", "tmux_pane": "",
        "created": now_iso(), "updated": now_iso(),
        "next": args.next or "",
    }
    atomic_write(stream_file(slug), serialize_doc(
        meta, "Manual stream (not agent-driven). See LOG.md for notes.\n", FM_KEYS))
    atomic_write(d / "VISION.md", f"# {meta['title']} — vision\n")
    atomic_write(d / "LOG.md", f"# {meta['title']} — log\n")
    print(f"Added manual stream `{slug}`.")
    print(one_liner(slug))
    render_html_safe()
    return 0


def cmd_todo(args) -> int:
    text = args.text.strip()
    if not text:
        raise UserError("Empty to-do text.")
    with stream_lock(WS_ROOT):
        existing = TODOS.read_text() if TODOS.is_file() else "# To-dos\n\n"
        if not existing.endswith("\n"):
            existing += "\n"
        existing += f"- [ ] {text} *(added {datetime.now().strftime('%Y-%m-%d')})*\n"
        atomic_write(TODOS, existing)
    print(f"Added to-do: {text}")
    render_html_safe()
    return 0


def cmd_update(args) -> int:
    slug = infer_slug(args.slug)
    if args.status and args.status not in STREAM_STATUSES:
        raise UserError(f"Invalid status `{args.status}`. One of: {', '.join(STREAM_STATUSES)}.")
    updates = {}
    if args.status:
        updates["status"] = args.status
    if args.next is not None:
        updates["next"] = args.next
    if args.title:
        updates["title"] = args.title
    if args.doc is not None:
        updates["doc"] = args.doc
    if getattr(args, "stream_kind", None):
        updates["kind"] = args.stream_kind
    if getattr(args, "worktree", None):
        wt = Path(args.worktree).expanduser()
        if not wt.is_dir():
            raise UserError(f"No such directory: {wt}")
        wt = wt.resolve()
        if wt == Path.home().resolve():
            raise UserError(
                "Refusing to root a stream at $HOME — every session that starts "
                "there would be mistaken for this stream. Use the stream's vault "
                f"dir ({stream_dir(slug)}) or a worktree.")
        updates["worktree"] = str(wt)
    if getattr(args, "session_id", None) is not None:
        updates["session_id"] = args.session_id
    if getattr(args, "pane", None) is not None:
        updates["tmux_pane"] = args.pane
    if not updates and not args.note and args.pr is None:
        raise UserError("Nothing to update. Pass --status / --next / --note / "
                        "--title / --pr / --doc / --kind / --worktree / "
                        "--session-id / --pane.")
    if updates:
        update_meta(slug, updates)
    if args.pr is not None:  # alias for `ws pr add` (what agents already learned)
        ref = normalize_pr_ref(args.pr)
        prs = get_prs(load_meta(slug))
        if ref not in prs:
            set_prs(slug, prs + [ref])
            print(f"Added PR {ref} to `{slug}`.")
    if args.note:
        append_log(slug, args.note)
    autocapture_pr(slug)
    print(one_liner(slug))
    render_html_safe()
    return 0


def cmd_done(args) -> int:
    slug = require_slug(args.slug)
    update_meta(slug, {"status": "done", "next": ""})
    print(f"Marked `{slug}` done.")
    print(one_liner(slug))
    render_html_safe()
    return 0


def append_log(slug: str, text: str) -> None:
    d = stream_dir(slug)
    with stream_lock(d):
        path = d / "LOG.md"
        existing = path.read_text() if path.is_file() else f"# {slug} — log\n"
        if not existing.endswith("\n"):
            existing += "\n"
        stamp = datetime.now().strftime("%Y-%m-%d %H:%M")
        existing += f"\n## {stamp}\n{text.strip()}\n"
        atomic_write(path, existing)
        # touch updated
        meta, body = parse_doc(stream_file(slug).read_text())
        meta["updated"] = now_iso()
        atomic_write(stream_file(slug), serialize_doc(meta, body, FM_KEYS))


def cmd_log(args) -> int:
    slug = infer_slug(args.slug)
    text = args.text
    if text == "-" or text is None:
        text = sys.stdin.read()
    if not text.strip():
        raise UserError("Empty log entry.")
    append_log(slug, text)
    print(f"Logged to `{slug}`.")
    print(one_liner(slug))
    render_html_safe()
    return 0


def cmd_task(args) -> int:
    sub = args.task_cmd
    if sub == "add":
        slug = infer_slug(args.stream)
        title = args.title.strip()
        if not title:
            raise UserError("Empty task title.")
        d = tasks_dir(slug)
        d.mkdir(parents=True, exist_ok=True)
        with stream_lock(stream_dir(slug)):
            nums = [int(m.group(1)) for p in task_files(slug)
                    if (m := re.match(r"t(\d+)-", p.name))]
            tid = f"t{max(nums, default=0) + 1}"
            path = d / f"{tid}-{slugify(title)}.md"
            meta = {"id": tid, "title": title, "status": "open",
                    "owner": args.owner or "", "created": now_iso(), "updated": now_iso()}
            atomic_write(path, serialize_doc(meta, "", TASK_FM_KEYS))
        print(f"Added task {tid} to `{slug}`: {title}")
        print(one_liner(slug))
        render_html_safe()
        return 0

    if sub == "list":
        slug = infer_slug(args.stream)
        tasks = load_tasks(slug)
        if not tasks:
            print(f"No tasks in `{slug}`. Add one: ws task add \"<milestone>\"")
            return 0
        for t in tasks:
            mark = "x" if t.get("status") == "done" else " "
            owner = f" (@{t['owner']})" if t.get("owner") else ""
            extra = f" [{t.get('status')}]" if t.get("status") not in ("done", "open") else ""
            print(f"- [{mark}] {t.get('id')}: {t.get('title')}{extra}{owner}")
        return 0

    if sub in ("done", "update"):
        slug = infer_slug(args.stream)
        path = find_task(slug, args.id)
        meta, body = parse_doc(path.read_text())
        if sub == "done":
            meta["status"] = "done"
        else:
            if args.status:
                if args.status not in TASK_STATUSES:
                    raise UserError(
                        f"Invalid task status `{args.status}`. One of: {', '.join(TASK_STATUSES)}.")
                meta["status"] = args.status
            if args.owner is not None:
                meta["owner"] = args.owner
            if args.title_new:
                meta["title"] = args.title_new
            if args.note:
                body = (body.rstrip() + f"\n\n{datetime.now().strftime('%Y-%m-%d %H:%M')}: {args.note}\n").lstrip("\n")
        meta["updated"] = now_iso()
        atomic_write(path, serialize_doc(meta, body, TASK_FM_KEYS))
        update_meta(slug, {})  # touch stream updated under lock
        print(f"Task {meta.get('id')} — {meta.get('status')}: {meta.get('title')}")
        print(one_liner(slug))
        render_html_safe()
        return 0

    raise UserError("Usage: ws task add|list|done|update … (see `ws help`)")


def cmd_pr(args) -> int:
    sub = args.pr_cmd
    if sub == "list":
        slug = infer_slug(args.slug)
        meta = load_meta(slug)
        prs = prs_structured(meta, enrich=not os.environ.get("WS_NO_GH"))
        if not prs:
            print(f"No PRs tracked on `{slug}`. Add one: ws pr add '#123'")
            return 0
        marks = {"pass": " CI ✓", "fail": " CI ✗"}
        for p in prs:
            line = f"- {p['ref']}"
            if p["state"]:
                line += f" {p['state']}"
            line += marks.get(p["ci"], "")
            if p["url"]:
                line += f"  {p['url']}"
            print(line)
        return 0
    if sub in ("add", "rm"):
        slug = infer_slug(args.slug)
        ref = normalize_pr_ref(args.ref)
        prs = get_prs(load_meta(slug))
        if sub == "add":
            if ref in prs:
                print(f"PR {ref} already tracked on `{slug}`.")
            else:
                prs.append(ref)
                set_prs(slug, prs)
                print(f"Added PR {ref} to `{slug}`.")
        else:
            if ref not in prs:
                raise UserError(
                    f"PR {ref} is not tracked on `{slug}`. "
                    f"Tracked: {', '.join(prs) or 'none'}. Run `ws pr list`.")
            prs.remove(ref)
            set_prs(slug, prs)
            print(f"Removed PR {ref} from `{slug}`.")
        print("PRs: " + (", ".join(prs) or "none"))
        render_html_safe()
        return 0
    raise UserError("Usage: ws pr add|rm|list … (see `ws help`)")


def default_sender() -> str:
    """Sender identity: the stream this cwd belongs to, `hq` from the vault,
    else $USER."""
    try:
        if Path(os.getcwd()).resolve() == WS_ROOT.resolve():
            return HQ
    except OSError:
        pass
    return find_by_cwd() or os.environ.get("USER", "user")


def nudge_stream(slug: str, note_text: str) -> str:
    """Best-effort wake of a stream's pane. Returns a human-readable outcome:
    'idle' | 'busy' | 'alive' | 'dead' | 'none' | 'ambiguous' | 'failed'."""
    if not stream_exists(slug):
        return "none"
    meta = load_meta(slug)
    pane, note = ensure_pane(slug, meta)
    if not pane:
        return "ambiguous" if note.startswith("ambiguous") else \
            ("dead" if meta.get("tmux_pane") else "none")
    state = pane_state(pane)
    if state == "dead":
        return "dead"
    if not wake_pane(pane, note_text):
        return "failed"
    return state


def cmd_msg(args) -> int:
    text = args.text
    if text == "-" or text is None:
        text = sys.stdin.read()
    if not text.strip():
        raise UserError("Empty message.")
    sender = args.sender or default_sender()
    kind = args.kind or ("reply" if args.reply_to else "fyi")
    if kind not in MSG_KINDS:
        raise UserError(f"Invalid --kind `{kind}`. One of: {', '.join(MSG_KINDS)}.")

    # Channel post: append once, ring every subscriber's doorbell.
    chan = parse_channel_target(args.slug)
    if chan is not None:
        if args.reply_to or args.expect_reply or args.wait is not None:
            raise UserError("Channels are broadcast-only: no --reply-to / "
                            "--expect-reply / --wait. DM the stream instead.")
        mid = post_channel(chan, text, sender)
        subs = channel_subscribers(chan)
        print(f"Posted to #{chan} [{mid}] — {len(subs)} subscriber(s).")
        if not args.no_wake:
            for s in subs:
                if s == sender:
                    continue
                out = nudge_stream(
                    s, f"New message in ws channel #{chan} — run: ws inbox read")
                if out in ("idle", "busy", "alive"):
                    print(f"  {s}: nudged ({out})")
        render_html_safe()
        return 0

    slug = require_mailbox(args.slug)
    if slug == sender:
        if args.sender:
            raise UserError(f"`{slug}` is you — pick another recipient.")
        # Inferred self-send = the human typing inside the stream's worktree.
        sender = os.environ.get("USER", "user")
    mid = write_message(slug, text, sender, kind=kind,
                        sev="high" if args.sev == "high" else "",
                        reply_to=args.reply_to or "",
                        expect_reply=bool(args.expect_reply))
    # A reply settles the sender's own obligation, if one exists.
    if args.reply_to and sender != HQ and stream_exists(sender):
        if clear_pending(sender, args.reply_to):
            print(f"(reply obligation {args.reply_to} cleared)")
    print(f"Message [{mid}] queued for `{slug}` "
          f"(inbox: {len(unread_messages(slug))} unread).")

    if slug == HQ:
        # No pane to wake: hq mail surfaces in brief/status/dashboard and is
        # delivered by hooks into the HQ manager session.
        print("hq mailbox — surfaces at the top of `ws brief`/`ws status` and "
              "in the HQ session via hooks.")
        render_html_safe()
        return 0

    out = "skipped" if args.no_wake else nudge_stream(
        slug, "You have a new ws inbox message — run: ws inbox read")
    meta = load_meta(slug)
    if out == "skipped":
        pass
    elif out == "idle":
        print(f"Pane idle — nudge submitted; the agent picks it up now.")
    elif out == "busy":
        print(f"Pane busy (agent mid-turn) — message will reach it via hooks "
              f"mid-turn; nudge queued as its next prompt.")
    elif out == "alive":
        print(f"Pane alive — nudge sent.")
    elif out == "failed":
        print(f"Failed to nudge pane; message remains queued for hooks.")
    elif out == "ambiguous":
        print(f"No wake sent — multiple harness panes in the worktree. Message "
              f"waits in the inbox; hooks deliver it at the session's next turn.")
    else:  # dead / none
        if args.revive:
            sess, pane, note = materialize_session(slug, meta)
            verb = "already running" if note == "exists" else "revived"
            print(f"Stream {verb}: tmux session `{sess}` (pane {pane}) — the "
                  f"session-start hook delivers the message on boot.")
        elif out == "dead":
            print(f"Pane dead — inbox only. Message waits there; "
                  f"`ws resume {slug}` (or --revive) to restart the stream.")
        else:
            print("No tmux pane recorded or discoverable — no wake sent. "
                  "It will be delivered by hooks at the session's next turn.")

    if args.wait is not None:
        deadline = time.time() + (args.wait or 600)
        mailbox = sender if mailbox_exists(sender) else HQ
        print(f"Waiting for a reply to [{mid}] in `{mailbox}`'s mailbox "
              f"(timeout {int(deadline - time.time())}s, Ctrl-C to stop)…")
        while time.time() < deadline:
            reply = find_reply(mailbox, mid, deliver=True)
            if reply:
                print(f"Reply:\n  {reply}")
                render_html_safe()
                return 0
            time.sleep(2)
        print("No reply before timeout — it will arrive in the mailbox; "
              f"check with `ws inbox --stream {mailbox}`.")
        render_html_safe()
        return 3
    render_html_safe()
    return 0


def cmd_inbox(args) -> int:
    slug = args.stream if args.stream == HQ else infer_slug(args.stream)
    owed = pending_replies(slug)
    if args.inbox_cmd == "read":
        msgs = deliver_unread(slug)
        if not msgs and not owed:
            print(f"Inbox for `{slug}` is empty.")
            return 0
        if msgs:
            print(f"{len(msgs)} message(s) for `{slug}` (now marked read):")
            for m in msgs:
                print(f"  - {m}")
        for p in owed:
            print(f"  ⏳ awaiting your reply: {render_message(p)}")
        render_html_safe()
        return 0
    msgs = unread_messages(slug)
    chan = " (+ new channel activity)" if has_channel_pending(slug) else ""
    if not msgs and not chan and not owed:
        print(f"Inbox for `{slug}` is empty.")
        return 0
    if msgs or chan:
        print(f"{len(msgs)} unread for `{slug}`{chan} "
              f"(use `ws inbox read` to mark read):")
        for p in msgs:
            print(f"  - {render_message(p)}")
    for p in owed:
        print(f"  ⏳ awaiting your reply: {render_message(p)}")
    return 0


def cmd_chan(args) -> int:
    sub = args.chan_cmd
    if sub == "list":
        names = all_channels()
        if not names:
            print("No channels yet. Create one by posting: ws msg '#name' \"...\"")
            return 0
        for n in names:
            subs = channel_subscribers(n)
            print(f"#{n} — {len(subs)} subscriber(s): {', '.join(subs) or '-'}")
        return 0
    if sub in ("join", "leave"):
        name = args.name.lstrip("#")
        if not CHAN_RE.match(name):
            raise UserError(f"Bad channel name `{name}`.")
        slug = infer_slug(args.stream)
        meta = load_meta(slug)
        subs = subscribed_channels(meta)
        if sub == "join":
            if name in subs:
                print(f"`{slug}` already subscribes to #{name}.")
                return 0
            subs.append(name)
            # Start the cursor at the channel's current end: joining a channel
            # subscribes you to NEW traffic, not its whole history.
            cursors = get_cursors(meta)
            _, end = channel_tail(name, 0)
            cursors[name] = end
            update_meta(slug, {"channels": ", ".join(subs)}, touch=False)
            set_cursors(slug, cursors)
            print(f"`{slug}` joined #{name} (history starts now; "
                  f"`ws chan history {name}` for the past).")
        else:
            if name not in subs:
                print(f"`{slug}` does not subscribe to #{name}.")
                return 0
            subs.remove(name)
            update_meta(slug, {"channels": ", ".join(subs)}, touch=False)
            print(f"`{slug}` left #{name}.")
        render_html_safe()
        return 0
    if sub == "history":
        name = args.name.lstrip("#")
        text, _ = channel_tail(name, 0)
        if not text:
            print(f"#{name} is empty (or does not exist).")
            return 0
        lines = text.splitlines()
        if args.tail and len(lines) > args.tail:
            lines = lines[-args.tail:]
        print("\n".join(lines))
        return 0
    raise UserError("Usage: ws chan list|join|leave|history … (see `ws help`)")


def hq_unread_by_sender() -> dict[str, list[Path]]:
    out: dict[str, list[Path]] = {}
    for p in unread_messages(HQ):
        meta, _ = parse_doc(p.read_text())
        out.setdefault(meta.get("from", "?"), []).append(p)
    return out


def collect_status(refresh_pr: bool = True) -> list[dict]:
    rows = []
    asked = hq_unread_by_sender()
    for slug in all_slugs():
        meta = load_meta(slug)
        open_t, total_t = task_counts(slug)
        prs = prs_structured(meta, enrich=refresh_pr)
        state = "-"
        if meta.get("kind") == "agent":
            p, _note = ensure_pane(slug, meta)
            if p:
                state = pane_state(p)
            elif meta.get("tmux_pane"):
                state = "dead"
        needs_why = []
        if meta.get("status") == "review":
            needs_why.append("in review — awaiting your review/merge")
        if meta.get("status") == "blocked":
            needs_why.append("status blocked")
        if slug in asked:
            kinds = [k for p in asked[slug]
                     if (k := (parse_doc(p.read_text())[0].get("kind") or "fyi"))]
            needs_why.append(f"{len(asked[slug])} message(s) to you"
                             + (f" ({', '.join(sorted(set(kinds)))})" if kinds else ""))
        if is_stale(meta):
            needs_why.append("stale")
        rows.append({
            "slug": slug,
            "title": meta.get("title", slug),
            "status": meta.get("status", "?"),
            "kind": meta.get("kind", "agent"),
            "tasks": f"{total_t - open_t}/{total_t}" if total_t else "-",
            "pr": pr_rollup(prs) or "-",
            "prs": prs,
            "pane": state,
            "doc": meta.get("doc", ""),
            "updated": meta.get("updated", ""),
            "age": age_str(meta.get("updated", "")),
            "stale": is_stale(meta),
            "unread": len(unread_messages(slug)),
            "next": meta.get("next", ""),
            "worktree": meta.get("worktree", ""),
            "branch": meta.get("branch", ""),
            "needs_you": bool(needs_why),
            "needs_why": needs_why,
            "channels": subscribed_channels(meta),
        })
    rows.sort(key=lambda r: (0 if r["needs_you"] and r["status"] != "done" else 1,
                             STATUS_ORDER.index(r["status"]) if r["status"] in STATUS_ORDER else 9,
                             r["slug"]))
    return rows


def cmd_prs(args) -> int:
    """Every PR across in-flight streams, merged/closed hidden by default."""
    rows = collect_status(refresh_pr=not args.no_gh)
    items, hidden = [], 0
    for r in rows:
        if r["status"] == "done" and not args.all:
            continue
        for p in r["prs"]:
            if p["state"] in ("merged", "closed") and not args.all:
                hidden += 1
                continue
            items.append({"stream": r["slug"], **p})
    hidden_note = (f"({hidden} merged/closed PR(s) hidden — `ws prs --all`)"
                   if hidden else "")
    if args.json:
        print(json.dumps(items, indent=2))
        return 0
    if not items:
        print("No open PRs across in-flight streams. " + hidden_note)
        return 0
    if args.md:
        for it in items:
            t = f" — {it['title']}" if it["title"] else ""
            u = f" ({it['url']})" if it["url"] else ""
            print(f"- [ ] {it['ref']} [{it['stream']}]{t}{u}")
    else:
        marks = {"pass": "✓", "fail": "✗"}
        headers = ["PR", "STATE", "CI", "STREAM", "TITLE"]
        table = [[it["ref"], it["state"] or "?", marks.get(it["ci"], ""),
                  it["stream"],
                  (it["title"][:57] + "…") if len(it["title"]) > 57 else it["title"]]
                 for it in items]
        widths = [max(len(h), *(len(row[i]) for row in table))
                  for i, h in enumerate(headers)]
        print("  ".join(h.ljust(widths[i]) for i, h in enumerate(headers)))
        for row in table:
            print("  ".join(c.ljust(widths[i]) for i, c in enumerate(row)))
    if hidden_note:
        print(hidden_note)
    return 0


def cmd_status(args) -> int:
    rows = collect_status(refresh_pr=not args.no_gh)
    if args.json:
        print(json.dumps(rows, indent=2, default=str))
        return 0
    if not rows:
        print("No streams registered. `ws register` in a worktree, or `ws add <slug>` for manual work.")
        return 0
    hq_n = len(unread_messages(HQ))
    if hq_n:
        print(f"📥 hq inbox: {hq_n} unread for YOU — `ws inbox read --stream hq`")
    shown = [r for r in rows if r["status"] != "done" or args.all]
    headers = ["STREAM", "!", "STATUS", "KIND", "TASKS", "PR", "PANE", "UPD", "NEXT"]
    table = []
    for r in shown:
        upd = r["age"] + (" ⚠" if r["stale"] else "")
        status = r["status"] + (f" ✉{r['unread']}" if r["unread"] else "")
        table.append([r["slug"], "✋" if r["needs_you"] else "", status, r["kind"],
                      r["tasks"], r["pr"], r["pane"], upd,
                      (r["next"][:60] + "…") if len(r["next"]) > 60 else r["next"]])
    widths = [max(len(h), *(len(row[i]) for row in table)) if table else len(h)
              for i, h in enumerate(headers)]
    print("  ".join(h.ljust(widths[i]) for i, h in enumerate(headers)))
    for row in table:
        print("  ".join(c.ljust(widths[i]) for i, c in enumerate(row)))
    hidden = len(rows) - len(shown)
    if hidden:
        print(f"({hidden} done stream(s) hidden — `ws status --all`)")
    return 0


def cmd_brief(args) -> int:
    print(f"# ws brief — {datetime.now().strftime('%Y-%m-%d %H:%M')}")
    print()
    if TODOS.is_file():
        todos = TODOS.read_text().strip()
        if todos:
            print("## Loose to-dos (todos.md)")
            print(todos)
            print()
    rows = collect_status(refresh_pr=not args.no_gh)
    live = [r for r in rows if r["status"] != "done"]
    done = [r for r in rows if r["status"] == "done"]
    needs = [r for r in live if r["needs_you"]]
    hq_msgs = unread_messages(HQ)
    if needs or hq_msgs:
        print(f"## Needs you — {len(needs)} stream(s), {len(hq_msgs)} hq message(s)")
        for p in hq_msgs:
            print(f"- 📥 {render_message(p)}")
        for r in needs:
            print(f"- ✋ {r['slug']}: {'; '.join(r['needs_why'])}")
        print()
    print(f"## Streams — {len(live)} in flight, {len(done)} done")
    for r in live:
        print()
        print(f"### {r['slug']} — {r['status']} ({r['kind']}) — {r['title']}")
        if r["worktree"]:
            print(f"- worktree: {r['worktree']} (branch {r['branch'] or '?'}, pane {r['pane']})")
        if r["prs"]:
            marks = {"pass": " ✓", "fail": " ✗"}
            print("- prs: " + ", ".join(
                p["ref"] + (f" {p['state']}" if p["state"] else "") + marks.get(p["ci"], "")
                for p in r["prs"]))
        print(f"- updated: {r['updated']} ({r['age']} ago){' ⚠ STALE' if r['stale'] else ''}")
        if r["next"]:
            print(f"- next: {r['next']}")
        vision = stream_dir(r["slug"]) / "VISION.md"
        if vision.is_file():
            vt = re.sub(r"<!--.*?-->", "", vision.read_text(), flags=re.S).strip()
            vt = "\n".join(l for l in vt.splitlines() if l.strip())
            if vt and vt != f"# {r['title']} — vision":
                print(f"- vision:\n{indent_block(vt[:2000])}")
        tasks = [t for t in load_tasks(r["slug"]) if t.get("status") != "done"]
        if tasks:
            print("- open tasks:")
            for t in tasks:
                extra = f" [{t.get('status')}]" if t.get("status") != "open" else ""
                print(f"    - {t.get('id')}: {t.get('title')}{extra}")
        if r["unread"]:
            print(f"- 📬 {r['unread']} unread inbox message(s)")
        if r["channels"]:
            print(f"- channels: {', '.join('#' + c for c in r['channels'])}")
        owed = pending_replies(r["slug"])
        if owed:
            print(f"- ⏳ owes {len(owed)} reply(ies): "
                  + "; ".join(parse_doc(p.read_text())[0].get("from", "?")
                              + " [" + p.stem + "]" for p in owed))
        log = stream_dir(r["slug"]) / "LOG.md"
        if log.is_file():
            tail = log_tail(log.read_text(), 3)
            if tail:
                print(f"- recent log:\n{indent_block(tail)}")
    if done:
        print()
        print("Done: " + ", ".join(r["slug"] for r in done))
    return 0


def indent_block(text: str, pad: str = "    ") -> str:
    return "\n".join(pad + l for l in text.splitlines())


def log_tail(text: str, n_entries: int) -> str:
    parts = re.split(r"(?m)^## ", text)
    entries = ["## " + p.strip() for p in parts[1:]]
    return "\n".join(entries[-n_entries:]) if entries else ""


def resume_ladder(meta: dict, extra: list[str]) -> str:
    """The shell command for a materialized session: the correct rung of the
    resume ladder first, chained so a dead rung falls through to a fresh
    harness instead of leaving a dead-on-arrival tmux session."""
    harness = meta.get("harness") or "claude"
    sid = meta.get("session_id", "")
    sfx = (" " + shlex.join(extra)) if extra else ""
    if harness == "codex":
        rungs = ([f"codex resume {shlex.quote(sid)}{sfx}"] if sid else []) \
            + [f"codex resume --last{sfx}", f"codex{sfx}"]
    elif harness == "gemini":
        rungs = [f"gemini{sfx}"]  # no reliable resume rung; fresh start
    else:
        rungs = ([f"claude --resume {shlex.quote(sid)}{sfx}"] if sid else []) \
            + [f"claude --continue{sfx}", f"claude{sfx}"]
    return " || ".join(rungs)


def session_has_harness(sess: str) -> bool:
    r = tmux("list-panes", "-t", sess, "-F", "#{pane_pid}")
    if not r or r.returncode != 0:
        return False
    lookup = _proc_harness_lookup()
    return any(lookup(pid.strip()) for pid in r.stdout.splitlines() if pid.strip())


def cmd_resume(args) -> int:
    slug = require_slug(args.slug)
    # argparse.REMAINDER swallows flags written after the slug positional
    # (`ws resume foo --print`) — reclaim our own flags from it.
    passthrough = list(args.passthrough or [])
    while passthrough and passthrough[0] in ("--print", "--exec", "--"):
        flag = passthrough.pop(0)
        if flag == "--print":
            args.print_ = True
        elif flag == "--exec":
            args.exec_ = True
        else:
            break  # explicit `--`: everything after is harness args
    args.passthrough = passthrough
    meta = load_meta(slug)
    pane, note = ensure_pane(slug, meta)
    if pane:
        sess = pane_session(pane) or ""
        extra = " — discovered live in the worktree" if note == "discovered" else ""
        print(f"Session is ALIVE in tmux (pane {pane}, session `{sess}`){extra}. Attach:")
        print(f"  tmux attach -t '{sess}'")
        if args.exec_:
            os.execvp("tmux", ["tmux", "attach", "-t", sess])
        return 0
    if note.startswith("ambiguous"):
        print(f"Note: {note} — not auto-attaching; pick one with tmux attach.")
        return 0

    wt, sid = meta.get("worktree", ""), meta.get("session_id", "")
    harness = meta.get("harness") or "claude"
    if args.print_:
        # Look-don't-touch: print the ladder instructions, create nothing.
        if wt and sid:
            resume_cmd = f"claude --resume {sid}" if harness == "claude" \
                else f"codex resume {sid}"
            print(f"No live pane. Resume the recorded {harness} session:")
            print(f"  cd {wt} && {resume_cmd}")
            return 0
        if wt:
            resume_cmd = "claude --continue" if harness == "claude" else "codex resume --last"
            print("No live pane or recorded session id. Resume the most recent "
                  "conversation in the worktree:")
            print(f"  cd {wt} && {resume_cmd}")
            print(f"(If there is none, start fresh: cd {wt} && {harness} — the stream's "
                  "context is re-injected on start.)")
            return 0
        print(f"`{slug}` is a manual stream (no worktree). Its home is "
              f"{stream_dir(slug)}; plain `ws resume {slug}` starts a session there.")
        return 0

    # Materialize: create the tmux session that SHOULD exist for this stream.
    passthrough = list(args.passthrough or [])
    if passthrough and passthrough[0] == "--":
        passthrough = passthrough[1:]
    sess, new_pane, note = materialize_session(slug, meta, passthrough)
    if note == "exists":
        print(f"tmux session `{sess}` already exists with a running harness. Attach:")
        print(f"  tmux attach -t {sess}")
        if args.exec_ or sys.stdout.isatty():
            os.execvp("tmux", ["tmux", "attach", "-t", sess])
        return 0
    print(f"Created tmux session `{sess}` (pane {new_pane}) in "
          f"{wt or stream_dir(slug)}")
    print(f"  running: {resume_ladder(meta, passthrough)}")
    render_html_safe()
    if args.exec_ or sys.stdout.isatty():
        os.execvp("tmux", ["tmux", "attach", "-t", sess])
    print(f"Attach: tmux attach -t {sess}")
    return 0


def materialize_session(slug: str, meta: dict,
                        passthrough: list[str] | None = None) -> tuple[str, str, str]:
    """Create (or find) the detached tmux session for a stream, running the
    resume ladder in its home. Returns (session, pane, note) where note is
    'created' or 'exists' (a harness is already running there)."""
    wt = meta.get("worktree", "")
    workdir = wt or str(stream_dir(slug))
    if wt and not Path(wt).is_dir():
        raise UserError(f"Recorded worktree {wt} no longer exists. "
                        f"Fix it with `ws register {slug}` from the new location.")
    sess = f"ws-{slug}"
    shcmd = resume_ladder(meta, list(passthrough or []))
    for attempt in (1, 2):
        r = tmux("has-session", "-t", sess)
        if r and r.returncode == 0:
            if session_has_harness(sess):
                pane_r = tmux("display-message", "-p", "-t", sess, "#{pane_id}")
                pane = pane_r.stdout.strip() if pane_r and pane_r.returncode == 0 else ""
                return sess, pane, "exists"
            # Stale shell, no harness (e.g. a tmux-resurrect restore) — replace.
            tmux("kill-session", "-t", sess)
        r = tmux("new-session", "-d", "-s", sess, "-c", workdir, shcmd)
        if r and r.returncode == 0:
            break
        # "duplicate session" = we lost a create race (tmux-continuum restoring
        # the same name at boot). Loop once: the recheck above resolves it.
        if attempt == 2 or not r or "duplicate session" not in (r.stderr or ""):
            raise UserError("Failed to create tmux session: "
                            f"{(r.stderr if r else 'tmux not available').strip()}")
        time.sleep(1.0)
    pane_r = tmux("display-message", "-p", "-t", sess, "#{pane_id}")
    new_pane = pane_r.stdout.strip() if pane_r and pane_r.returncode == 0 else ""
    if new_pane:
        update_meta(slug, {"tmux_pane": new_pane,
                           "harness": meta.get("harness") or "claude"}, touch=False)
    return sess, new_pane, "created"


def cmd_spawn(args) -> int:
    slug = args.slug
    harness = args.harness
    d = args.dir or (load_meta(slug).get("worktree", "") if stream_exists(slug) else "")
    if not d:
        raise UserError(f"No --dir given and `{slug}` has no recorded worktree.")
    d = str(Path(d).expanduser())
    if not Path(d).is_dir():
        raise UserError(f"Directory does not exist: {d}")
    sess = f"ws-{slug}"
    r = tmux("has-session", "-t", sess)
    if r and r.returncode == 0:
        raise UserError(f"tmux session `{sess}` already exists. Attach: tmux attach -t {sess}")
    r = tmux("new-session", "-d", "-s", sess, "-c", d, harness)
    if not r or r.returncode != 0:
        raise UserError(f"Failed to create tmux session: {(r.stderr if r else 'tmux not available').strip()}")
    pane_r = tmux("display-message", "-p", "-t", sess, "#{pane_id}")
    pane = pane_r.stdout.strip() if pane_r and pane_r.returncode == 0 else ""
    if stream_exists(slug) and pane:
        update_meta(slug, {"tmux_pane": pane, "harness": harness})
    print(f"Spawned `{harness}` for `{slug}` in tmux session `{sess}` (pane {pane}), dir {d}.")
    print(f"Attach: tmux attach -t {sess}")
    if not stream_exists(slug):
        print(f"Tip: have the agent run `ws register {slug}` once it starts.")
    render_html_safe()
    return 0


def cmd_init(args) -> int:
    """Create (or repair) the data vault at WS_ROOT. Idempotent."""
    created = []
    for d in (STREAMS, INBOX):
        if not d.is_dir():
            d.mkdir(parents=True, exist_ok=True)
            created.append(str(d))
    (STREAMS / ".gitkeep").touch(exist_ok=True)
    (INBOX / ".gitkeep").touch(exist_ok=True)

    def from_template(name: str, dest: Path) -> None:
        if dest.exists():
            return
        src = TEMPLATES / name
        if src.is_file():
            atomic_write(dest, src.read_text())
        created.append(str(dest))

    from_template("todos.md", TODOS)
    from_template("HQ-CLAUDE.md", WS_ROOT / "CLAUDE.md")
    from_template("README-vault.md", WS_ROOT / "README.md")
    agents = WS_ROOT / "AGENTS.md"
    if not agents.exists():
        try:
            agents.symlink_to("CLAUDE.md")
        except OSError:
            atomic_write(agents, (WS_ROOT / "CLAUDE.md").read_text())
        created.append(str(agents))
    if not (WS_ROOT / ".gitignore").exists():
        atomic_write(WS_ROOT / ".gitignore", ".lock\n*/.lock\nstreams/*/.lock\n")
    if not (WS_ROOT / ".git").is_dir():
        try:
            subprocess.run(["git", "init", "-b", "main"], cwd=WS_ROOT,
                           capture_output=True, text=True, timeout=15)
            subprocess.run(["git", "add", "-A"], cwd=WS_ROOT,
                           capture_output=True, text=True, timeout=15)
            subprocess.run(["git", "commit", "-m", "ws init"], cwd=WS_ROOT,
                           capture_output=True, text=True, timeout=15)
            created.append(str(WS_ROOT / ".git"))
        except (FileNotFoundError, subprocess.TimeoutExpired):
            pass
    render_html_safe()
    if created:
        print(f"Initialized vault at {WS_ROOT}:")
        for c in created:
            print(f"  + {c}")
    else:
        print(f"Vault at {WS_ROOT} already initialized — nothing to do.")
    print(f"Dashboard: {INDEX_HTML}")
    return 0


WRAPPER_TEMPLATE = """#!/bin/sh
# ws launcher — resolves the currently-installed ws plugin (survives autoUpdate).
RESOLVED=$(python3 - 2>/dev/null <<'PYEOF'
import glob, json, os
home = os.path.expanduser("~")
try:
    d = json.load(open(os.path.join(home, ".claude/plugins/installed_plugins.json")))
    for key, entries in d.get("plugins", {}).items():
        if key.split("@")[0] == "ws" and entries:
            p = os.path.join(entries[0]["installPath"], "bin", "ws")
            if os.access(p, os.X_OK):
                print(p)
                raise SystemExit
except SystemExit:
    raise
except Exception:
    pass
for p in sorted(glob.glob(os.path.join(home, ".claude/plugins/marketplaces/*/plugins/ws/bin/ws"))):
    if os.access(p, os.X_OK):
        print(p)
        break
PYEOF
)
[ -n "$RESOLVED" ] && [ -x "$RESOLVED" ] && exec "$RESOLVED" "$@"
DEV="{dev_path}"
[ -x "$DEV" ] && exec "$DEV" "$@"
echo "ws: no installation found (plugin not installed and dev checkout missing)" >&2
exit 127
"""


def cmd_setup(args) -> int:
    """Wire this machine up: PATH launcher, Codex skill, vault. Idempotent."""
    bin_dir = Path(args.bin_dir or (Path.home() / ".local" / "bin")).expanduser()
    codex_skills = Path(args.codex_skills_dir or (Path.home() / ".codex" / "skills")).expanduser()

    bin_dir.mkdir(parents=True, exist_ok=True)
    launcher = bin_dir / "ws"
    atomic_write(launcher, WRAPPER_TEMPLATE.replace("{dev_path}", str(PLUGIN_ROOT / "bin" / "ws")))
    launcher.chmod(0o755)
    print(f"Installed launcher: {launcher}")

    if codex_skills.is_dir() or args.codex_skills_dir:
        codex_skills.mkdir(parents=True, exist_ok=True)
        link = codex_skills / "ws"
        target = PLUGIN_ROOT / "skills" / "ws"
        # Prefer the auto-updating marketplace clone if this checkout isn't it.
        for cand in sorted(Path.home().glob(".claude/plugins/marketplaces/*/plugins/ws/skills/ws")):
            target = cand
            break
        if link.is_symlink() or link.exists():
            if link.is_symlink() and link.resolve() == target.resolve():
                print(f"Codex skill already linked: {link}")
            else:
                print(f"Codex skill path exists ({link}) — leaving it alone. "
                      f"Link manually if desired: ln -sfn {target} {link}")
        else:
            link.symlink_to(target)
            print(f"Linked Codex skill: {link} -> {target}")
        print("Codex plugin (full hooks integration): codex plugin marketplace add jhh3/streams"
              " && codex plugin add ws@streams")
        # Plain Codex (no plugin): wire hooks.json directly at the user layer,
        # pointing at this checkout's hook scripts with absolute paths.
        codex_hooks = codex_skills.parent / "hooks.json"
        if not codex_hooks.exists():
            src = json.loads((PLUGIN_ROOT / "hooks" / "codex-hooks.json").read_text())
            cfg = json.loads(json.dumps(src).replace(
                "${CLAUDE_PLUGIN_ROOT}", str(PLUGIN_ROOT)))
            atomic_write(codex_hooks, json.dumps(cfg, indent=2) + "\n")
            print(f"Wrote Codex hooks: {codex_hooks} (SessionStart/UserPromptSubmit/"
                  f"PostToolUse/Stop -> ws hook)")
        else:
            print(f"Codex hooks.json already exists: {codex_hooks} — left alone.")
    else:
        print("~/.codex not found — skipped Codex wiring.")

    gemini_dir = Path.home() / ".gemini"
    if gemini_dir.is_dir():
        ext_dir = gemini_dir / "extensions"
        ext_dir.mkdir(parents=True, exist_ok=True)
        link = ext_dir / "ws"
        target = PLUGIN_ROOT / "gemini-extension"
        if link.is_symlink() or link.exists():
            print(f"Gemini extension path exists ({link}) — left alone.")
        elif target.is_dir():
            link.symlink_to(target)
            print(f"Linked Gemini extension: {link} -> {target}")
    else:
        print("~/.gemini not found — skipped Gemini wiring.")

    if not args.skip_init:
        cmd_init(args)
    print("\nIf the Claude Code plugin isn't installed yet:")
    print("  /plugin marketplace add jhh3/streams   (then) /plugin install ws@streams")
    return 0


def cmd_admin(args) -> int:
    """Launch (or print) the HQ manager session in the vault."""
    if not STREAMS.is_dir() or not (WS_ROOT / "CLAUDE.md").is_file():
        raise UserError(
            f"Vault at {WS_ROOT} is not initialized (missing streams/ or CLAUDE.md). "
            "Run `ws init` (or install.sh) first.")
    # The user's own alias for this is `copus` = `claude --dangerously-skip-permissions`;
    # aliases don't resolve for subprocesses, so spell it out.
    cmd = ["claude", "--dangerously-skip-permissions"]
    if args.model:
        cmd += ["--model", args.model]
    passthrough = list(args.passthrough or [])
    if passthrough and passthrough[0] == "--":
        passthrough = passthrough[1:]
    cmd += passthrough
    if args.prompt:
        cmd.append(args.prompt)
    if args.dry_run:
        print(f"cd {shlex.quote(str(WS_ROOT))} && {shlex.join(cmd)}")
        return 0
    os.chdir(WS_ROOT)
    os.execvp(cmd[0], cmd)


def cmd_classify(args) -> int:
    """Internal/test: classify pane-capture text from stdin -> busy|idle|alive."""
    print(classify_capture(sys.stdin.read()))
    return 0


def cmd_match(args) -> int:
    """Internal/test: run the pane-discovery matcher on fixture pane-list text
    from stdin. --harness-map 'pid=claude,pid=codex' fakes the process check."""
    hmap: dict[str, set] = {}
    for part in (args.harness_map or "").split(","):
        if "=" in part:
            pid, h = part.split("=", 1)
            hmap.setdefault(pid.strip(), set()).add(h.strip())
    pane, note = select_pane(parse_pane_list(sys.stdin.read()), args.worktree,
                             args.prefer or "", lambda pid: hmap.get(pid, set()))
    print(pane if pane else f"none: {note}")
    return 0


def cmd_sync(args) -> int:
    # Refresh PR states + dashboard first so the hourly commit ships a current
    # index.html even when no interactive command ran in between.
    try:
        collect_status(refresh_pr=True)
        render_html()
    except Exception:
        pass
    def run(*cmd):
        return subprocess.run(cmd, cwd=WS_ROOT, capture_output=True, text=True, timeout=60)
    try:
        run("git", "add", "-A")
        r = run("git", "commit", "-m", f"ws sync {now_iso()}")
        if r.returncode == 0:
            print("Committed.")
        else:
            print("Nothing to commit." if "nothing to commit" in r.stdout + r.stderr
                  else f"Commit failed: {(r.stderr or r.stdout).strip()}")
        p = run("git", "push")
        print("Pushed." if p.returncode == 0
              else f"Push skipped/failed: {(p.stderr.strip().splitlines() or ['?'])[0]}")
    except (FileNotFoundError, subprocess.TimeoutExpired) as e:
        print(f"git unavailable: {e}")
    return 0


