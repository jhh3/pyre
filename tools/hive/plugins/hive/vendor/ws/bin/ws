a { color:var(--accent); }
</style></head><body>
<header>
<h1>Work streams</h1><span class="gen">__GEN__ · auto-refresh 30s</span>
<div class="counts">__COUNTS__</div>
__NEEDSYOU__
__OPENPRS__
</header>
__TODOS__
__SECTIONS__
__DONE__
<script>
(function () {
  var KEY = 'ws-dash-v1';
  var state = {};
  try { state = JSON.parse(localStorage.getItem(KEY) || '{}'); } catch (e) {}
  var open = {};
  (state.open || []).forEach(function (s) { open[s] = true; });
  var cards = document.querySelectorAll('details[data-slug]');
  cards.forEach(function (d) {
    var slug = d.getAttribute('data-slug');
    if (open[slug]) { d.open = true; }
    d.addEventListener('toggle', function () {
      if (d.open) { open[slug] = true; } else { delete open[slug]; }
      save();
    });
  });
  function save() {
    try {
      localStorage.setItem(KEY, JSON.stringify(
        { open: Object.keys(open), scroll: window.scrollY }));
    } catch (e) {}
  }
  if (typeof state.scroll === 'number') { window.scrollTo(0, state.scroll); }
  var st;
  addEventListener('scroll', function () {
    clearTimeout(st); st = setTimeout(save, 150);
  }, { passive: true });
  setTimeout(function () { save(); location.reload(); }, 30000);
})();
</script>
</body></html>
"""


def render_html() -> None:
    e = html_mod.escape
    rows = collect_status(refresh_pr=False)
    live = [r for r in rows if r["status"] != "done"]
    done_rows = [r for r in rows if r["status"] == "done"]

    def attention(r: dict) -> bool:
        return bool(r["unread"] or r["status"] in ("blocked", "review")
                    or r["stale"])

    needs = [r for r in live if attention(r)]
    rest = [r for r in live if not attention(r)]
    active = [r for r in rest if r["status"] == "active"]
    quiet = [r for r in rest if r["status"] != "active"]

    counts = (f"{len(live)} in flight — "
              f"{sum(1 for r in live if r['status'] == 'active')} active · "
              f"{sum(1 for r in live if r['status'] == 'blocked')} blocked · "
              f"{sum(1 for r in live if r['status'] == 'review')} review · "
              f"{sum(1 for r in live if r['unread'])} ✉ unread · "
              f"{sum(1 for r in live if r['stale'])} stale")

    needs_you = [(r["slug"], r["next"] or "blocked, no next set")
                 for r in live
                 if r["status"] in ("blocked", "review")
                 or NEEDS_YOU_RE.match(r["next"] or "")]
    needsyou_html = ""
    if needs_you:
        items = " · ".join(
            f"<b>{e(s)}</b> <span title='{e(n)}'>({e(n[:60])}{'…' if len(n) > 60 else ''})</span>"
            for s, n in needs_you)
        needsyou_html = f"<div class='needsyou'>needs you: {items}</div>"

    open_prs = [(r["slug"], p) for r in live for p in r["prs"]
                if p["state"] not in ("merged", "closed")]
    openprs_html = ""
    if open_prs:
        def pr_bit(slug: str, p: dict) -> str:
            mark = {"pass": " ✓", "fail": " ✗"}.get(p["ci"], "")
            label = f"{e(p['ref'])}{'' if p['state'] else ' ?'}{mark}"
            tip = e(p["title"] or p["ref"])
            body = (f"<a href='{e(p['url'])}' target='_blank' title='{tip}'>{label}</a>"
                    if p["url"] else f"<span title='{tip}'>{label}</span>")
            return f"{body} <span class='prstream'>{e(slug)}</span>"
        openprs_html = (f"<div class='openprs'>open PRs ({len(open_prs)}): "
                        + " · ".join(pr_bit(s, p) for s, p in open_prs) + "</div>")

    todos_html = ""
    if TODOS.is_file():
        items = []
        for line in TODOS.read_text().splitlines():
            m = re.match(r"^- \[( |x)\] (.*)$", line)
            if m:
                done_t = m.group(1) == "x"
                items.append(f"<li class='{'tdone' if done_t else ''}'>"
                             f"{'☑' if done_t else '☐'} {e(m.group(2))}</li>")
        if items:
            todos_html = (f"<details class='todos' data-slug='__todos'>"
                          f"<summary>to-dos ({len(items)})</summary>"
                          f"<ul>{''.join(items)}</ul></details>")

    def dot_html(state: str) -> str:
        cls = _DOT_CLASS.get(state)
        if not cls:
            return ""
        return f"<span class='dot {cls}' title='session {e(state)}'></span>"

    def taskbar(r: dict) -> str:
        if r["tasks"] == "-":
            return ""
        done_n, total = (int(x) for x in r["tasks"].split("/"))
        pct = round(done_n / total * 100) if total else 0
        return (f"<span class='tbar' title='tasks {e(r['tasks'])} done'>"
                f"<span class='tfill' style='width:{pct}%'></span></span>"
                f"<span class='tnum'>{e(r['tasks'])}</span>")

    def card(r: dict) -> str:
        slug = r["slug"]
        color = STATUS_COLORS.get(r["status"], "#616161")
        mail = f"<span class='mail' title='unread inbox'>✉{r['unread']}</span>" if r["unread"] else ""
        age = (f"<span class='age{' stale' if r['stale'] else ''}' "
               f"title='updated {e(r['updated'])}'>{e(r['age'])}{' ⚠' if r['stale'] else ''}</span>")
        snext = e(r["next"]) if r["next"] else "<span class='dim'>no next set</span>"
        l3_bits = [taskbar(r)]
        if r["pr"] != "-":
            l3_bits.append(f"<span class='prroll' title='pull requests'>{e(r['pr'])}</span>")
        if r["branch"]:
            l3_bits.append(f"<span class='br' title='branch'>{e(r['branch'])}</span>")
        l3 = "".join(b for b in l3_bits if b)
        summary = (
            "<summary>"
            f"<div class='l1'>{dot_html(r['pane'])}"
            f"<span class='ttl' title='{e(slug)}'>{e(r['title'])}</span>"
            f"<span class='pill' style='background:{color}'>{e(r['status'])}</span>"
            f"{mail}<span class='sp'></span>{age}</div>"
            f"<div class='l2'>{snext}</div>"
            + (f"<div class='l3'>{l3}</div>" if l3 else "")
            + "</summary>")

        d: list[str] = []

        def row(lbl: str, val_html: str) -> None:
            d.append(f"<div class='row'><span class='lbl'>{lbl}</span>"
                     f"<span class='rowv'>{val_html}</span></div>")

        if r["next"]:
            row("next", e(r["next"]))
        tasks = load_tasks(slug)
        if tasks:
            lis = []
            for t in tasks:
                tdone = t.get("status") == "done"
                extra = (f" <em>[{e(t.get('status', ''))}]</em>"
                         if t.get("status") not in ("done", "open") else "")
                lis.append(f"<li class='{'tdone' if tdone else ''}'>"
                           f"{'☑' if tdone else '☐'} <b>{e(t.get('id', '?'))}</b> "
                           f"{e(t.get('title', ''))}{extra}</li>")
            row("tasks", f"<ul>{''.join(lis)}</ul>")
        if r["prs"]:
            marks = {"pass": " ✓", "fail": " ✗"}
            parts = []
            for p in r["prs"]:
                label = e(p["ref"]) + (f" {e(p['state'])}" if p["state"] else "") \
                    + marks.get(p["ci"], "")
                if p["url"]:
                    parts.append(f"<a target='_blank' rel='noopener' "
                                 f"href='{e(p['url'])}'>{label}</a>")
                else:
                    parts.append(label)
            row("prs", " · ".join(parts))
        if r["worktree"]:
            meta = load_meta(slug)
            wt = f"<code>{e(r['worktree'])}</code>"
            if r["branch"]:
                wt += f" @ <code>{e(r['branch'])}</code>"
            if meta.get("harness"):
                wt += f" · {e(meta['harness'])}"
            row("where", wt)
        links = stream_doc_links(slug, r.get("doc", ""), r["title"])
        if links:
            row("docs", "".join(
                f"<a class='doclink' target='_blank' rel='noopener' href='{e(h)}'>{e(l)}</a>"
                for l, h in links))
        previews = unread_messages(slug)[:3]
        if previews:
            row("inbox", "<br>".join(
                f"<span class='msgprev'>{e(render_message(p)[:200])}</span>" for p in previews))
        row("resume", f"<code>ws resume {e(slug)}</code>")
        return (f"<details class='card' data-slug='{e(slug)}'>{summary}"
                f"<div class='detail'>{''.join(d)}</div></details>")

    sections = []
    for label, group in (("needs attention", needs), ("active", active),
                         ("parked", quiet)):
        if group:
            sections.append(f"<section><h2>{label} ({len(group)})</h2>"
                            + "".join(card(r) for r in group) + "</section>")
    if not sections:
        sections.append("<p>No streams in flight. <code>ws register</code> in a "
                        "worktree to start one.</p>")
    done_html = ""
    if done_rows:
        done_html = (f"<details class='donewrap' data-slug='__done'>"
                     f"<summary>done ({len(done_rows)})</summary>"
                     + "".join(card(r) for r in done_rows) + "</details>")

    page = (DASH_TMPL
            .replace("__GEN__", e(datetime.now().strftime("%Y-%m-%d %H:%M:%S")))
            .replace("__COUNTS__", counts)
            .replace("__NEEDSYOU__", needsyou_html)
            .replace("__OPENPRS__", openprs_html)
            .replace("__TODOS__", todos_html)
            .replace("__SECTIONS__", "".join(sections))
            .replace("__DONE__", done_html))
    atomic_write(INDEX_HTML, page)


def render_html_safe() -> None:
    try:
        render_html()
    except Exception:
        pass  # dashboard is best-effort; never fail the command


def cmd_html(args) -> int:
    render_html()
    print(f"Wrote {INDEX_HTML}")
    return 0


def launch_browser(url: str) -> bool:
    opener = shutil.which("xdg-open") or shutil.which("open")
    if not opener:
        print(f"No opener found (xdg-open/open). Open manually: {url}")
        return False
    subprocess.Popen(
        [opener, url],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    print(f"Opened {url}")
    return True


def cmd_open(args) -> int:
    render_html()
    return 0 if launch_browser(INDEX_HTML.resolve().as_uri()) else 1


# ---------------------------------------------------------------------------
# hooks
# ---------------------------------------------------------------------------

def hook_output_context(event: str, text: str) -> None:
    print(json.dumps({
        "hookSpecificOutput": {"hookEventName": event, "additionalContext": text}
    }))


def cmd_hook(args) -> int:
    try:
        payload = json.loads(sys.stdin.read() or "{}")
    except json.JSONDecodeError:
        payload = {}
    cwd = payload.get("cwd") or os.getcwd()
    event = args.event

    if event == "session-start":
        try:
            if Path(cwd).resolve() == WS_ROOT.resolve():
                # HQ mode: inject the whole world.
                import io
                buf = io.StringIO()
                old = sys.stdout
                sys.stdout = buf
                try:
                    cmd_brief(argparse.Namespace(no_gh=True))
                finally:
                    sys.stdout = old
                extra = ""
                hq_msgs = deliver_unread(HQ)
                if hq_msgs:
                    extra = ("\n\nHQ inbox — messages for the human (now marked "
                             "read; triage them):\n"
                             + "\n".join(f"- {m}" for m in hq_msgs))
                hook_output_context(
                    "SessionStart",
                    "You are running inside the ws work-streams registry (HQ mode). "
                    "Current state of every stream and to-do follows. Re-run `ws brief` "
                    "any time for a fresh view.\n\n" + buf.getvalue() + extra)
                return 0
        except OSError:
            pass
        slug = find_by_cwd(cwd)
        if not slug:
            hook_output_context(
                "SessionStart",
                "ws: no registered work stream for this directory. If this session's work "
                "will outlive the session or span multiple PRs, register it with "
                "`ws register <slug>` (see the `ws` skill / `ws help`). Skip for quick one-offs.")
            return 0
        # Backfill session/pane so `ws resume` and wake stay honest — but only
        # when the session starts AT the stream's worktree. A stream rooted at
        # an ancestor directory (e.g. $HOME) must not adopt the identity of
        # every session that starts somewhere beneath it.
        meta = load_meta(slug)
        wt = meta.get("worktree", "")
        # A stream rooted at $HOME is exempt entirely: plenty of unrelated
        # sessions (cron skills, ad-hoc shells) start there, and each one would
        # otherwise steal the stream's session_id/pane.
        try:
            wt_res = Path(wt).expanduser().resolve() if wt else None
            at_root = bool(wt_res) and Path(cwd).resolve() == wt_res \
                and wt_res != Path.home().resolve()
        except OSError:
            at_root = False
        if at_root:
            updates = {}
            sid = payload.get("session_id", "")
            pane = os.environ.get("TMUX_PANE", "")
            if sid:
                updates["session_id"] = sid
            if pane:
                updates["tmux_pane"] = pane
            if updates:
                try:
                    update_meta(slug, updates)
                except Exception:
                    pass
            meta = load_meta(slug)
        lines = [
            f"ws: this directory is registered to work stream `{slug}` "
            f"({meta.get('title')}) — status {meta.get('status')}.",
        ]
        if meta.get("next"):
            lines.append(f"Recorded next step: {meta['next']}")
        vision = stream_dir(slug) / "VISION.md"
        if vision.is_file():
            vt = re.sub(r"<!--.*?-->", "", vision.read_text(), flags=re.S).strip()
            if vt and len(vt.splitlines()) > 1:
                lines.append("VISION.md (why this work exists):\n" + vt[:3000])
        doc_path_ = resolve_doc_path(slug, meta.get("doc", ""))
        if doc_path_ and doc_path_.suffix.lower() not in (".html", ".htm"):
            try:
                dt = doc_path_.read_text().strip()
                if dt:
                    lines.append(f"{doc_path_.name} (working doc — keep it current):\n"
                                 + dt[:2000])
            except OSError:
                pass
        open_tasks = [t for t in load_tasks(slug) if t.get("status") != "done"]
        if open_tasks:
            lines.append("Open tasks: " + "; ".join(
                f"{t.get('id')}: {t.get('title')}" for t in open_tasks))
        msgs = deliver_unread(slug)
        if msgs:
            lines.append("Unread inbox messages (now marked read — act on them):\n" +
                         "\n".join(f"- {m}" for m in msgs))
        lines.append(
            "Keep the registry current as you work: `ws log \"...\"` at milestones, "
            "`ws update --next \"...\"` when the plan changes, `ws task done <id>` "
            "when a task completes. `ws help` has the full reference.")
        hook_output_context("SessionStart", "\n\n".join(lines))
        return 0

    if event in ("user-prompt-submit", "post-tool-use"):
        slug = hook_mailbox_for(cwd)
        if not slug:
            return 0
        msgs = deliver_unread(slug) if slug != HQ else deliver_unread(HQ)
        if not msgs:
            return 0
        name = "UserPromptSubmit" if event == "user-prompt-submit" else "PostToolUse"
        whose = "HQ (the human's mailbox — triage them)" if slug == HQ \
            else f"stream `{slug}`"
        hook_output_context(
            name,
            f"ws inbox — new message(s) for {whose} (marked read; act on them):\n"
            + "\n".join(f"- {m}" for m in msgs))
        return 0

    if event == "stop":
        if payload.get("stop_hook_active"):
            return 0
        slug = find_by_cwd(cwd)
        if not slug:
            return 0
        msgs = deliver_unread(slug)
        owed = pending_replies(slug)
        if not msgs and not owed:
            return 0
        parts = []
        if msgs:
            parts.append(
                f"ws inbox — unread message(s) arrived for stream `{slug}` "
                "(now marked read):\n" + "\n".join(f"- {m}" for m in msgs))
        if owed:
            parts.append(
                "You owe replies before going idle (send them now — "
                "the sender is blocked on you):\n"
                + "\n".join(f"- {render_message(p)}" for p in owed))
        parts.append("Act on the above, then bring the stream record current "
                     "(`ws log` / `ws update --next`) before stopping.")
        print(json.dumps({"decision": "block", "reason": "\n\n".join(parts)}))
        return 0

    raise UserError(f"Unknown hook event `{args.event}`.")


def hook_mailbox_for(cwd: str) -> str | None:
    """Which mailbox a session at `cwd` reads: its stream's, or `hq` for a
    session inside the vault itself (the HQ manager)."""
    try:
        if Path(cwd).resolve() == WS_ROOT.resolve():
            return HQ
    except OSError:
        pass
    return find_by_cwd(cwd)


# ---------------------------------------------------------------------------
# mcp — stdio MCP server: the harness-agnostic verb surface. Tools only (no
# resources/sampling — poll-hostile clients are the norm); every tool result
# carries an unread-mail banner for the cwd's mailbox, so even hook-less MCP
# clients learn about mail whenever they touch ws.
# ---------------------------------------------------------------------------

WS_VERSION = "0.6.2"

MCP_TOOLS = [
    {"name": "ws_status",
     "description": "All work streams: status, tasks, PRs, pane liveness, "
                    "unread mail, needs-you flags. Start here.",
     "inputSchema": {"type": "object", "properties": {}}},
    {"name": "ws_brief",
     "description": "Full markdown dump of everything in flight (streams, "
                    "visions, tasks, unread, log tails) for agent ingestion.",
     "inputSchema": {"type": "object", "properties": {}}},
    {"name": "ws_send",
     "description": "Message a stream, `hq` (the human), or a `#channel`. "
                    "kind: fyi|question|decision|review|reply. Use "
                    "expect_reply for questions that block you; reply_to to "
                    "answer one.",
     "inputSchema": {"type": "object", "properties": {
         "to": {"type": "string", "description": "stream slug, 'hq', or '#channel'"},
         "text": {"type": "string"},
         "kind": {"type": "string", "enum": list(MSG_KINDS)},
         "sev": {"type": "string", "enum": ["", "high"]},
         "reply_to": {"type": "string"},
         "expect_reply": {"type": "boolean"},
         "wait_seconds": {"type": "number",
                          "description": "block up to N seconds for a reply"},
     }, "required": ["to", "text"]}},
    {"name": "ws_inbox",
     "description": "Read this session's ws mailbox (marks read). "
                    "Pass stream to read another mailbox, e.g. 'hq'.",
     "inputSchema": {"type": "object", "properties": {
         "stream": {"type": "string"},
         "peek": {"type": "boolean", "description": "list without marking read"},
     }}},
    {"name": "ws_log",
     "description": "Append a dated milestone/decision note to a stream's log.",
     "inputSchema": {"type": "object", "properties": {
         "text": {"type": "string"}, "stream": {"type": "string"},
     }, "required": ["text"]}},
    {"name": "ws_update",
     "description": "Update stream state: status (active|blocked|review|"
                    "parked|done), next step, and/or a log note.",
     "inputSchema": {"type": "object", "properties": {
         "stream": {"type": "string"}, "status": {"type": "string"},
         "next": {"type": "string"}, "note": {"type": "string"},
     }}},
]


def _capture_stdout(fn, ns) -> str:
    import io
    buf = io.StringIO()
    old = sys.stdout
    sys.stdout = buf
    try:
        fn(ns)
    finally:
        sys.stdout = old
    return buf.getvalue().strip()


def mcp_banner(slug: str | None) -> str:
    if not slug:
        return ""
    n = len(unread_messages(slug))
    owed = len(pending_replies(slug))
    chan = has_channel_pending(slug)
    if not n and not owed and not chan:
        return ""
    bits = []
    if n or chan:
        bits.append(f"{n} unread" + (" + channel activity" if chan else ""))
    if owed:
        bits.append(f"{owed} reply(ies) owed")
    return f"\n\n📬 ws: {', '.join(bits)} for `{slug}` — call ws_inbox now."


def mcp_call(name: str, a: dict, mailbox: str | None) -> str:
    if name == "ws_status":
        rows = collect_status(refresh_pr=False)
        keep = ("slug", "title", "status", "kind", "tasks", "pr", "pane",
                "age", "stale", "unread", "next", "needs_you", "needs_why",
                "channels")
        return json.dumps([{k: r[k] for k in keep} for r in rows], indent=1)
    if name == "ws_brief":
        return _capture_stdout(cmd_brief, argparse.Namespace(no_gh=True))
    if name == "ws_send":
        wait = a.get("wait_seconds")
        # The MCP mailbox identity is inferred (cwd), not explicit: a
        # self-send falls back to $USER just like the CLI's inferred sender.
        ns = argparse.Namespace(
            slug=a["to"], text=a["text"],
            sender=mailbox if a["to"] != mailbox else None,
            kind=a.get("kind") or None, sev=a.get("sev") or None,
            reply_to=a.get("reply_to") or None,
            expect_reply=bool(a.get("expect_reply")),
            wait=min(int(wait), 240) if wait else None,
            no_wake=False, revive=False)
        return _capture_stdout(cmd_msg, ns)
    if name == "ws_inbox":
        ns = argparse.Namespace(stream=a.get("stream") or mailbox,
                                inbox_cmd=None if a.get("peek") else "read")
        return _capture_stdout(cmd_inbox, ns)
    if name == "ws_log":
        return _capture_stdout(cmd_log, argparse.Namespace(
            slug=a.get("stream"), text=a["text"]))
    if name == "ws_update":
        return _capture_stdout(cmd_update, argparse.Namespace(
            slug=a.get("stream"), status=a.get("status"),
            next=a.get("next"), note=a.get("note"),
            title=None, doc=None, pr=None))
    raise UserError(f"Unknown tool `{name}`.")


def cmd_mcp(args) -> int:
    """Newline-delimited JSON-RPC over stdio. The mailbox identity is fixed
    at startup from the server's cwd (harnesses spawn MCP servers in the
    project directory)."""
    try:
        mailbox = hook_mailbox_for(os.getcwd())
    except Exception:
        mailbox = None

    def respond(rid, result=None, error=None):
        msg: dict = {"jsonrpc": "2.0", "id": rid}
        if error is not None:
            msg["error"] = error
        else:
            msg["result"] = result
        sys.stdout.write(json.dumps(msg) + "\n")
        sys.stdout.flush()

    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            req = json.loads(line)
        except json.JSONDecodeError:
            continue
        method, rid = req.get("method", ""), req.get("id")
        if method.startswith("notifications/"):
            continue
        if method == "initialize":
            ver = (req.get("params") or {}).get("protocolVersion") or "2025-06-18"
            respond(rid, {"protocolVersion": ver,
                          "capabilities": {"tools": {}},
                          "serverInfo": {"name": "ws", "version": WS_VERSION}})
        elif method == "ping":
            respond(rid, {})
        elif method == "tools/list":
            respond(rid, {"tools": MCP_TOOLS})
        elif method == "tools/call":
            params = req.get("params") or {}
            name = params.get("name", "")
            try:
                out = mcp_call(name, params.get("arguments") or {}, mailbox)
                if name != "ws_inbox":  # inbox output IS the mail
                    out += mcp_banner(mailbox)
                respond(rid, {"content": [{"type": "text", "text": out or "ok"}],
                              "isError": False})
            except UserError as e:
                respond(rid, {"content": [{"type": "text", "text": f"ws: {e}"}],
                              "isError": True})
            except Exception as e:
                respond(rid, {"content": [{"type": "text",
                                           "text": f"ws internal error: {type(e).__name__}: {e}"}],
                              "isError": True})
        elif rid is not None:
            respond(rid, error={"code": -32601, "message": f"method not found: {method}"})
    return 0


# ---------------------------------------------------------------------------
# watchdog + doctor — one cron-able caretaker, no daemons. The failure mode of
# every mailbox system is silent wake-channel rot; these two commands notice.
# ---------------------------------------------------------------------------

def flag_once(slug: str) -> bool:
    """True at most once per 24h per stream — rate-limits watchdog noise."""
    meta = load_meta(slug)
    last = parse_iso(meta.get("flagged", ""))
    if last and (datetime.now(timezone.utc) - last.astimezone(timezone.utc)
                 ).total_seconds() < 24 * 3600:
        return False
    update_meta(slug, {"flagged": now_iso()}, touch=False)
    return True


def escalate_once(slug: str, text: str) -> bool:
    """Send hq a watchdog escalation for `slug` at most once per 24h."""
    if not flag_once(slug):
        return False
    write_message(HQ, text, sender="watchdog", kind="question", sev="high")
    return True


def cmd_watchdog(args) -> int:
    if args.install:
        me = shutil.which("ws") or str(Path(__file__).resolve())
        print("Add to crontab (crontab -e) — every 15 minutes:")
        print(f"  */15 * * * * WS_ROOT={WS_ROOT} {me} watchdog "
              f"{'--revive ' if args.revive else ''}--quiet")
        return 0
    acted, checked = [], 0
    for slug in all_slugs():
        meta = load_meta(slug)
        if meta.get("kind") != "agent" or \
                meta.get("status") not in ("active", "blocked", "review"):
            continue
        checked += 1
        mail = bool(unread_messages(slug)) or has_channel_pending(slug)
        owed = bool(pending_replies(slug))
        pane, _ = ensure_pane(slug, meta)
        state = pane_state(pane) if pane else "dead"
        if (mail or owed) and state == "idle":
            if wake_pane(pane, "ws watchdog: you have unread mail / owed "
                               "replies — run: ws inbox read"):
                acted.append(f"{slug}: nudged idle pane")
        elif (mail or owed) and state == "dead":
            if args.revive:
                try:
                    sess, _p, note = materialize_session(slug, meta)
                    acted.append(f"{slug}: {'found' if note == 'exists' else 'revived'} "
                                 f"session {sess} (mail waiting)")
                except UserError as e:
                    if escalate_once(slug, f"watchdog: `{slug}` has waiting mail, "
                                           f"its session is dead, and revive failed: {e}"):
                        acted.append(f"{slug}: revive failed — escalated to hq")
            else:
                if escalate_once(slug, f"watchdog: `{slug}` has waiting mail but its "
                                       f"session is dead. `ws resume {slug}` or reply "
                                       f"on its behalf."):
                    acted.append(f"{slug}: escalated to hq (dead + mail)")
        elif is_stale(meta) and state in ("dead", "idle"):
            # Staleness already shows on every dashboard (⚠ STALE + ✋ on the
            # stream itself) — mailing hq about it just piles up duplicate mail.
            if flag_once(slug):
                acted.append(f"{slug}: stale (pane {state}) — flagged, no mail")
    if acted:
        for a in acted:
            print(f"- {a}")
        render_html_safe()
    if not args.quiet or acted:
        print(f"watchdog: {checked} stream(s) checked, {len(acted)} action(s).")
    return 0


def cmd_up(args) -> int:
    """Boot recovery: bring every in-flight agent stream's session back up."""
    if args.install:
        me = shutil.which("ws") or str(Path(__file__).resolve())
        print("Add to crontab (crontab -e) — restart in-flight streams at boot:")
        print(f"  @reboot sleep 45 && WS_ROOT={WS_ROOT} {me} up --quiet")
        return 0
    slugs = args.slugs or all_slugs()
    started, running, skipped, failed = [], [], [], []
    for slug in slugs:
        try:
            meta = load_meta(slug)
        except FileNotFoundError:
            failed.append((slug, "no such stream"))
            continue
        if meta.get("kind") != "agent" or \
                meta.get("status") not in ("active", "blocked", "review"):
            skipped.append(slug)
            continue
        pane, _ = ensure_pane(slug, meta)
        if pane and pane_state(pane) != "dead":
            running.append(slug)
            continue
        if args.dry_run:
            started.append((slug, f"ws-{slug} (dry-run)"))
            continue
        try:
            sess, _p, note = materialize_session(slug, meta)
            if note == "exists":
                running.append(slug)
            else:
                started.append((slug, sess))
        except UserError as e:
            failed.append((slug, str(e)))
    for slug, sess in started:
        print(f"- {slug}: {'would start' if args.dry_run else 'started'} {sess}")
    for slug, why in failed:
        print(f"- {slug}: FAILED — {why}")
    if not args.quiet or started or failed:
        print(f"up: {len(started)} started, {len(running)} already running, "
              f"{len(skipped)} skipped (manual/parked/done), {len(failed)} failed.")
    if started and not args.dry_run:
        render_html_safe()
    return 1 if failed else 0


SERVE_DEFAULT_LISTEN = "127.0.0.1:8791"


def serve_token_path() -> Path:
    d = Path.home() / ".local/state/ws"
    d.mkdir(parents=True, exist_ok=True)
    return d / "serve-token"


def load_serve_token() -> str:
    import secrets
    p = serve_token_path()
    if p.is_file() and p.read_text().strip():
        return p.read_text().strip()
    t = secrets.token_hex(16)
    p.write_text(t + "\n")
    p.chmod(0o600)
    return t


def vault_digest() -> str:
    """Cheap change signal for SSE: newest mtime + count of vault files."""
    latest, n = 0.0, 0
    for root, dirs, files in os.walk(WS_ROOT):
        dirs[:] = [d for d in dirs if d != ".git"]
        for f in files:
            if f.endswith(".md") or f == ".chan-pending" or f == "todos.md":
                try:
                    latest = max(latest, os.stat(os.path.join(root, f)).st_mtime)
                    n += 1
                except OSError:
                    pass
    return f"{n}:{latest:.2f}"


def msg_struct(p: Path) -> dict:
    meta, body = parse_doc(p.read_text())
    return {"id": meta.get("id", p.stem), "from": meta.get("from", "?"),
            "kind": meta.get("kind", "fyi"), "sev": meta.get("sev", ""),
            "created": meta.get("created", ""),
            "expect_reply": meta.get("expect_reply") == "true",
            "body": body.strip()}


def mark_read(slug: str, mid: str) -> bool:
    d = inbox_dir(slug)
    p = d / f"{mid}.md"
    if not p.is_file():
        return False
    (d / "read").mkdir(exist_ok=True)
    p.rename(d / "read" / p.name)
    return True


def serve_state(refresh_pr: bool = False) -> dict:
    rows = collect_status(refresh_pr=refresh_pr)
    doc_order = {"VISION.md": 0, "DOC.md": 1, "LOG.md": 2}
    for r in rows:
        slug = r["slug"]
        r["tasks_list"] = load_tasks(slug)
        r["unread_msgs"] = [msg_struct(p) for p in unread_messages(slug)[:8]]
        r["owed"] = len(pending_replies(slug))
        r["docs"] = sorted(
            (p.name for p in stream_dir(slug).glob("*.md") if p.name != "STREAM.md"),
            key=lambda n: (doc_order.get(n, 9), n))
    return {"generated": now_iso(),
            "hq": [msg_struct(p) for p in unread_messages(HQ)],
            "todos": TODOS.read_text() if TODOS.is_file() else "",
            "channels": [{"name": n, "subs": channel_subscribers(n)}
                         for n in all_channels()],
            "streams": rows}


def serve_action(a: dict) -> dict:
    """Web actions go through the same functions the CLI uses — the CLI stays
    the only writer of structured state; this is just another caller."""
    act = a.get("action", "")

    def s(k):
        return str(a.get(k, "") or "").strip()

    if act == "msg":
        to, text = s("to"), s("text")
        if not text:
            raise UserError("Empty message.")
        chan = parse_channel_target(to)
        if chan is not None:
            mid = post_channel(chan, text, HQ)
            woke = [sub for sub in channel_subscribers(chan) if sub != HQ and
                    nudge_stream(sub, f"New message in ws channel #{chan} — "
                                      f"run: ws inbox read") in ("idle", "busy", "alive")]
            return {"ok": True, "note": f"posted to #{chan} [{mid}], nudged {len(woke)}"}
        to = require_mailbox(to)
        if to == HQ:
            raise UserError("That's your own mailbox.")
        kind = s("kind") or ("reply" if s("reply_to") else "fyi")
        if kind not in MSG_KINDS:
            raise UserError(f"Invalid kind `{kind}`.")
        mid = write_message(to, text, HQ, kind=kind,
                            sev="high" if s("sev") == "high" else "",
                            reply_to=s("reply_to"),
                            expect_reply=bool(a.get("expect_reply")))
        if s("reply_to"):
            mark_read(HQ, s("reply_to"))
        out = nudge_stream(to, "You have a new ws inbox message — run: ws inbox read")
        if out in ("dead", "none") and a.get("revive"):
            try:
                sess, _p, note = materialize_session(to, load_meta(to))
                out = "already running" if note == "exists" else f"revived {sess}"
            except UserError as e:
                out = f"dead (revive failed: {e})"
        return {"ok": True, "note": f"[{mid}] queued for {to}; wake: {out}"}

    if act == "keys":
        # Interactive attach: type into the stream's real pane. Literal text
        # via -l; named keys only from a whitelist.
        slug = require_mailbox(s("slug"))
        meta = load_meta(slug)
        pane, _n = ensure_pane(slug, meta)
        if not pane or pane_state(pane) == "dead":
            raise UserError(f"`{slug}` has no live pane — revive it first.")
        keymap = {"Enter": "Enter", "Escape": "Escape", "Tab": "Tab",
                  "BSpace": "BSpace", "Up": "Up", "Down": "Down",
                  "Left": "Left", "Right": "Right", "PageUp": "PageUp",
                  "PageDown": "PageDown", "C-c": "C-c", "C-d": "C-d"}
        if s("key"):
            if s("key") not in keymap:
                raise UserError(f"Key `{s('key')}` not allowed.")
            r = tmux("send-keys", "-t", pane, keymap[s("key")])
        elif a.get("text"):
            r = tmux("send-keys", "-t", pane, "-l", str(a["text"]))
            if a.get("enter"):
                tmux("send-keys", "-t", pane, "Enter")
        else:
            raise UserError("Nothing to send.")
        if not r or r.returncode != 0:
            raise UserError("send-keys failed — pane may have just died.")
        return {"ok": True, "note": "sent"}

    if act == "mark_read":
        if not mark_read(HQ, s("id")):
            raise UserError(f"No unread hq message {s('id')}.")
        return {"ok": True, "note": "marked read"}

    if act == "nudge":
        slug = require_mailbox(s("slug"))
        return {"ok": True, "note": f"wake: {nudge_stream(slug, 'HQ pinged you — run: ws inbox, ws status, and carry on')}"}

    if act == "revive":
        slug = require_mailbox(s("slug"))
        sess, _p, note = materialize_session(slug, load_meta(slug))
        return {"ok": True,
                "note": f"session {sess} {'already running' if note == 'exists' else 'started'}"}

    if act == "task_done":
        slug = require_mailbox(s("slug"))
        path = find_task(slug, s("id"))
        meta, body = parse_doc(path.read_text())
        meta["status"], meta["updated"] = "done", now_iso()
        atomic_write(path, serialize_doc(meta, body, TASK_FM_KEYS))
        update_meta(slug, {})
        return {"ok": True, "note": f"{s('id')} done"}

    if act == "log":
        slug = require_mailbox(s("slug"))
        if not s("text"):
            raise UserError("Empty log entry.")
        append_log(slug, s("text"))
        return {"ok": True, "note": f"logged to {slug}"}

    if act == "update":
        slug = require_mailbox(s("slug"))
        updates = {}
        if s("status"):
            if s("status") not in STREAM_STATUSES:
                raise UserError(f"Invalid status `{s('status')}`.")
            updates["status"] = s("status")
        if s("next"):
            updates["next"] = s("next")
        if not updates:
            raise UserError("Nothing to update.")
        update_meta(slug, updates)
        return {"ok": True, "note": f"{slug} updated"}

    if act == "todo_toggle":
        raw = str(a.get("line", ""))
        if not raw.strip() or not TODOS.is_file():
            raise UserError("No such to-do.")
        lines = TODOS.read_text().split("\n")
        for i, line in enumerate(lines):
            if line == raw:
                if "[ ]" in line:
                    lines[i] = line.replace("[ ]", "[x]", 1)
                elif "[x]" in line.lower():
                    lines[i] = line.replace("[x]", "[ ]", 1).replace("[X]", "[ ]", 1)
                else:
                    raise UserError("That line is not a checkbox to-do.")
                atomic_write(TODOS, "\n".join(lines))
                return {"ok": True, "note": "to-do toggled"}
        raise UserError("To-do not found — it changed on disk; refresh.")

    if act == "sync":
        def run(*cmd):
            return subprocess.run(cmd, cwd=WS_ROOT, capture_output=True,
                                  text=True, timeout=60)
        run("git", "add", "-A")
        c = run("git", "commit", "-m", f"ws sync {now_iso()}")
        p = run("git", "push")
        committed = "committed" if c.returncode == 0 else "nothing to commit"
        pushed = "pushed" if p.returncode == 0 else "push failed"
        return {"ok": True, "note": f"{committed}, {pushed}"}

    raise UserError(f"Unknown action `{act}`.")


def ws_read_frame(rfile):
    """One RFC6455 frame → (opcode, payload) or None on EOF/close."""
    hdr = rfile.read(2)
    if len(hdr) < 2:
        return None
    opcode, b2 = hdr[0] & 0x0F, hdr[1]
    ln = b2 & 0x7F
    if ln == 126:
        ln = int.from_bytes(rfile.read(2), "big")
    elif ln == 127:
        ln = int.from_bytes(rfile.read(8), "big")
    mask = rfile.read(4) if b2 & 0x80 else b""
    data = rfile.read(ln) if ln else b""
    if mask and data:
        data = bytes(c ^ mask[i % 4] for i, c in enumerate(data))
    return opcode, data


def ws_write_frame(wfile, lock, payload: bytes, opcode: int = 2) -> None:
    ln = len(payload)
    if ln < 126:
        hdr = bytes([0x80 | opcode, ln])
    elif ln < 65536:
        hdr = bytes([0x80 | opcode, 126]) + ln.to_bytes(2, "big")
    else:
        hdr = bytes([0x80 | opcode, 127]) + ln.to_bytes(8, "big")
    with lock:
        wfile.write(hdr + payload)
        wfile.flush()


def serve_term_bridge(handler, slug: str) -> None:
    """WebSocket ⇄ PTY running `tmux attach` — a real tmux client in the
    browser. Auth already checked by the caller."""
    import base64
    import hashlib
    import pty as pty_mod
    import signal
    import socket as socket_mod
    import struct
    import termios
    import threading

    def refuse(code: int, msg: str) -> None:
        handler.send_response(code)
        handler.send_header("Content-Type", "text/plain")
        handler.send_header("Content-Length", str(len(msg)))
        handler.end_headers()
        handler.wfile.write(msg.encode())

    if not stream_exists(slug):
        return refuse(404, "no such stream")
    pane, _n = ensure_pane(slug, load_meta(slug))
    if not pane or pane_state(pane) == "dead":
        return refuse(409, "no live pane — revive the stream first")
    r = tmux("display-message", "-p", "-t", pane, "#{session_name}")
    sess = r.stdout.strip() if r and r.returncode == 0 else ""
    if not sess:
        return refuse(409, "cannot resolve tmux session")
    key = handler.headers.get("Sec-WebSocket-Key", "")
    if not key or handler.headers.get("Upgrade", "").lower() != "websocket":
        return refuse(400, "websocket upgrade required")

    accept = base64.b64encode(hashlib.sha1(
        (key + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11").encode()).digest()).decode()
    handler.send_response(101)
    handler.send_header("Upgrade", "websocket")
    handler.send_header("Connection", "Upgrade")
    handler.send_header("Sec-WebSocket-Accept", accept)
    handler.end_headers()
    handler.connection.settimeout(None)

    pid, fd = pty_mod.fork()
    if pid == 0:  # child: become a real tmux client
        os.environ["TERM"] = "xterm-256color"
        try:
            os.execvp("tmux", ["tmux", "attach-session", "-t", sess])
        finally:
            os._exit(1)

    wlock = threading.Lock()
    stop = threading.Event()

    def pump():  # pty → browser
        try:
            while not stop.is_set():
                data = os.read(fd, 65536)
                if not data:
                    break
                ws_write_frame(handler.wfile, wlock, data, opcode=2)
        except OSError:
            pass
        finally:
            stop.set()
            try:
                handler.connection.shutdown(socket_mod.SHUT_RDWR)
            except OSError:
                pass

    threading.Thread(target=pump, daemon=True).start()
    try:
        while not stop.is_set():
            fr = ws_read_frame(handler.rfile)
            if fr is None:
                break
            op, data = fr
            if op == 8:  # close
                break
            if op == 9:  # ping → pong
                ws_write_frame(handler.wfile, wlock, data, opcode=10)
                continue
            if op in (1, 2) and data:
                try:
                    m = json.loads(data)
                except ValueError:
                    continue
                if m.get("t") == "i":
                    os.write(fd, str(m.get("d", "")).encode())
                elif m.get("t") == "r":
                    rows = max(4, min(500, int(m.get("rows", 24))))
                    cols = max(10, min(1000, int(m.get("cols", 80))))
                    fcntl.ioctl(fd, termios.TIOCSWINSZ,
                                struct.pack("HHHH", rows, cols, 0, 0))
                    os.kill(pid, signal.SIGWINCH)
    except (OSError, ValueError):
        pass
    finally:
        stop.set()
        try:
            os.close(fd)
        except OSError:
            pass
        try:
            os.kill(pid, signal.SIGHUP)
            os.waitpid(pid, 0)
        except (OSError, ChildProcessError):
            pass
        handler.close_connection = True


def cmd_serve(args) -> int:
    import hmac as hmac_mod
    import http.server
    import urllib.parse

    listen = args.listen or SERVE_DEFAULT_LISTEN
    host, _, port_s = listen.partition(":")
    port = int(port_s or "8791")
    token = args.token or load_serve_token()

    if args.install:
        me = shutil.which("ws") or str(Path(__file__).resolve())
        unit = Path.home() / ".config/systemd/user/ws-serve.service"
        unit.parent.mkdir(parents=True, exist_ok=True)
        unit.write_text(f"""[Unit]
Description=ws work-streams live web UI (loopback + token)

[Service]
Environment=WS_ROOT={WS_ROOT}
ExecStart={me} serve --listen {listen}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
""")
        print(f"Wrote {unit}")
        print("Enable:  systemctl --user daemon-reload && "
              "systemctl --user enable --now ws-serve")
        print(f"URL:     http://{listen}/?token={token}")
        print(f"Phone:   tailscale serve --bg http://127.0.0.1:{port}  "
              "(HTTPS on your tailnet)")
        return 0

    tmpl_path = TEMPLATES / "serve.html"
    if not tmpl_path.is_file():
        raise UserError(f"Missing template {tmpl_path}.")
    tmpl = tmpl_path.read_text()

    vendor_dir = TEMPLATES / "vendor"
    vendor_cache: dict[str, bytes] = {}

    class Handler(http.server.BaseHTTPRequestHandler):
        server_version = f"ws/{WS_VERSION}"
        protocol_version = "HTTP/1.1"

        def log_message(self, *_a):
            pass

        def _authed(self) -> bool:
            u = urllib.parse.urlparse(self.path)
            cand = ""
            auth = self.headers.get("Authorization", "")
            if auth.startswith("Bearer "):
                cand = auth[7:].strip()
            if not cand:
                qs = urllib.parse.parse_qs(u.query)
                cand = (qs.get("token") or [""])[0]
            if not cand:
                m = re.search(r"(?:^|;\s*)ws_token=([^;\s]+)",
                              self.headers.get("Cookie", ""))
                cand = m.group(1) if m else ""
            return bool(cand) and hmac_mod.compare_digest(cand, token)

        def _send(self, code: int, body, ctype="application/json", extra=None):
            data = body if isinstance(body, bytes) else body.encode()
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(data)))
            self.send_header("Cache-Control", "no-store")
            for k, v in (extra or {}).items():
                self.send_header(k, v)
            self.end_headers()
            try:
                self.wfile.write(data)
            except (BrokenPipeError, ConnectionResetError):
                pass

        def do_GET(self):
            u = urllib.parse.urlparse(self.path)
            if u.path.startswith("/vendor/"):
                # Static vendored libs (xterm, marked): no vault data, no auth —
                # subresource loads can't rely on the cookie being set yet.
                name = u.path[len("/vendor/"):]
                if "/" in name or name.startswith(".") or (
                        name not in vendor_cache
                        and not (vendor_dir / name).is_file()):
                    self._send(404, '{"error": "not found"}')
                    return
                if name not in vendor_cache:
                    vendor_cache[name] = (vendor_dir / name).read_bytes()
                ctype = ("text/css" if name.endswith(".css")
                         else "application/javascript")
                self._send(200, vendor_cache[name], ctype,
                           {"Cache-Control": "max-age=86400"})
                return
            if not self._authed():
                self._send(401, "ws serve: missing/bad token — open the URL "
                                "printed by `ws serve` (it carries ?token=…).",
                           "text/plain; charset=utf-8")
                return
            if u.path == "/":
                self._send(200, tmpl, "text/html; charset=utf-8",
                           {"Set-Cookie": f"ws_token={token}; Path=/; "
                                          f"HttpOnly; SameSite=Strict"})
            elif u.path.startswith("/ws/term/"):
                serve_term_bridge(self, urllib.parse.unquote(
                    u.path[len("/ws/term/"):]))
            elif u.path.startswith("/doc/"):
                parts = u.path[len("/doc/"):].split("/")
                slug = urllib.parse.unquote(parts[0]) if parts else ""
                name = urllib.parse.unquote(parts[1]) if len(parts) == 2 else ""
                if (not stream_exists(slug) or "/" in name or ".." in name
                        or not name.endswith(".md")
                        or not (stream_dir(slug) / name).is_file()):
                    self._send(404, '{"error": "not found"}')
                    return
                raw = (stream_dir(slug) / name).read_text()
                if (vendor_dir / "marked.js").is_file():
                    md_json = json.dumps(raw).replace("</", "<\\/")
                    body = (f"<div id='md'></div>"
                            f"<script src='/vendor/marked.js'></script>"
                            f"<script>document.getElementById('md').innerHTML="
                            f"marked.parse({md_json},{{gfm:true}});</script>")
                else:  # fallback: stdlib mini-renderer
                    body = md_to_html_body(raw)
                page = (
                    "<!DOCTYPE html><html lang=\"en\"><head><meta charset=\"utf-8\">"
                    "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">"
                    f"<title>{html_mod.escape(slug)} — {html_mod.escape(name)}</title>"
                    f"<style>{DOC_PAGE_CSS}{DOC_EXTRA_CSS}</style></head><body>"
                    f"<div class='docmeta'>{html_mod.escape(slug)} / "
                    f"{html_mod.escape(name)} · rendered live</div>"
                    f"{body}</body></html>")
                self._send(200, page, "text/html; charset=utf-8",
                           {"Set-Cookie": f"ws_token={token}; Path=/; "
                                          f"HttpOnly; SameSite=Strict"})
            elif u.path == "/api/state":
                self._send(200, json.dumps(
                    serve_state(refresh_pr="gh=1" in (u.query or "")), default=str))
            elif u.path.startswith("/api/pane/"):
                slug = urllib.parse.unquote(u.path[len("/api/pane/"):])
                if not stream_exists(slug):
                    self._send(404, '{"error": "no such stream"}')
                    return
                pane, _n = ensure_pane(slug, load_meta(slug))
                state = pane_state(pane) if pane else "dead"
                text = ""
                if pane and state != "dead":
                    r = tmux("capture-pane", "-p", "-t", pane, "-S", "-120")
                    if r and r.returncode == 0:
                        text = r.stdout.rstrip()
                self._send(200, json.dumps({"state": state, "text": text}))
            elif u.path == "/api/events":
                self.send_response(200)
                self.send_header("Content-Type", "text/event-stream")
                self.send_header("Cache-Control", "no-store")
                self.send_header("Connection", "close")
                self.end_headers()
                self.close_connection = True
                last = ""
                try:
                    while True:
                        d = vault_digest()
                        payload = (f"data: {d}\n\n" if d != last else ": ping\n\n")
                        last = d
                        self.wfile.write(payload.encode())
                        self.wfile.flush()
                        time.sleep(2)
                except (BrokenPipeError, ConnectionResetError, OSError):
                    return
            else:
                self._send(404, '{"error": "not found"}')

        def do_POST(self):
            if not self._authed():
                self._send(401, '{"error": "unauthorized"}')
                return
            if urllib.parse.urlparse(self.path).path != "/api/action":
                self._send(404, '{"error": "not found"}')
                return
            try:
                n = int(self.headers.get("Content-Length", "0") or 0)
                payload = json.loads(self.rfile.read(n) or b"{}")
                res = serve_action(payload)
                render_html_safe()
                self._send(200, json.dumps(res))
            except UserError as e:
                self._send(400, json.dumps({"ok": False, "error": str(e)}))
            except Exception as e:  # pragma: no cover — surface, don't die
                self._send(500, json.dumps(
                    {"ok": False, "error": f"{type(e).__name__}: {e}"}))

    class Server(http.server.ThreadingHTTPServer):
        daemon_threads = True

    srv = Server((host, port), Handler)
    print(f"ws serve — http://{host}:{port}/?token={token}")
    print(f"token file: {serve_token_path()} · systemd: ws serve --install")
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass
    return 0


def cmd_doctor(args) -> int:
    issues = []
    # Zombie sessions: a pane whose cwd was deleted from under it (removed
    # worktree). Shells there fail with getcwd errors on attach/resume.
    r = tmux("list-panes", "-a", "-F", "#{session_name}\t#{pane_current_path}")
    if r and r.returncode == 0:
        flagged = set()
        for line in r.stdout.splitlines():
            sess, _, path = line.partition("\t")
            path = path.replace(" (deleted)", "").strip()
            if path and sess not in flagged and not Path(path).is_dir():
                flagged.add(sess)
                issues.append(f"tmux session `{sess}`: its directory {path} no "
                              f"longer exists (deleted worktree?) — "
                              f"`tmux kill-session -t {sess}` unless you need it")
    slugs = all_slugs()
    for slug in slugs:
        meta = load_meta(slug)
        live = meta.get("status") in ("active", "blocked", "review")
        if live and meta.get("kind") == "agent":
            wt = meta.get("worktree", "")
            if wt and not Path(wt).is_dir():
                issues.append(f"{slug}: recorded worktree {wt} no longer exists "
                              f"— re-register from the new location, or "
                              f"`ws done/update --status parked` if finished")
        pane = meta.get("tmux_pane", "")
        if live and meta.get("kind") == "agent" and pane and not pane_alive(pane):
            found, _ = discover_pane(meta.get("worktree", ""), meta.get("harness", ""))
            if not found:
                issues.append(f"{slug}: recorded pane {pane} is dead, no live "
                              f"replacement — `ws resume {slug}` (wake-channel rot)")
        n = len(unread_messages(slug))
        if n and (not pane or not pane_alive(pane)):
            oldest = min(unread_messages(slug))
            issues.append(f"{slug}: {n} unread message(s) with no live session "
                          f"(oldest {oldest.stem}) — delivery is starved")
        for p in pending_replies(slug):
            m, _ = parse_doc(p.read_text())
            dt = parse_iso(m.get("created", ""))
            if dt and (datetime.now(timezone.utc) - dt.astimezone(timezone.utc)
                       ).total_seconds() > 24 * 3600:
                issues.append(f"{slug}: owes `{m.get('from')}` a reply for >24h "
                              f"[{p.stem}]")
        cursors = get_cursors(meta)
        for name in subscribed_channels(meta):
            if not channel_file(name).is_file():
                issues.append(f"{slug}: subscribes to missing channel #{name} — "
                              f"`ws chan leave {name} --stream {slug}`")
            elif cursors.get(name, 0) > len(channel_file(name).read_text()):
                issues.append(f"{slug}: #{name} cursor is past end-of-file "
                              f"(channel rewritten?) — will self-heal to 0 on "
                              f"next delivery")
    if INBOX.is_dir():
        for d in INBOX.iterdir():
            if d.is_dir() and d.name != HQ and d.name not in slugs:
                issues.append(f"inbox/{d.name}: mailbox for unknown stream "
                              f"({len(list(d.glob('*.md')))} unread) — stale dir?")
    r = tmux("list-sessions", "-F", "#{session_name}")
    if r and r.returncode == 0:
        for sess in r.stdout.splitlines():
            if sess.startswith("ws-") and not session_has_harness(sess):
                issues.append(f"tmux `{sess}`: ws session with no harness running "
                              f"— orphaned; `tmux kill-session -t {sess}`")
    if issues:
        print(f"ws doctor — {len(issues)} issue(s):")
        for i in issues:
            print(f"  ✗ {i}")
        return 1
    print("ws doctor — all clear: panes honest, mail flowing, no orphans.")
    return 0


# ---------------------------------------------------------------------------
# help
# ---------------------------------------------------------------------------

HELP = """ws — work-stream registry for humans and coding agents

Data root: $WS_ROOT (default ~/streams). Streams live in streams/<slug>/
(STREAM.md state + VISION.md why + LOG.md history + tasks/), messages in
inbox/<slug>/, loose to-dos in todos.md, dashboard in index.html.

WHEN TO REGISTER  Register a stream when the work will outlive this session
or span multiple PRs. Skip registration for quick one-offs.

EVERYDAY COMMANDS (slug inferred from cwd inside a registered worktree)
  ws register [slug]            Register/refresh the current directory as a
                                stream (captures worktree, branch, session,
                                tmux pane). Idempotent. Then write VISION.md.
  ws log "text"                 Append a dated progress/decision note (use -
                                to read stdin for multi-line).
  ws update --status S --next "..." --note "..."
                                Update state. Statuses: active blocked review
                                parked done. --note also logs.
  ws task add "title"           Add a milestone task (ids t1, t2, ...).
  ws task list                  List tasks.
  ws task done t2               Complete a task.
  ws task update t3 --status blocked --owner name --note "..."
  ws inbox [read]               List unread messages / read + mark read.
  ws doc [--open]               Scaffold/set the stream's working doc (DOC.md)
                                — the living deep-dive linked from the
                                dashboard; --open renders + opens it.
  ws pr add <#num|url> [slug]   Track a PR on the stream (dedupes; run it when
                                you open a PR). `ws update --pr` is an alias.
  ws pr rm <#num> / ws pr list  Untrack / list with live state+CI via gh.
                                Open PRs on the worktree branch are also
                                auto-captured at register/update time.
  ws prs [--all|--md|--json]    Every PR across in-flight streams with live
                                state+CI+title (merged/closed hidden unless
                                --all; --md prints a pasteable checklist).

COORDINATION
  ws msg <to> "text"            Message a stream, `hq` (the human's mailbox),
                                or a `#channel`. Queues in the inbox and nudges
                                the tmux pane if alive; --revive restarts a
                                dead session so the message lands on boot.
                                Envelope: --kind fyi|question|decision|review|
                                reply, --sev high, --reply-to <id>. Ask-and-
                                wait: --expect-reply (recipient can't idle
                                until it answers) and --wait [secs] (block for
                                the reply). --no-wake / --from as before.
  ws inbox [read] [--stream S]  List/read a mailbox (read marks read and shows
                                channel activity + replies you owe). Agents:
                                reply with ws msg <sender> --reply-to <id>.
  ws chan list|join|leave|history <name>
                                Channels: append-only logs any stream can
                                subscribe to (frontmatter `channels:`); posts
                                fan in via the same hook delivery. Joining
                                subscribes to NEW traffic only.
  ws status [--json|--all|--no-gh]   Table of every stream: status, tasks,
                                PR (live via gh), pane state (dead/idle/busy —
                                idle means a wake nudge reaches it immediately),
                                staleness.
  ws admin [--model M] [--prompt "..."] [--dry-run] [-- extra-claude-args]
                                Launch the HQ manager session (claude with
                                permissions skipped) inside the vault.
  ws brief                      Full dump of everything in flight (todos,
                                streams, visions, tasks, unread, log tails)
                                — feed this to a manager agent.
  ws resume <slug> [--exec|--print] [-- extra-args]
                                Get back into a stream. Live pane -> attach.
                                Otherwise CREATES a detached tmux session
                                (ws-<slug>) in the stream's home (worktree, or
                                the stream dir for manual streams) running the
                                right resume rung (claude --resume/--continue,
                                codex resume --last, fresh), records the pane,
                                and attaches when on a TTY. --print = only
                                show instructions; -- passes extra harness args.
  ws spawn <slug> [--harness claude|codex] [--dir D]
                                Start a harness for a stream in a new tmux
                                session (ws-<slug>).

HOUSEKEEPING
  ws add <slug> --title "..."   Track manual (non-agent) work as a stream.
  ws todo "text"                Append a loose personal to-do.
  ws done <slug>                Mark a stream done.
  ws open                       Open the dashboard (index.html) in a browser.
  ws html                       Regenerate index.html (also runs after every
                                mutation).
  ws init                       Create the data vault at $WS_ROOT (idempotent).
  ws setup                      Wire up this machine: ~/.local/bin/ws launcher,
                                Codex skill link, vault init (idempotent).
  ws sync                       git add/commit/push the registry (best-effort).
  ws mcp                        Run the stdio MCP server: ws_status/ws_brief/
                                ws_send/ws_inbox/ws_log/ws_update tools for
                                any MCP-capable harness; every result carries
                                an unread-mail banner.
  ws watchdog [--revive]        Cron-able caretaker: nudges idle panes with
                                mail, optionally revives dead sessions that
                                have mail waiting, escalates the rest to hq
                                (at most once/24h per stream). --install
                                prints the crontab line.
  ws up [slug…]                 Boot recovery: restart every in-flight agent
                                stream's tmux session (skips manual/parked/
                                done). --dry-run previews; --install prints
                                the @reboot crontab line.
  ws serve                      Live web UI (loopback+token): dashboard with
                                SSE push, read-only terminal tails, and
                                actions (message/nudge/revive/tasks/log/sync)
                                through the same code paths as the CLI.
                                --install writes the systemd user unit.
  ws doctor                     Diagnose wake-channel rot: dead recorded
                                panes, starved mailboxes, overdue replies,
                                orphaned ws-* tmux sessions.
  ws hook <event>               Internal: called by the harness hooks.

MAIL  Every ws command first prints a banner if your stream has unread inbox
mail — on harnesses without hooks (plain Codex), that banner IS delivery:
when you see it, run `ws inbox read` and act on the messages.

CONVENTIONS
  VISION.md = why the stream exists, north star, constraints. Write once at
  registration, update only on direction changes.  DOC.md (via `ws doc`) =
  the living deep-dive of what's in flight and how it fits together — keep it
  current on substantial streams; it renders to HTML on the dashboard.
  LOG.md = dated milestones and decisions, via `ws log` (not turn-by-turn
  narration).  Tasks are stream-level milestones, not an agent's internal
  micro-checklist.  Keep `next` honest: one sentence a fresh agent could act
  on.
"""


def cmd_help(args) -> int:
    print(HELP)
    return 0


# ---------------------------------------------------------------------------
# argparse wiring
# ---------------------------------------------------------------------------

def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="ws", add_help=True,
                                description="Work-stream registry. `ws help` for the full reference.")
    sub = p.add_subparsers(dest="cmd")

    sp = sub.add_parser("register", help="register/refresh cwd as a stream")
    sp.add_argument("slug", nargs="?")
    sp.add_argument("--title")
    sp.add_argument("--session-id", dest="session_id")
    sp.add_argument("--harness", choices=["claude", "codex", "gemini"])
    sp.add_argument("--pane", help=argparse.SUPPRESS)
    sp.add_argument("--doc", help="stream doc path (relative to the stream dir, or absolute)")
    sp.set_defaults(fn=cmd_register)

    sp = sub.add_parser("add", help="add a manual (non-agent) stream")
    sp.add_argument("slug")
    sp.add_argument("--title")
    sp.add_argument("--next")
    sp.set_defaults(fn=cmd_add)

    sp = sub.add_parser("todo", help="append a loose to-do")
    sp.add_argument("text")
    sp.set_defaults(fn=cmd_todo)

    sp = sub.add_parser("update", help="update stream state")
    sp.add_argument("slug", nargs="?")
    sp.add_argument("--status")  # validated in cmd_update for a teaching error
    sp.add_argument("--next")
    sp.add_argument("--note")
    sp.add_argument("--title")
    sp.add_argument("--pr")
    sp.add_argument("--doc", help="stream doc path (relative to the stream dir, or absolute)")
    sp.add_argument("--kind", choices=["agent", "manual"], dest="stream_kind",
                    help="flip between agent-driven and manual")
    sp.add_argument("--worktree", help="re-home the stream (repair a wrong/stale path)")
    sp.add_argument("--session-id", dest="session_id",
                    help="relink the harness session (empty string clears it)")
    sp.add_argument("--pane", help="relink the tmux pane id (empty string clears it)")
    sp.set_defaults(fn=cmd_update)

    sp = sub.add_parser("log", help="append a dated log entry")
    sp.add_argument("slug_or_text", nargs="?")
    sp.add_argument("maybe_text", nargs="?")
    sp.set_defaults(fn=None)  # resolved in main (slug optional + positional text)

    sp = sub.add_parser("task", help="manage stream tasks")
    tsub = sp.add_subparsers(dest="task_cmd")
    t = tsub.add_parser("add")
    t.add_argument("title")
    t.add_argument("--stream")
    t.add_argument("--owner")
    t = tsub.add_parser("list")
    t.add_argument("--stream")
    t = tsub.add_parser("done")
    t.add_argument("id")
    t.add_argument("--stream")
    t = tsub.add_parser("update")
    t.add_argument("id")
    t.add_argument("--stream")
    t.add_argument("--status")
    t.add_argument("--owner")
    t.add_argument("--note")
    t.add_argument("--title", dest="title_new")
    sp.set_defaults(fn=cmd_task)

    sp = sub.add_parser("pr", help="track the stream's PRs")
    prsub = sp.add_subparsers(dest="pr_cmd")
    t = prsub.add_parser("add")
    t.add_argument("ref")
    t.add_argument("slug", nargs="?")
    t = prsub.add_parser("rm")
    t.add_argument("ref")
    t.add_argument("slug", nargs="?")
    t = prsub.add_parser("list")
    t.add_argument("slug", nargs="?")
    sp.set_defaults(fn=cmd_pr)

    sp = sub.add_parser("msg", help="message a stream, hq, or a #channel (+ tmux wake)")
    sp.add_argument("slug", help="stream slug, `hq`, or `#channel`")
    sp.add_argument("text", nargs="?")
    sp.add_argument("--from", dest="sender")
    sp.add_argument("--no-wake", action="store_true")
    sp.add_argument("--kind", choices=list(MSG_KINDS))
    sp.add_argument("--sev", choices=["high"])
    sp.add_argument("--reply-to", dest="reply_to", metavar="MSG_ID")
    sp.add_argument("--expect-reply", dest="expect_reply", action="store_true",
                    help="recipient's Stop hook blocks idling until it replies")
    sp.add_argument("--wait", nargs="?", const=600, type=int, metavar="SECS",
                    help="block until the reply arrives (default 600s)")
    sp.add_argument("--revive", action="store_true",
                    help="if the stream's session is dead, restart it so the "
                         "message is delivered on boot")
    sp.set_defaults(fn=cmd_msg)

    sp = sub.add_parser("inbox", help="list/read this stream's inbox")
    sp.add_argument("inbox_cmd", nargs="?", choices=["read"])
    sp.add_argument("--stream")
    sp.set_defaults(fn=cmd_inbox)

    sp = sub.add_parser("chan", help="channels: list/join/leave/history")
    csub = sp.add_subparsers(dest="chan_cmd")
    t = csub.add_parser("list")
    for name in ("join", "leave"):
        t = csub.add_parser(name)
        t.add_argument("name")
        t.add_argument("--stream")
    t = csub.add_parser("history")
    t.add_argument("name")
    t.add_argument("--tail", type=int, default=0, help="last N lines only")
    sp.set_defaults(fn=cmd_chan)

    sp = sub.add_parser("status", help="table of all streams")
    sp.add_argument("--json", action="store_true")
    sp.add_argument("--all", action="store_true")
    sp.add_argument("--no-gh", action="store_true")
    sp.set_defaults(fn=cmd_status)

    sp = sub.add_parser("prs", help="all PRs across in-flight streams (open by default)")
    sp.add_argument("--all", action="store_true",
                    help="include merged/closed PRs and done streams")
    sp.add_argument("--json", action="store_true")
    sp.add_argument("--md", action="store_true", help="markdown checklist for pasting")
    sp.add_argument("--no-gh", action="store_true",
                    help="skip gh; show last-known states")
    sp.set_defaults(fn=cmd_prs)

    sp = sub.add_parser("brief", help="full dump for agent ingestion")
    sp.add_argument("--no-gh", action="store_true")
    sp.set_defaults(fn=cmd_brief)

    sp = sub.add_parser("resume", help="get back into a stream (creates the session if needed)")
    sp.add_argument("slug")
    sp.add_argument("--exec", dest="exec_", action="store_true")
    sp.add_argument("--print", dest="print_", action="store_true",
                    help="only print how to resume; create/attach nothing")
    sp.add_argument("passthrough", nargs=argparse.REMAINDER,
                    help="extra args appended to the harness command (prefix with --)")
    sp.set_defaults(fn=cmd_resume)

    sp = sub.add_parser("spawn", help="start a harness for a stream in tmux")
    sp.add_argument("slug")
    sp.add_argument("--harness", choices=["claude", "codex", "gemini"], default="claude")
    sp.add_argument("--dir")
    sp.set_defaults(fn=cmd_spawn)

    sp = sub.add_parser("done", help="mark a stream done")
    sp.add_argument("slug")
    sp.set_defaults(fn=cmd_done)

    sp = sub.add_parser("open", help="open the dashboard in a browser")
    sp.set_defaults(fn=cmd_open)

    sp = sub.add_parser("doc", help="scaffold/set/open the stream's working doc")
    sp.add_argument("slug", nargs="?")
    sp.add_argument("--open", action="store_true")
    sp.set_defaults(fn=cmd_doc)

    sp = sub.add_parser("admin", help="launch the HQ manager session in the vault")
    sp.add_argument("--model")
    sp.add_argument("--prompt")
    sp.add_argument("--dry-run", dest="dry_run", action="store_true")
    sp.add_argument("passthrough", nargs=argparse.REMAINDER,
                    help="extra args passed to claude verbatim (prefix with --)")
    sp.set_defaults(fn=cmd_admin)

    sp = sub.add_parser("_classify")  # internal/test: stdin capture -> state
    sp.set_defaults(fn=cmd_classify)

    sp = sub.add_parser("_match")  # internal/test: stdin pane list -> pane
    sp.add_argument("worktree")
    sp.add_argument("--prefer", default="")
    sp.add_argument("--harness-map", dest="harness_map", default="")
    sp.set_defaults(fn=cmd_match)

    sp = sub.add_parser("html", help="regenerate index.html")
    sp.set_defaults(fn=cmd_html)

    sp = sub.add_parser("init", help="create the data vault at $WS_ROOT")
    sp.set_defaults(fn=cmd_init)

    sp = sub.add_parser("setup", help="wire up this machine (launcher, Codex, vault)")
    sp.add_argument("--bin-dir")
    sp.add_argument("--codex-skills-dir")
    sp.add_argument("--skip-init", action="store_true")
    sp.set_defaults(fn=cmd_setup)

    sp = sub.add_parser("sync", help="git add/commit/push the registry")
    sp.set_defaults(fn=cmd_sync)

    sp = sub.add_parser("mcp", help="run the stdio MCP server (harness-agnostic)")
    sp.set_defaults(fn=cmd_mcp)

    sp = sub.add_parser("watchdog", help="cron-able caretaker: nudge/revive/escalate")
    sp.add_argument("--revive", action="store_true",
                    help="restart dead sessions that have waiting mail")
    sp.add_argument("--quiet", action="store_true")
    sp.add_argument("--install", action="store_true",
                    help="print the crontab line to run this every 15 minutes")
    sp.set_defaults(fn=cmd_watchdog)

    sp = sub.add_parser("up", help="boot recovery: restart every in-flight agent stream's session")
    sp.add_argument("slugs", nargs="*", help="specific streams (default: all in flight)")
    sp.add_argument("--dry-run", action="store_true",
                    help="show what would start without starting it")
    sp.add_argument("--quiet", action="store_true")
    sp.add_argument("--install", action="store_true",
                    help="print the @reboot crontab line")
    sp.set_defaults(fn=cmd_up)

    sp = sub.add_parser("serve", help="live web UI: dashboard + terminals + actions (loopback+token)")
    sp.add_argument("--listen", default=None, metavar="HOST:PORT",
                    help=f"bind address (default {SERVE_DEFAULT_LISTEN})")
    sp.add_argument("--token", default=None,
                    help="auth token (default: persisted in ~/.local/state/ws/serve-token)")
    sp.add_argument("--install", action="store_true",
                    help="write the systemd user unit and print enable instructions")
    sp.set_defaults(fn=cmd_serve)

    sp = sub.add_parser("doctor", help="diagnose wake-channel rot and mailbox issues")
    sp.set_defaults(fn=cmd_doctor)

    sp = sub.add_parser("hook", help="internal: harness hook handler")
    sp.add_argument("event", choices=["session-start", "user-prompt-submit",
                                      "post-tool-use", "stop"])
    sp.set_defaults(fn=cmd_hook)

    sp = sub.add_parser("help", help="full reference")
    sp.set_defaults(fn=cmd_help)
    return p


def main(argv: list[str]) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    if not args.cmd:
        parser.print_help()
        return 1
    if args.cmd == "log":
        # `ws log "text"` (slug from cwd) or `ws log <slug> "text"` or `ws log -`
        a, b = args.slug_or_text, args.maybe_text
        if b is not None:
            args.slug, args.text = a, b
        else:
            args.slug, args.text = None, a
        args.fn = cmd_log
    if args.cmd == "task":
        if not getattr(args, "task_cmd", None):
            print("Usage: ws task add|list|done|update … (see `ws help`)", file=sys.stderr)
            return 1
        args.stream = getattr(args, "stream", None)
    # Universal mail banner: any harness that runs ANY ws command learns about
    # unread inbox mail for its stream — the delivery channel for hook-less
    # harnesses. Hooks/inbox/help are exempt (hooks deliver themselves; inbox
    # is the reader; help/init/setup have no stream context).
    if args.cmd not in ("hook", "inbox", "help", "init", "setup", "msg", "admin",
                        "_classify", "_match", "mcp", "serve"):
        try:
            slug = hook_mailbox_for(os.getcwd())
            if slug:
                n = len(unread_messages(slug))
                chan = has_channel_pending(slug) if slug != HQ else False
                owed = len(pending_replies(slug)) if slug != HQ else 0
                bits = []
                if n:
                    bits.append(f"{n} unread message(s)")
                if chan:
                    bits.append("new channel activity")
                if owed:
                    bits.append(f"{owed} owed reply(ies)")
                if bits:
                    print(f"📬 ws: {', '.join(bits)} for `{slug}` — "
                          f"run `ws inbox read` and act on them.")
        except Exception:
            pass
    try:
        return args.fn(args)
    except UserError as e:
        print(f"ws: {e}", file=sys.stderr)
        return 1
    except BrokenPipeError:
        return 0
    except Exception as e:  # internal error
        print(f"ws: internal error: {type(e).__name__}: {e}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
