DOC_FALLBACK_TEMPLATE = """# {title} — working doc

Living deep-dive for this stream: richer than the task list, fresher than
VISION. Keep it current at milestones — it is linked from the dashboard.

## Current shape

<!-- What exists right now and how it fits together. -->

## In flight

<!-- What is being built or changed at the moment, and by whom. -->

## Decisions

<!-- Dated, newest first: what was decided and why. -->

## Links

<!-- PRs, docs, dashboards, related streams. -->
"""


def _md_inline(s: str) -> str:
    """Inline markdown on an already-HTML-escaped string."""
    s = re.sub(r"`([^`]+)`", r"<code>\1</code>", s)
    s = re.sub(r"\*\*([^*]+)\*\*", r"<strong>\1</strong>", s)
    s = re.sub(r"(?<![\w*])\*([^*\s](?:[^*]*[^*\s])?)\*(?![\w*])", r"<em>\1</em>", s)
    s = re.sub(r"\[([^\]]+)\]\(([^)\s]+)\)",
               r'<a href="\2" target="_blank" rel="noopener">\1</a>', s)
    return s


def md_to_html_body(text: str) -> str:
    """Tiny stdlib markdown -> HTML: headings, paragraphs, bold/italic/code,
    fenced code blocks, flat ul/ol lists, links. Everything HTML-escaped."""
    e = html_mod.escape
    out: list[str] = []
    para: list[str] = []
    list_tag: str | None = None

    def flush_para():
        if para:
            out.append("<p>" + _md_inline(e(" ".join(para))) + "</p>")
            para.clear()

    def flush_list():
        nonlocal list_tag
        if list_tag:
            out.append(f"</{list_tag}>")
            list_tag = None

    lines = text.splitlines()
    i = 0
    while i < len(lines):
        line = lines[i]
        stripped = line.strip()
        if stripped.startswith("```"):
            flush_para(); flush_list()
            i += 1
            code: list[str] = []
            while i < len(lines) and not lines[i].strip().startswith("```"):
                code.append(lines[i])
                i += 1
            out.append("<pre><code>" + e("\n".join(code)) + "</code></pre>")
            i += 1
            continue
        m = re.match(r"^(#{1,6})\s+(.*)$", stripped)
        if m:
            flush_para(); flush_list()
            n = len(m.group(1))
            out.append(f"<h{n}>" + _md_inline(e(m.group(2))) + f"</h{n}>")
            i += 1
            continue
        m = re.match(r"^\s*[-*]\s+(.*)$", line)
        if m:
            flush_para()
            if list_tag != "ul":
                flush_list(); out.append("<ul>"); list_tag = "ul"
            out.append("<li>" + _md_inline(e(m.group(1))) + "</li>")
            i += 1
            continue
        m = re.match(r"^\s*\d+[.)]\s+(.*)$", line)
        if m:
            flush_para()
            if list_tag != "ol":
                flush_list(); out.append("<ol>"); list_tag = "ol"
            out.append("<li>" + _md_inline(e(m.group(1))) + "</li>")
            i += 1
            continue
        if not stripped or stripped.startswith("<!--"):
            flush_para(); flush_list()
            i += 1
            continue
        para.append(stripped)
        i += 1
    flush_para(); flush_list()
    return "\n".join(out)


DOC_PAGE_CSS = """
:root { color-scheme: light dark;
  --bg:#fafafa; --fg:#1a1a1a; --card:#ffffff; --muted:#666; --border:#e0e0e0; --accent:#1565c0; }
@media (prefers-color-scheme: dark) {
  :root { --bg:#141416; --fg:#e8e6e3; --card:#1e1e22; --muted:#9a9691; --border:#333; --accent:#64b5f6; } }
* { box-sizing:border-box; }
body { margin:0 auto; max-width:760px; padding:32px 20px 80px; font:16px/1.6 system-ui,sans-serif;
  background:var(--bg); color:var(--fg); }
h1,h2,h3 { line-height:1.25; } h1 { font-size:26px; }
h2 { font-size:20px; margin-top:32px; border-bottom:1px solid var(--border); padding-bottom:4px; }
code { font-family:ui-monospace,monospace; font-size:.9em; background:var(--card);
  border:1px solid var(--border); border-radius:4px; padding:0 4px; }
pre { background:var(--card); border:1px solid var(--border); border-radius:8px;
  padding:12px 14px; overflow-x:auto; }
pre code { border:none; background:none; padding:0; }
a { color:var(--accent); }
.docmeta { color:var(--muted); font-size:12px; margin-bottom:24px; }
"""


DOC_EXTRA_CSS = """
table { border-collapse:collapse; width:100%; margin:16px 0; font-size:14px; display:block; overflow-x:auto; }
th, td { border:1px solid var(--border); padding:7px 11px; text-align:left; vertical-align:top; }
th { background:var(--card); font-weight:600; }
hr { border:none; border-top:1px solid var(--border); margin:28px 0; }
