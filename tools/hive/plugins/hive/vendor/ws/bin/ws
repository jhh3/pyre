input[type=checkbox] { accent-color:#2e7d32; }
img { max-width:100%; }
"""


def render_md_page(md_path: Path, title: str) -> Path:
    """Render a markdown file to a sibling .html; returns the html path."""
    out_path = md_path.with_suffix(".html")
    body = md_to_html_body(md_path.read_text())
    page = (
        "<!DOCTYPE html>\n<html lang=\"en\"><head><meta charset=\"utf-8\">\n"
        "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n"
        f"<title>{html_mod.escape(title)}</title>\n<style>{DOC_PAGE_CSS}</style></head><body>\n"
        f"<div class='docmeta'>{html_mod.escape(md_path.name)} · rendered "
        f"{html_mod.escape(datetime.now().strftime('%Y-%m-%d %H:%M'))} · "
        "regenerated on every ws mutation</div>\n"
        f"{body}\n</body></html>\n"
    )
    atomic_write(out_path, page)
    return out_path


def resolve_doc_path(slug: str, docval: str) -> Path | None:
    if not docval:
        return None
    p = Path(docval).expanduser()
    if not p.is_absolute():
        p = stream_dir(slug) / p
    return p if p.is_file() else None


def href_from_root(target: Path) -> str:
    try:
        rel = os.path.relpath(target, WS_ROOT)
    except ValueError:
        return target.resolve().as_uri()
    return target.resolve().as_uri() if rel.startswith("..") else rel


def vision_nontrivial(slug: str, title: str) -> Path | None:
    vision = stream_dir(slug) / "VISION.md"
    if not vision.is_file():
        return None
    vt = re.sub(r"<!--.*?-->", "", vision.read_text(), flags=re.S).strip()
    lines = [l for l in vt.splitlines() if l.strip()]
    if len(lines) <= 1:  # just the scaffold heading
        return None
    return vision


def stream_doc_links(slug: str, docval: str, title: str) -> list[tuple[str, str]]:
    """(label, href-relative-to-vault) pairs; renders .md docs as a side effect."""
    links: list[tuple[str, str]] = []
    p = resolve_doc_path(slug, docval)
    if p:
        try:
            if p.suffix.lower() in (".html", ".htm"):
                links.append(("open doc ↗", href_from_root(p)))
            else:
                links.append(("open doc ↗", href_from_root(render_md_page(p, f"{title} — doc"))))
        except Exception:
            pass
    vision = vision_nontrivial(slug, title)
    if vision:
        try:
            links.append(("vision ↗", href_from_root(render_md_page(vision, f"{title} — vision"))))
        except Exception:
            pass
    return links


def cmd_doc(args) -> int:
    slug = infer_slug(args.slug)
    meta = load_meta(slug)
    d = stream_dir(slug)
    docval = meta.get("doc", "")
    if not docval:
        target = d / "DOC.md"
        if not target.exists():
            tpl = TEMPLATES / "DOC.md"
            text = tpl.read_text() if tpl.is_file() else DOC_FALLBACK_TEMPLATE
            atomic_write(target, text.replace("{title}", meta.get("title", slug)))
            print(f"Scaffolded {target}")
        update_meta(slug, {"doc": "DOC.md"})
        docval = "DOC.md"
        print(f"Stream doc set: {slug} -> DOC.md. Keep it current — it's the "
              "human-readable deep-dive linked from the dashboard.")
    path = resolve_doc_path(slug, docval)
    if not path:
        raise UserError(f"Doc `{docval}` for `{slug}` does not exist. "
                        f"Create it, or reset with `ws update {slug} --doc <path>`.")
    print(f"Doc for `{slug}`: {path}")
    render_html_safe()
    if args.open:
        target = path if path.suffix.lower() in (".html", ".htm") \
            else path.with_suffix(".html")
        if not target.is_file():
            target = render_md_page(path, f"{meta.get('title', slug)} — doc")
        launch_browser(target.resolve().as_uri())
    return 0


