STATUS_COLORS = {
    "active": "#2e7d32", "blocked": "#c62828", "review": "#6a1b9a",
    "parked": "#616161", "done": "#455a64",
}


# Streams whose `next` starts with a block-on-user signal join the header
# "needs you" callout alongside status=blocked.
NEEDS_YOU_RE = re.compile(
    r"(?i)^\s*(waiting|blocked|awaiting|needs?\b|ask\b|decide|decision|review needed)")

_DOT_CLASS = {"busy": "busy", "idle": "idle", "alive": "up", "dead": "dead"}

DASH_TMPL = """<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ws — work streams</title>
<style>
:root { color-scheme: light dark;
  --bg:#fafafa; --fg:#1a1a1a; --card:#ffffff; --muted:#666; --border:#e0e0e0;
  --accent:#1565c0; --amber:#b26a00; --green:#2e7d32; --orange:#ef6c00; }
@media (prefers-color-scheme: dark) {
  :root { --bg:#141416; --fg:#e8e6e3; --card:#1e1e22; --muted:#9a9691; --border:#333;
  --accent:#64b5f6; --amber:#e0a030; --green:#66bb6a; --orange:#ffa040; } }
* { box-sizing:border-box; }
body { margin:0 auto; max-width:860px; padding:20px 14px 60px;
  font:14px/1.45 system-ui,sans-serif; background:var(--bg); color:var(--fg); }
h1 { font-size:18px; margin:0; display:inline; }
.gen { color:var(--muted); font-size:11px; margin-left:10px; }
