<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Entitlements packaging/release.sh signs Pyre.app and pyre, pyred, pyre-hub
     with. Apple Events lets sessions script other apps (osascript) after the
     owner's one-time Automation consent; see docs/operations.md. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>
