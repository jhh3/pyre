# systemd user unit: the ngrok tunnel in front of pyre-site.service
# (Google sign-in, allowed email domains only), docs/site.md.
# Install:
#   install -d -m 0700 ~/.config/pyre/ngrok
#   install -m 0644 packaging/ngrok/pyre-site-policy.yml ~/.config/pyre/ngrok/
#   install -m 0644 packaging/systemd/pyre-site-tunnel.service ~/.config/systemd/user/
#   (edit the --url below to your reserved ngrok domain)
#   systemctl --user daemon-reload && systemctl --user enable --now pyre-site-tunnel
# ngrok reads its authtoken from its own config (~/.config/ngrok/ngrok.yml,
# `ngrok config add-authtoken`); it is never written here.

[Unit]
Description=ngrok tunnel for the Pyre review site
Documentation=https://github.com/jhh3/pyre/blob/main/docs/site.md
Wants=pyre-site.service
After=pyre-site.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
ExecStart=/usr/local/bin/ngrok http 127.0.0.1:7393 --url https://pyre-example-review.ngrok.app --traffic-policy-file %h/.config/pyre/ngrok/pyre-site-policy.yml --log stdout --log-format logfmt
WorkingDirectory=%h
Restart=on-failure
RestartSec=5s
TimeoutStopSec=10s
MemoryMax=256M
TasksMax=64
NoNewPrivileges=yes
SyslogIdentifier=pyre-site-tunnel

[Install]
WantedBy=default.target
